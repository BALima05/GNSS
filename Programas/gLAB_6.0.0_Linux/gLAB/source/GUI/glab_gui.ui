                              </font>
                             </property>
                             <property name="toolTip">
                              <string>&lt;b&gt;Dual-frequency&lt;/b&gt;&lt;br&gt;&lt;br&gt;Use this option to process with dual frequency measurements in the navigation filter (but single frequency measurements can be used for smoothing, as well as single frequency cycle-slip detectors).&lt;br&gt;</string>
                             </property>
                             <property name="styleSheet">
                              <string notr="true">color: rgb(0, 0, 0);</string>
                             </property>
                             <property name="text">
                              <string>Dual-frequency</string>
                             </property>
                            </widget>
                           </item>
                           <item row="0" column="0">
                            <widget class="QRadioButton" name="radioButtonSingleFreq">
                             <property name="font">
                              <font>
                               <weight>50</weight>
                               <bold>false</bold>
                              </font>
                             </property>
                             <property name="toolTip">
                              <string>&lt;b&gt;Single-frequency&lt;/b&gt;&lt;br&gt;&lt;br&gt;Use this option to configure the navigation filter to single-frequency measurements (but dual-frequency measurements can be used for smoothing or cycle-slip detection).&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTE:&lt;/b&gt; If this option is used to perform a single frequency PPP, then the user must also enable ionosphere and DCB correction in the &lt;/i&gt;MODELLING&lt;/i&gt; tab, as well as disable dual frequency cycle-slip detectors and enable single frequency cycle-slip detector.&lt;br&gt;</string>
                             </property>
