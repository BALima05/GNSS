                             <property name="toolTip">
                              <string>&lt;b&gt;Align columns:&lt;/b&gt;&lt;br&gt;&lt;br&gt;Make fields have always the same width, so the first character of each field is always in the same position in all the lines, instead of writing each field with the minium size possible. This enhances human readibility.&lt;br&gt;&lt;br&gt;&lt;font color='#C00000'&gt;WARNING:&lt;/font&gt; Pegasus software will not be able to read the output files if this option is enabled.&lt;br&gt;</string>
                             </property>
