                  <item row="0" column="0">
                   <widget class="QGroupBox" name="groupBox_6">
                    <property name="font">
                     <font>
                      <pointsize>9</pointsize>
                      <weight>75</weight>
                      <bold>true</bold>
                     </font>
                    </property>
                    <property name="title">
                     <string>Interpolation Option</string>
                    </property>
                    <layout class="QGridLayout" name="gridLayout_359">
                     <property name="leftMargin">
                      <number>6</number>
                     </property>
                     <property name="topMargin">
                      <number>9</number>
                     </property>
                     <property name="rightMargin">
                      <number>6</number>
                     </property>
                     <property name="bottomMargin">
                      <number>6</number>
                     </property>
                     <item row="2" column="0">
                      <widget class="QLabel" name="label_259">
                       <property name="toolTip">
                        <string>&lt;b&gt;Total Gaps Allowed&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;This value is only valid for orbits or clocks obtained from &lt;b&gt;SP3&lt;/b&gt; files (for clocks also from &lt;b&gt;CLK&lt;/b&gt; files), as they require an interpolation.&lt;br&gt;For both orbits and clocks, when selecting the samples for interpolation, there may occur that there are data gaps in the file, which may produce that samples used for interpolation are very far in time from each other, thus reducing the accuracy of the interpolated value.&lt;br&gt;With this option, a maximum number of data gaps between the first and last sample used is set (therefore protecting against large data gaps equally distributed in all samples used), and for any case that this threshold is surpassed, no interpolation is done for this epoch and satellites.&lt;br&gt;gLAB can detect data gaps in &lt;b&gt;SP3&lt;/b&gt; and &lt;b&gt;CLK&lt;/b&gt; files by calculating the sampling rate of the data files.&lt;br&gt;</string>
                       </property>
                       <property name="styleSheet">
                        <string notr="true">color: rgb(0, 0, 0);</string>
                       </property>
                       <property name="text">
                        <string>Total Gaps Allowed:</string>
                       </property>
                       <property name="alignment">
                        <set>Qt::AlignLeading|Qt::AlignLeft|Qt::AlignVCenter</set>
                       </property>
                      </widget>
                     </item>
                     <item row="0" column="0">
                      <widget class="QLabel" name="label_65">
                       <property name="sizePolicy">
                        <sizepolicy hsizetype="Minimum" vsizetype="Preferred">
                         <horstretch>0</horstretch>
                         <verstretch>0</verstretch>
                        </sizepolicy>
                       </property>
                       <property name="minimumSize">
                        <size>
                         <width>0</width>
                         <height>23</height>
                        </size>
                       </property>
                       <property name="toolTip">
                        <string>&lt;b&gt;Interpolation Degree&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;This value is only valid for orbits or clocks obtained from &lt;b&gt;SP3&lt;/b&gt; files (for clocks also from &lt;b&gt;CLK&lt;/b&gt; files), as they require an interpolation.&lt;ul&gt;&lt;li&gt;&lt;b&gt;Orbits:&lt;/b&gt; By default, the orbit interpolation is done with a polynomial of degree 9, but this value can be adjusted with this parameter. Excessively low values would hardly impact the precision of the position obtained.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Clocks:&lt;/b&gt; By default, no orbit interpolation is done (therefore only clock correction is available in the epochs provided in the file). To get clock correction at any epoch, or either a &lt;b&gt;CLK&lt;/b&gt; with higher data rate is provided, or an interpolation is done. Interpolation degree should be low (degree 1), due to clocks behave randomly.&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;</string>
                       </property>
                       <property name="styleSheet">
                        <string notr="true">color: rgb(0, 0, 0);</string>
                       </property>
                       <property name="text">
                        <string>Interpolation Degree:</string>
                       </property>
                       <property name="alignment">
                        <set>Qt::AlignLeading|Qt::AlignLeft|Qt::AlignVCenter</set>
                       </property>
                      </widget>
                     </item>
                     <item row="1" column="0">
                      <widget class="QLabel" name="label_260">
                       <property name="toolTip">
                        <string>&lt;b&gt;Max Consecutive Gaps Between Sample:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;This value is only valid for orbits or clocks obtained from &lt;b&gt;SP3&lt;/b&gt; files (for clocks also from &lt;b&gt;CLK&lt;/b&gt; files), as they require an interpolation.&lt;br&gt;For both orbits and clocks, when selecting the samples for interpolation, there may occur that there are data gaps in the file, which may produce that samples used for interpolation are very far in time from each other, thus reducing the accuracy of the interpolated value.&lt;br&gt;With this option, a maximum number of consecutive data gaps between samples is set (therefore protecting against large data gaps concentrated between few samples), and for any case that this threshold is surpassed, no interpolation is done for this epoch and satellites.&lt;br&gt;gLAB can detect data gaps in &lt;b&gt;SP3&lt;/b&gt; and &lt;b&gt;CLK&lt;/b&gt; files by calculating the sampling rate of the data files.&lt;br&gt;</string>
                       </property>
                       <property name="styleSheet">
                        <string notr="true">color: rgb(0, 0, 0);</string>
                       </property>
                       <property name="text">
                        <string>Max Consecutive Gaps
Between Samples:</string>
                       </property>
                       <property name="alignment">
                        <set>Qt::AlignLeading|Qt::AlignLeft|Qt::AlignVCenter</set>
                       </property>
                      </widget>
                     </item>
                    </layout>
                   </widget>
                  </item>
                 </layout>
                </widget>
               </item>
              </layout>
             </widget>
            </item>
