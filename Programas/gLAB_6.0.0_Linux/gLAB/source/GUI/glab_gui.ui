                             <item row="0" column="0" colspan="4">
                              <widget class="QGroupBox" name="groupBoxSbasAlarmLimits">
                               <property name="font">
                                <font>
                                 <weight>75</weight>
                                 <bold>true</bold>
                                </font>
                               </property>
                               <property name="title">
                                <string>Alarm Limits</string>
                               </property>
                               <layout class="QGridLayout" name="gridLayout_328">
                                <property name="topMargin">
                                 <number>9</number>
                                </property>
                                <property name="bottomMargin">
                                 <number>6</number>
                                </property>
                                <property name="verticalSpacing">
                                 <number>3</number>
                                </property>
                                <item row="1" column="1">
                                 <widget class="QLineEdit" name="lineEditVerticalAlarmLimitSBAS">
                                  <property name="sizePolicy">
                                   <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
                                    <horstretch>0</horstretch>
                                    <verstretch>0</verstretch>
                                   </sizepolicy>
                                  </property>
                                  <property name="minimumSize">
                                   <size>
                                    <width>60</width>
                                    <height>0</height>
                                   </size>
                                  </property>
                                  <property name="maximumSize">
                                   <size>
                                    <width>80</width>
                                    <height>16777215</height>
                                   </size>
                                  </property>
                                  <property name="clearButtonEnabled">
                                   <bool>true</bool>
                                  </property>
                                 </widget>
                                </item>
                                <item row="0" column="0">
                                 <widget class="QLabel" name="label_253">
                                  <property name="toolTip">
                                   <string>&lt;b&gt;Horizontal Alarm Limit&lt;/b&gt;&lt;br&gt;&lt;br&gt;The alarm limits are the maximum value of the protection levels (which are the estimation of the user error using the sigma provided by the SBAS system) computed in the navigation solution to consider that the system is available. That is, if the any of the horizontal or vertical protection levels are equal or greater to their respective horizontal or vertical alarm limits, it is considered that the SBAS system is not providing a solution good enough to meet the navigation precision or integrity requirements.&lt;br&gt;Alarm limits are set by the navigation modes (APV-I, CAT-I, ...) defined by ICAO&lt;sup&gt;1&lt;/sup&gt;, and they &lt;b&gt;do not affect in any way in the computation of the navigation solution or protection levels&lt;/b&gt;. Alarm limits only affect the computation of the post-process statistics, in concrete:&lt;ul&gt;&lt;li&gt;&lt;b&gt;Availability:&lt;/b&gt; The percentage of epochs where there was a solution in PA navigation mode with protection levels under both horizontal and vertical limits,&lt;/li&gt;&lt;li&gt;&lt;b&gt;Continuity Risk:&lt;/b&gt; Is the probability to have a discontinuity (no solution in PA mode under alarm limits) during a time window. Typically the sliding window is set to 15 epochs.&lt;/li&gt;&lt;/ul&gt;&lt;b&gt;NOTE:&lt;/b&gt; APV-1 navigation mode sets the horizontal alarm limit to 40 metres.&lt;br&gt;&lt;br&gt;&lt;sup&gt;1&lt;/sup&gt;ICAO (2006) Aeronautical Telecommunications, Annex 10 to the Convention on International Civil Aviation,  Volume I, Radio Navigation Aids&lt;br&gt;</string>
                                  </property>
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>Horizontal</string>
                                  </property>
                                 </widget>
                                </item>
                                <item row="0" column="3">
                                 <spacer name="horizontalSpacer_42">
                                  <property name="orientation">
                                   <enum>Qt::Horizontal</enum>
                                  </property>
                                  <property name="sizeHint" stdset="0">
                                   <size>
                                    <width>0</width>
                                    <height>20</height>
                                   </size>
                                  </property>
                                 </spacer>
                                </item>
                                <item row="1" column="2">
                                 <widget class="QLabel" name="label_256">
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>(m)</string>
                                  </property>
                                 </widget>
                                </item>
                                <item row="0" column="1">
                                 <widget class="QLineEdit" name="lineEditHorizontalAlarmLimitSBAS">
                                  <property name="sizePolicy">
                                   <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
                                    <horstretch>0</horstretch>
                                    <verstretch>0</verstretch>
                                   </sizepolicy>
                                  </property>
                                  <property name="minimumSize">
                                   <size>
                                    <width>60</width>
                                    <height>25</height>
                                   </size>
                                  </property>
                                  <property name="maximumSize">
                                   <size>
                                    <width>80</width>
                                    <height>16777215</height>
                                   </size>
                                  </property>
                                  <property name="clearButtonEnabled">
                                   <bool>true</bool>
                                  </property>
                                 </widget>
                                </item>
                                <item row="0" column="2">
                                 <widget class="QLabel" name="label_254">
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>(m)</string>
                                  </property>
                                 </widget>
                                </item>
                                <item row="1" column="0">
                                 <widget class="QLabel" name="label_255">
                                  <property name="toolTip">
                                   <string>&lt;b&gt;Vertical Alarm Limit&lt;/b&gt;&lt;br&gt;&lt;br&gt;The alarm limits are the maximum value of the protection levels (which are the estimation of the user error using the sigma provided by the SBAS system) computed in the navigation solution to consider that the system is available. That is, if the any of the horizontal or vertical protection levels are equal or greater to their respective horizontal or vertical alarm limits, it is considered that the SBAS system is not providing a solution good enough to meet the navigation precision or integrity requirements.&lt;br&gt;Alarm limits are set by the navigation modes (APV-I, CAT-I, ...) defined by ICAO&lt;sup&gt;1&lt;/sup&gt;, and they &lt;b&gt;do not affect in any way in the computation of the navigation solution or protection levels&lt;/b&gt;. Alarm limits only affect the computation of the post-process statistics, in concrete:&lt;ul&gt;&lt;li&gt;&lt;b&gt;Availability:&lt;/b&gt; The percentage of epochs where there was a solution in PA navigation mode with protection levels under both horizontal and vertical limits,&lt;/li&gt;&lt;li&gt;&lt;b&gt;Continuity Risk:&lt;/b&gt; It is the probability to have a discontinuity (no solution in PA mode under alarm limits) during a time window. Typically the sliding window is set to 15 epochs.&lt;/li&gt;&lt;/ul&gt;&lt;b&gt;NOTE:&lt;/b&gt; APV-1 navigation mode sets the vertical alarm limit to 50 metres.&lt;br&gt;&lt;br&gt;&lt;sup&gt;1&lt;/sup&gt;ICAO (2006) Aeronautical Telecommunications, Annex 10 to the Convention on International Civil Aviation,  Volume I, Radio Navigation Aids&lt;br&gt;</string>
                                  </property>
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>Vertical</string>
                                  </property>
                                 </widget>
                                </item>
                               </layout>
                              </widget>
                             </item>
                            </layout>
                           </widget>
                          </item>
                          <item row="0" column="0">
                           <widget class="QCheckBox" name="checkBoxPrintSummary">
                            <property name="minimumSize">
                             <size>
                              <width>0</width>
                              <height>0</height>
                             </size>
                            </property>
                            <property name="toolTip">
                             <string>&lt;b&gt;Print Summary&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;The processing summary is printed at the end of the output file if the summary option is enabled (with all time tags in GPS time). The contents of the summary are:&lt;br/&gt;&lt;table&gt;&lt;tr&gt;&lt;td&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;Number of epochs processed&lt;/b&gt;, along with the number epochs that had a solution.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Number of epochs skipped&lt;/b&gt; (epochs without solution) in total and per each possible reason for skipping the epoch.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Number of epochs missing&lt;/b&gt; during the summary period (if decimation is enabled, the epochs missing will be separated into the epochs which would have been decimated or not decimated.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Number of epochs missing&lt;/b&gt; in the whole file.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Number of data gaps&lt;/b&gt; during the summary period.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Number of data gaps&lt;/b&gt; in the whole file.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Maximum data gap size&lt;/b&gt; during the summary period and the epoch where it occurred.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Maximum data gap size&lt;/b&gt; in the whole file and the epoch where it occurred.&lt;/li&gt;&lt;li&gt;&lt;b&gt;The number of used constellation&lt;/b&gt; mean value, 50 and 95 percentile (or user defined percentile).&lt;/li&gt;&lt;li&gt;&lt;b&gt;The number of not used constellation&lt;/b&gt; mean value, 50 and 95 percentile (or user defined percentile). User unselected constellations will not count as not used.&lt;/li&gt;&lt;li&gt;&lt;b&gt;The number of epochs and the percentage&lt;/b&gt; in respect of total epochs with solution of each set of constellations used.&lt;/li&gt;&lt;li&gt;&lt;b&gt;The number of epochs and the percentage&lt;/b&gt; in respect of total epochs with solution of each set of constellations not used. User unselected constellations will not count as not used.&lt;/li&gt;&lt;li&gt;&lt;b&gt;The number of used satellites&lt;/b&gt; (in total and per constellation) mean value, 50 and 95 percentile (or user defined percentile).&lt;/li&gt;&lt;li&gt;&lt;b&gt;The number of not used satellites&lt;/b&gt; (in total and per constellation) mean value, 50 and 95 percentile (or user defined percentile). User unselected satellites will not count as not used.&lt;/li&gt;&lt;/ul&gt;&lt;/td&gt;&lt;td&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;The maximum and minimum number of satellites used&lt;/b&gt; (in total and per constellation) and the epochs where it occurred.&lt;/li&gt;&lt;li&gt;&lt;b&gt;The maximum and minimum number of satellites not used&lt;/b&gt; (in total and per constellation) and the epochs where it occurred. User unselected satellites will not count as not used.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Time&lt;/b&gt; to first fix (first epoch with solution).&lt;/li&gt;&lt;li&gt;&lt;b&gt;The 95 Percentile&lt;/b&gt; (or user defined percentile) of the PDOP, GDOP, TDOP, HDOP and VDOP.&lt;/li&gt;&lt;li&gt;&lt;b&gt;The minimum and maximum value&lt;/b&gt; of PDOP, GDOP, TDOP, HDOP and VDOP and the epochs where it occurred.&lt;/li&gt;&lt;li&gt;&lt;b&gt;The 95 Percentile&lt;/b&gt; (or user defined percentile) of the horizontal, vertical, east, north and 3D errors.&lt;/li&gt;&lt;li&gt;&lt;b&gt;The maximum highest&lt;/b&gt; horizontal, vertical, east, north and 3D errors and the epochs where it ocurred.&lt;/li&gt;&lt;li&gt;&lt;b&gt;The total processing time&lt;/b&gt;, providing also the percentages of processing time in user mode and in kernel mode.&lt;/li&gt;&lt;table&gt;&lt;tr&gt;&lt;td&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;In the non-mutithread version of gLAB&lt;/b&gt;, the processing times are provided by the system function that provided thread CPU time.&lt;/li&gt;&lt;li&gt;&lt;b&gt;In multi-thread version of gLAB&lt;/b&gt;, the CPU time provided by the system function is the sum of all CPU time of all threads, which can yield a total time greater than the real time (user perceived time) passed. In this case, gLAB will show the real time passed (but using the user and Kernel time percentages from the system functions).&lt;/li&gt;&lt;/ul&gt;&lt;/td&gt;&lt;td&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;The processing time&lt;/b&gt; is computed just at the end of the summary, where still the print with the processing time and the last line of the summary are to be done, and also the last lines of gLAB code which are for freeing memory. These last instructions add less than 1ms of processing time for user time and less than to 0.2 seconds of Kernel time.&lt;/li&gt;&lt;/ul&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;li&gt;&lt;b&gt;A single line&lt;/b&gt; at the end with the previous info in columnar format (with the column number). This line is useful for plotting results from multiple runs (after joining in one file the last line of the summary from multiple runs).&lt;/li&gt;&lt;/ul&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br/&gt;&lt;br/&gt;Additionally, in PPP mode, the following information is provided:&lt;br/&gt;&lt;table&gt;&lt;tr&gt;&lt;td&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;Convergence time&lt;/b&gt; (counting from the first epoch with solution) using the horizontal, vertical and 3D formal error.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Convergence time&lt;/b&gt; (counting from the first epoch with solution) using the horizontal, vertical and 3D formal error and maintained during a given period.&lt;/li&gt;&lt;/ul&gt;&lt;/td&gt;&lt;td&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;Convergence time&lt;/b&gt; (counting from the first epoch with solution) using the horizontal, vertical and 3D positioning error.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Convergence time&lt;/b&gt; (counting from the first epoch with solution) using the horizontal, vertical and 3D positioning error and maintained during a given period.&lt;/li&gt;&lt;/ul&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br/&gt;&lt;br/&gt;Additionally, in SBAS mode, the following information is provided:&lt;br/&gt;&lt;table&gt;&lt;tr&gt;&lt;td&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;Number of epochs&lt;/b&gt; with solution under alarm limits.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Number of epochs&lt;/b&gt; with MIs.&lt;/li&gt;&lt;li&gt;&lt;b&gt;The 95 Percentile&lt;/b&gt; (or user defined percentile) of the integrity ratio.&lt;/li&gt;&lt;li&gt;&lt;b&gt;The Best Integrity Ratio (BIR) and Worst Integrity Ratio (WIR) and the epochs&lt;/b&gt; where it occurred.&lt;/li&gt;&lt;/ul&gt;&lt;/td&gt;&lt;td&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;The epoch&lt;/b&gt; with minimum and maximum protection levels and the epochs where it occurred.&lt;/li&gt;&lt;li&gt;&lt;b&gt;The 95 Percentile&lt;/b&gt; (or user defined percentile) of the protection levels.&lt;/li&gt;&lt;/ul&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br/&gt;&lt;br/&gt;Additionally, for DGNSS processing, the following information is provided:&lt;br/&gt;&lt;table&gt;&lt;tr&gt;&lt;td&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;Number of epochs missing&lt;/b&gt; during the summary period in the reference station file (RINEX only).&lt;/li&gt;&lt;li&gt;&lt;b&gt;Number of epochs missing&lt;/b&gt; in the whole file in the reference station file (RINEX only).&lt;/li&gt;&lt;li&gt;&lt;b&gt;Number of data gaps &lt;/b&gt;during the summary period in the reference station file (RINEX only).&lt;/li&gt;&lt;/ul&gt;&lt;/td&gt;&lt;td&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;Number of data gaps&lt;/b&gt; in the whole file in the reference station file (RINEX only).&lt;/li&gt;&lt;li&gt;&lt;b&gt;Maximum data gap size&lt;/b&gt; during the summary period and the epoch where it occurred in the reference station file (RINEX only).&lt;/li&gt;&lt;li&gt;&lt;b&gt;Maximum data gap size&lt;/b&gt; in the whole file and the epoch where it occurred in the reference station file (RINEX only).&lt;/li&gt;&lt;/ul&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;NOTE:&lt;/b&gt; If Stanford-ESA is enabled, the number of geometries computed will be printed. In SBAS mode, also the number of geometries with MIs and the WIR for the Stanford-ESA will be printed.&lt;br/&gt;&lt;br/&gt;&lt;font color='#C00000'&gt;&lt;b&gt;IMPORTANT:&lt;/b&gt;&lt;/font&gt; If receiver position is not fixed or provided with a reference file, the epoch with highest error, the error percentiles and the MIs will not be computed.</string>
                            </property>
                            <property name="styleSheet">
                             <string notr="true">color: rgb(0, 0, 0);</string>
                            </property>
                            <property name="text">
                             <string>Print Summary</string>
                            </property>
                           </widget>
                          </item>
                          <item row="3" column="0">
                           <widget class="QGroupBox" name="groupBoxSummaryConvergence">
                            <property name="sizePolicy">
                             <sizepolicy hsizetype="Minimum" vsizetype="Preferred">
                              <horstretch>0</horstretch>
                              <verstretch>0</verstretch>
                             </sizepolicy>
                            </property>
                            <property name="minimumSize">
                             <size>
                              <width>0</width>
                              <height>0</height>
                             </size>
                            </property>
                            <property name="font">
                             <font>
                              <weight>75</weight>
                              <bold>true</bold>
                             </font>
                            </property>
                            <property name="title">
                             <string>Convergence time computation</string>
                            </property>
                            <layout class="QGridLayout" name="gridLayout_496">
                             <property name="leftMargin">
                              <number>6</number>
                             </property>
                             <property name="topMargin">
                              <number>9</number>
                             </property>
                             <property name="rightMargin">
                              <number>6</number>
