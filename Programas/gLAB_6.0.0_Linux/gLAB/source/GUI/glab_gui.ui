                                    </item>
                                    <item row="1" column="0">
                                     <widget class="QRadioButton" name="radioButtonRtcmRinexRover">
                                      <property name="toolTip">
                                       <string>&lt;b&gt;DGNSS: RINEX Rover&lt;/b&gt;&lt;br&gt;&lt;br&gt;If reference station data is from a RINEX observation file, coordinates will be read from the header record &lt;b&gt;&lt;i&gt;APPROX POSITION XYZ&lt;/i&gt;&lt;/b&gt;, otherwise they will be read from the RTCM file. &lt;br&gt;The rover coordinates will be computed (using the rover RINEX observation header record &lt;b&gt;&lt;i&gt;APPROX POSITION XYZ&lt;/i&gt;&lt;/b&gt; as initial position), and the differential fields of the &lt;b&gt;OUTPUT&lt;/b&gt; message will be compared with the rover RINEX observation coordinates.&lt;br&gt;</string>
                                      </property>
                                      <property name="styleSheet">
                                       <string notr="true">color: rgb(0, 0, 0);</string>
                                      </property>
                                      <property name="text">
                                       <string>RINEX Rover</string>
                                      </property>
                                      <property name="checked">
                                       <bool>true</bool>
                                      </property>
                                     </widget>
                                    </item>
                                    <item row="1" column="1">
                                     <widget class="QRadioButton" name="radioButtonRtcmUserRinexRover">
                                      <property name="toolTip">
                                       <string>&lt;b&gt;DGNSS: User RINEX Rover&lt;/b&gt;&lt;br&gt;&lt;br&gt;Reference station coordinates are provided by the user.&lt;br&gt; The rover coordinates will be computed (using the rover RINEX observation header record &lt;b&gt;&lt;i&gt;APPROX POSITION XYZ&lt;/i&gt;&lt;/b&gt; as initial position), and the differential fields of the &lt;b&gt;OUTPUT&lt;/b&gt; message will be compared with the rover RINEX observation coordinates.&lt;br&gt;</string>
                                      </property>
                                      <property name="styleSheet">
                                       <string notr="true">color: rgb(0, 0, 0);</string>
                                      </property>
                                      <property name="text">
                                       <string>User RINEX Rover</string>
                                      </property>
                                     </widget>
                                    </item>
                                    <item row="2" column="0">
                                     <widget class="QRadioButton" name="radioButtonRtcmSpecify">
                                      <property name="toolTip">
                                       <string>&lt;b&gt;DGNSS: Specify Rover&lt;/b&gt;&lt;br&gt;&lt;br&gt;If reference station data is from a RINEX observation file, coordinates will be read from the header record &lt;b&gt;&lt;i&gt;APPROX POSITION XYZ&lt;/i&gt;&lt;/b&gt;, otherwise they will be read from the DGNSS file. &lt;br&gt;The rover coordinates will be computed (using the user provided coordinates as initial position), and the differential fields of the &lt;b&gt;OUTPUT&lt;/b&gt; message will be compared with the user provided coordinates.&lt;br&gt;</string>
                                      </property>
                                      <property name="styleSheet">
                                       <string notr="true">color: rgb(0, 0, 0);</string>
                                      </property>
                                      <property name="text">
                                       <string>Specify Rover</string>
                                      </property>
                                     </widget>
                                    </item>
                                    <item row="2" column="1">
                                     <widget class="QRadioButton" name="radioButtonRtcmUserSpecify">
                                      <property name="toolTip">
                                       <string>&lt;b&gt;DGNSS: User Reference &amp;amp; Rover&lt;/b&gt;&lt;br&gt;&lt;br&gt;Reference station and rover coordinates are provided by the user. &lt;br&gt;The rover coordinates will be computed (using the user rover coordinates as initial position), and the differential fields of the &lt;b&gt;OUTPUT&lt;/b&gt; message will be compared with the user rover coordinates.&lt;br&gt;</string>
                                      </property>
                                      <property name="styleSheet">
                                       <string notr="true">color: rgb(0, 0, 0);</string>
                                      </property>
                                      <property name="text">
                                       <string>User Ref. &amp;&amp; Rover</string>
                                      </property>
                                     </widget>
