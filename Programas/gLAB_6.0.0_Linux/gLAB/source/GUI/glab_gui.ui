                      <item row="1" column="0">
                       <widget class="QCheckBox" name="checkBoxSNRThresholdMax">
                        <property name="sizePolicy">
                         <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
                          <horstretch>0</horstretch>
                          <verstretch>0</verstretch>
                         </sizepolicy>
                        </property>
                        <property name="minimumSize">
                         <size>
                          <width>98</width>
                          <height>22</height>
                         </size>
                        </property>
                        <property name="maximumSize">
                         <size>
                          <width>16777215</width>
                          <height>22</height>
                         </size>
                        </property>
                        <property name="toolTip">
                         <string>&lt;b&gt;SNR Mask&lt;/b&gt;&lt;br&gt;&lt;br&gt;This parameter allows to discard satellites over a SNR (Signal to Noise Ratio) threshold, which is included in the RINEX observation file. The SNR can be read from from RINEX observation file in two ways, as a measurement (with names S1, S2, etc. in RINEX v2 and S1X, S2X, etc. in RINEX v3) or as a discrete value with the measurement (in the last character of the measurement).&lt;br&gt;&lt;br&gt;See description of RINEX observation files in:&lt;br&gt;&lt;font color=&quot;#0000FF&quot;&gt;Help-&gt;File formats description&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTES:&lt;/b&gt;&lt;ul&gt;&lt;li&gt;Filtering SNR samples with high SNR can be useful for removing potential spoofing samples.&lt;/li&gt;&lt;li&gt;Use the &quot;Advanced mode&quot; to select the SNR by constellation, frequency and measurement.&lt;/li&gt;&lt;li&gt;In command line, the user can set  a different maximum SNR threshold to each satellite, frequency and measurement by providing the parameter '-pre:maxsnrsel' as many times as necessary.&lt;/li&gt;&lt;li&gt;If SNR is available in both ways (as a measurement and as a discrete value). gLAB will prefer the SNR as a measurement, as it is more precise.&lt;/li&gt;&lt;li&gt;When a measurement is under the SNR threshold, the sample will be omitted (as if no measurement had been read in the RINEX observation file). Therefore, any measurement discarded due to low SNR will not enter into the smoother and will count as a data gap.&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;</string>
                        </property>
                        <property name="styleSheet">
                         <string notr="true">color: rgb(0, 0, 0);</string>
                        </property>
                        <property name="text">
                         <string>Max SNR Mask</string>
                        </property>
                       </widget>
                      </item>
                      <item row="0" column="0">
                       <widget class="QCheckBox" name="checkBoxSNRThresholdMin">
                        <property name="sizePolicy">
                         <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
                          <horstretch>0</horstretch>
                          <verstretch>0</verstretch>
                         </sizepolicy>
                        </property>
                        <property name="minimumSize">
                         <size>
                          <width>98</width>
                          <height>22</height>
                         </size>
                        </property>
                        <property name="maximumSize">
                         <size>
                          <width>16777215</width>
                          <height>22</height>
                         </size>
                        </property>
                        <property name="toolTip">
                         <string>&lt;b&gt;SNR Mask&lt;/b&gt;&lt;br&gt;&lt;br&gt;This parameter allows to discard satellites below a SNR (Signal to Noise Ratio) threshold, which is included in the RINEX observation file. The SNR can be read from from RINEX observation file in two ways, as a measurement (with names S1, S2, etc. in RINEX v2 and S1X, S2X, etc. in RINEX v3) or as a discrete value with the measurement (in the last character of the measurement).&lt;br&gt;&lt;br&gt;See description of RINEX observation files in:&lt;br&gt;&lt;font color=&quot;#0000FF&quot;&gt;Help-&gt;File formats description&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTES:&lt;/b&gt;&lt;ul&gt;&lt;li&gt;Use the &quot;Advanced mode&quot; to select the SNR by constellation, frequency and measurement.&lt;/li&gt;&lt;li&gt;In command line, the user can set  a different minimum SNR threshold to each satellite, frequency and measurement by providing the parameter '-pre:minsnrsel' as many times as necessary.&lt;/li&gt;&lt;li&gt;If SNR is available in both ways (as a measurement and as a discrete value). gLAB will prefer the SNR as a measurement, as it is more precise.&lt;/li&gt;&lt;li&gt;When a measurement is under the SNR threshold, the sample will be omitted (as if no measurement had been read in the RINEX observation file). Therefore, any measurement discarded due to low SNR will not enter into the smoother and will count as a data gap.&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;</string>
                        </property>
                        <property name="styleSheet">
                         <string notr="true">color: rgb(0, 0, 0);</string>
                        </property>
                        <property name="text">
                         <string>Min SNR Mask</string>
                        </property>
                        <property name="tristate">
                         <bool>false</bool>
                        </property>
                       </widget>
                      </item>
                     </layout>
                    </widget>
                   </item>
                   <item row="3" column="0">
                    <widget class="QCheckBox" name="checkBoxPrealignPhase">
                     <property name="toolTip">
                      <string>&lt;b&gt;Align carrier phase measurement with code&lt;/b&gt;&lt;br&gt;&lt;br&gt;In the first sample of each arc, for each couple of code and carrier phase measurements, compute the difference (in integer number of cycles) between them. During the same arc, add this constant difference to the carrier phase measurement. Therefore, the carrier phase measurement is at the same scale (aligned), and the scale of the ambiguities are reduced.&lt;br&gt;</string>
                     </property>
                     <property name="styleSheet">
                      <string notr="true">color: rgb(0, 0, 0);</string>
                     </property>
                     <property name="text">
                      <string>Align carrier phase measurement with code</string>
                     </property>
                    </widget>
                   </item>
                   <item row="7" column="0">
                    <widget class="QFrame" name="frameDiscardMarginalSatellites">
                     <property name="frameShape">
                      <enum>QFrame::NoFrame</enum>
                     </property>
                     <property name="frameShadow">
                      <enum>QFrame::Raised</enum>
                     </property>
                     <layout class="QGridLayout" name="gridLayout_207">
                      <property name="topMargin">
                       <number>0</number>
                      </property>
                      <property name="rightMargin">
                       <number>0</number>
                      </property>
                      <property name="bottomMargin">
                       <number>0</number>
                      </property>
                      <item row="0" column="0">
                       <widget class="QCheckBox" name="checkBoxDiscardMarginal">
                        <property name="toolTip">
                         <string>&lt;b&gt;Discard Marginal Satellites &lt;/b&gt;&lt;br&gt;&lt;br&gt;This parameter allows to discard satellites if the health flag of the broadcast navigation message is set to &lt;b&gt;marginal&lt;/b&gt; (this state only applies to Galileo satellites).&lt;br&gt;&lt;br&gt;See description of RINEX navigation files in:&lt;br&gt;&lt;font color=&quot;#0000FF&quot;&gt;Help-&gt;File formats description&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTE:&lt;/b&gt; If option &lt;i&gt;Discard Unhealthy Satellites&lt;/i&gt; is set, then this option is hidden (cannot be set) due to gLAB cannot discard satellites in marginal status and use satellites in unhealhy status.&lt;br&gt;</string>
                        </property>
                        <property name="styleSheet">
                         <string notr="true">color: rgb(0, 0, 0);</string>
                        </property>
                        <property name="text">
                         <string>Discard Marginal Satellites</string>
                        </property>
                       </widget>
                      </item>
                     </layout>
                    </widget>
                   </item>
                   <item row="1" column="0">
                    <widget class="QFrame" name="frame_3">
