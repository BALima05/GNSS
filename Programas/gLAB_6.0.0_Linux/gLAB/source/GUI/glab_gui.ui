                     <item row="2" column="0" colspan="2">
                      <widget class="QCheckBox" name="checkBoxCheckBroadcastTransmissionTimeShowOrbit">
                       <property name="toolTip">
                        <string>&lt;b&gt;Check Broadcast Transmission Time&lt;/b&gt;&lt;br&gt;&lt;br&gt;Each RINEX navigation message has a transmission time field in it, which refers to the first time that the satellites sends the current navigation message, but receivers set it to the first time they receive the message. Therefore, receivers on different locations will set different transmission times in their RINEX navigation files, as satellite visibility will be different.&lt;br&gt;gLAB uses this time to check wheter it can use or not use a navigation message, as if current epoch is previous to the transmission time, this means that the package was not available yet.&lt;br&gt;In SBAS and DGNSS this check is disabled, as in these modes corrections sent to the user are referred to a navigation message (with the IOD (Issue of Data)), therefore these navigation message had to be already sent by the satellite in order to compute the corrections.&lt;br&gt;See description of RINEX navigation files in:&lt;br&gt;&lt;font color=&quot;#0000FF&quot;&gt;Help-&gt;File formats description&lt;/font&gt;&lt;br&gt;</string>
                       </property>
                       <property name="styleSheet">
                        <string notr="true">color: rgb(0, 0, 0);</string>
                       </property>
                       <property name="text">
                        <string>Check Broadcast Transmission Time</string>
                       </property>
                      </widget>
                     </item>
                     <item row="0" column="0">
                      <widget class="QLabel" name="label_292">
                       <property name="sizePolicy">
                        <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
                         <horstretch>0</horstretch>
                         <verstretch>0</verstretch>
                        </sizepolicy>
                       </property>
                       <property name="toolTip">
                        <string>&lt;b&gt;Orbit Computation Rate&lt;/b&gt;&lt;br&gt;&lt;br&gt;Set the orbit computation time rate (in seconds). It can be decimal (up to 0.0001 seconds resolution) and it must greater than 0.&lt;br&gt;</string>
                       </property>
                       <property name="styleSheet">
                        <string notr="true">color: rgb(0, 0, 0);</string>
                       </property>
                       <property name="text">
                        <string>Orbit Computation Rate: </string>
                       </property>
                      </widget>
                     </item>
