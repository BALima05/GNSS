                                   <cursorShape>ArrowCursor</cursorShape>
                                  </property>
                                  <property name="mouseTracking">
                                   <bool>true</bool>
                                  </property>
                                  <property name="focusPolicy">
                                   <enum>Qt::StrongFocus</enum>
                                  </property>
                                  <property name="toolTip">
                                   <string>&lt;b&gt;Calculate a priori receiver position&lt;/b&gt;&lt;br&gt;&lt;br&gt;With this option, no a priori receiver position is required to be given, as the program will automatically calculate it. This is especially useful in moving receivers (trajectories) or when the approximate receiver position is not known.&lt;br&gt;If a reference position file is given, the differential fields of the &lt;b&gt;OUTPUT&lt;/b&gt; message will be the difference between the gLAB solution and the position given in the reference file. If no reference file is given or there is no value in the reference file (for a given epoch), the differentials fields will be zero.&lt;br&gt;</string>
                                  </property>
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>Calculate</string>
                                  </property>
                                 </widget>
                                </item>
                                <item row="1" column="3">
                                 <widget class="QRadioButton" name="radioButtonSinex">
                                  <property name="toolTip">
                                   <string>&lt;b&gt;Use SINEX position as a priori receiver position&lt;/b&gt;&lt;br&gt;&lt;br&gt;Match the RINEX observation header record &lt;b&gt;&lt;i&gt;MARKER NAME&lt;/i&gt;&lt;/b&gt; with the marker position present in the SINEX file. This is used to linearize the filter and to obtain the values for the models.&lt;br&gt;Besides, some fields of the &lt;b&gt;OUTPUT&lt;/b&gt; message are given as difference to this a priori position.&lt;br&gt;</string>
                                  </property>
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>SINEX</string>
                                  </property>
                                 </widget>
                                </item>
                                <item row="1" column="2">
                                 <widget class="QRadioButton" name="radioButtonSpecify">
                                  <property name="toolTip">
                                   <string>&lt;b&gt;Specify a priori receiver position&lt;/b&gt;&lt;br&gt;&lt;br&gt;Specify the receiver a priori position by providing the XYZ coordinates (for fixed receivers) or a reference position file (for moving receivers). This is used to linearize the filter and to obtain the values for the models.&lt;br&gt;Besides, the differential fields of the &lt;b&gt;OUTPUT&lt;/b&gt; message are given as difference to this a priori position.&lt;br&gt;</string>
                                  </property>
                                  <property name="toolTipDuration">
                                   <number>-1</number>
                                  </property>
                                  <property name="styleSheet">
