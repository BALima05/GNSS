                      <item row="0" column="1">
                       <widget class="QLineEdit" name="lineEditDataGap">
                        <property name="maximumSize">
                         <size>
                          <width>80</width>
                          <height>16777215</height>
                         </size>
                        </property>
                        <property name="clearButtonEnabled">
                         <bool>true</bool>
                        </property>
                       </widget>
                      </item>
                      <item row="0" column="0">
                       <widget class="QLabel" name="label_42">
                        <property name="sizePolicy">
                         <sizepolicy hsizetype="Fixed" vsizetype="Preferred">
                          <horstretch>0</horstretch>
                          <verstretch>0</verstretch>
                         </sizepolicy>
                        </property>
                        <property name="toolTip">
                         <string>&lt;b&gt;Data Gap&lt;/b&gt;&lt;br&gt;&lt;br&gt;This parameter sets the maximum period of time (in seconds) allowed between two consecutive data samples. Therefore, a larger period of time between data samples will automatically declare a cycle-slip.&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTES:&lt;/b&gt;&lt;ul&gt;&lt;li&gt;Samples discarded due to SNR mask will also count for the data gap.&lt;/li&gt;&lt;li&gt;If all cycle-slip detectors are disabled (LLI, Phase-Code difference, Melbourne-WÚbbena and Geometry-free), then Data Gap will be automatically disabled.&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;</string>
                        </property>
                        <property name="styleSheet">
                         <string notr="true">color: rgb(0, 0, 0);</string>
                        </property>
                        <property name="text">
                         <string>Data Gap</string>
                        </property>
                       </widget>
                      </item>
                      <item row="0" column="2">
                       <widget class="QLabel" name="label_169">
                        <property name="styleSheet">
                         <string notr="true">color: rgb(0, 0, 0);</string>
                        </property>
                        <property name="text">
                         <string>(s)</string>
                        </property>
                       </widget>
                      </item>
                      <item row="0" column="3">
                       <spacer name="horizontalSpacer_8">
                        <property name="orientation">
                         <enum>Qt::Horizontal</enum>
                        </property>
                        <property name="sizeHint" stdset="0">
                         <size>
