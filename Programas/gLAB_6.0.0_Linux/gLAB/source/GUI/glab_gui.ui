                                 <item row="0" column="0">
                                  <widget class="QFrame" name="frameInputRinexNavFile1">
                                   <property name="frameShape">
                                    <enum>QFrame::NoFrame</enum>
                                   </property>
                                   <property name="frameShadow">
                                    <enum>QFrame::Raised</enum>
                                   </property>
                                   <layout class="QGridLayout" name="gridLayout_509">
                                    <property name="leftMargin">
                                     <number>0</number>
                                    </property>
                                    <property name="topMargin">
                                     <number>0</number>
                                    </property>
                                    <property name="rightMargin">
