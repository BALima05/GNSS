                             <property name="font">
                              <font>
                               <weight>50</weight>
                               <bold>false</bold>
                              </font>
                             </property>
                             <property name="toolTip">
                              <string>&lt;b&gt;Estimate wet troposphere residual&lt;/b&gt;&lt;br&gt;&lt;br&gt;Activates the estimation of the wet troposphere residual. This estimation tries to remove the part of the wet troposphere not removed by the nominal modelling (see &lt;i&gt;Modelling&lt;/i&gt; section). The estimation depends on the model chosen to compute the M&lt;sub&gt;wet&lt;/sub&gt; (elevation) function (Niell should be chosen for better results).&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color='#C00000'&gt;IMPORTANT:&lt;/font&gt;&lt;/b&gt; A reliable troposphere estimation can only be obtained in the following options:&lt;ul&gt;&lt;li&gt;&lt;b&gt;Navigation Mode:&lt;/b&gt; PPP&lt;/li&gt;&lt;li&gt;&lt;b&gt;Measurements:&lt;/b&gt; Pseudorange + Carrier phase&lt;/li&gt;&lt;li&gt;&lt;b&gt;Available frequencies:&lt;/b&gt; Dual-Frequency&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;Outside this specific case, troposphere estimation should be disabled.&lt;br&gt;</string>
                             </property>
                             <property name="styleSheet">
                              <string notr="true">color: rgb(0, 0, 0);</string>
                             </property>
                             <property name="text">
                              <string>Estimate wet
troposphere residual</string>
                             </property>
                            </widget>
                           </item>
                          </layout>
                         </widget>
                        </item>
