                                    <string>&lt;b&gt;Unselect All&lt;/b&gt;&lt;br&gt;&lt;br&gt;Disable all constellations (but without changing the current order).&lt;br&gt;</string>
                                   </property>
                                   <property name="text">
                                    <string>Unselect All</string>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="0" column="3">
