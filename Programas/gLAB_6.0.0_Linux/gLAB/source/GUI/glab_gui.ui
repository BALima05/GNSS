                                  <property name="minimumSize">
                                   <size>
                                    <width>0</width>
                                    <height>23</height>
                                   </size>
                                  </property>
                                  <property name="toolTip">
                                   <string>&lt;b&gt;Start time of summary&lt;/b&gt;&lt;br&gt;&lt;br&gt;Set the first epoch (in GPS time) to be considered for the summary.&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTES:&lt;/b&gt;&lt;ul&gt;&lt;li&gt;In order to set an end epoch for the summary, set the last processed epoch in the INPUT section ('End Time' option) to the desired epoch.&lt;/li&gt;&lt;li&gt;If this option is set, parameter 'Ignore epochs for summary until epoch 0h 0m' above will be ignored.&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;</string>
                                  </property>
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>Start time of summary</string>
                                  </property>
                                 </widget>
                                </item>
                               </layout>
                              </widget>
                             </item>
                             <item row="4" column="0" colspan="4">
                              <widget class="QCheckBox" name="checkBoxWaitforDayStart">
                               <property name="toolTip">
                                <string>&lt;b&gt;Ignore epochs for summary until epoch 0h 0m&lt;/b&gt;&lt;br&gt;&lt;br&gt;All systems have a common step: the transitory (or convergence) time. For example, for SBAS systems, in a cold start with standard configuration, the user has to wait around 5 minutes to get enough data from the GEO (this is what gLAB considers the GEO acquisition time) or 6 minutes for the measurement smoothing to converge. Therefore, if a user wants to process 24 hours of data without convergence time, it has to add at least 6 minutes (but it is recommended to put at least 15 minutes) of measurements (in the RINEX observation file) and SBAS messages from the previous day.&lt;br&gt;Once this extra epochs are added to the input, at the start of the day gLAB will have already converged, but this extra epochs will affect the computation of the statistics in the summary. In order to get around this issue, if this option is set, gLAB will detect if the RINEX observation files starts at 22h or later, and in that case, it will automatically consider that all the epochs from 22h to 23h 59m 59s are for convergence and they will be automatically skipped in the computation of the summary statistics. (note that the first epoch used in the summary will be printed in the summary).&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTE:&lt;/b&gt; If option&lt;i&gt;Start time of summary&lt;/i&gt; below is set, this option has no effect.&lt;br&gt;</string>
                               </property>
                               <property name="styleSheet">
                                <string notr="true">color: rgb(0, 0, 0);</string>
                               </property>
                               <property name="text">
                                <string>Ignore epochs for summary until epoch 0h 0m</string>
                               </property>
                               <property name="checked">
                                <bool>true</bool>
                               </property>
                              </widget>
                             </item>
                             <item row="1" column="0">
                              <widget class="QLabel" name="labelSummaryPercentile">
                               <property name="toolTip">
                                <string>&lt;b&gt;Percentile Value&lt;/b&gt;&lt;br&gt;&lt;br&gt;Set the percentile value for the summary, which is is used for computing the DOP, positioning error, protection levels (only in SBAS) and integrity ratios (only on SBAS) percentiles.&lt;br&gt;&lt;br&gt;For example, if using the default value of 95, and the computed 95 percentile of the horizontal error is 1 metre, it means that 95% of the epochs processed with navigation solution had an horizontal error of 1 metre or less.&lt;br&gt;</string>
                               </property>
                               <property name="styleSheet">
                                <string notr="true">color: rgb(0, 0, 0);</string>
                               </property>
                               <property name="text">
                                <string>Percentile Value</string>
                               </property>
                              </widget>
                             </item>
