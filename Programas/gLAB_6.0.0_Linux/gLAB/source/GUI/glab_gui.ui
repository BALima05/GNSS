                          </item>
                          <item row="5" column="0">
                           <widget class="QCheckBox" name="checkBoxAllowUseNoneMOPSMeas">
                            <property name="toolTip">
                             <string>&lt;b&gt;Allow to Use None MOPS Measurements&lt;/b&gt;&lt;br&gt;&lt;br&gt;In SBAS DFMC, the ED-259 standard states that the following measurements must be used:&lt;ul&gt;&lt;li&gt;&lt;b&gt;GPS L1:&lt;/b&gt; C1C and L1C.&lt;/li&gt;&lt;li&gt;&lt;b&gt;GPS L5:&lt;/b&gt; C5Q and L5Q.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Galileo E1:&lt;/b&gt; C1C and L1C.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Galileo E5a:&lt;/b&gt; C5Q and L5Q.&lt;/li&gt;&lt;/ul&gt;Depending on the RINEX observation file, C5I and L5I pair or C5X and L5X pair of measurements are available instead of C5Q and L5Q, which are not allowed by ED-259.&lt;br&gt;&lt;br&gt;By enabling this option, gLAB will use C5I or C5X whenever C5Q is not available instead of not computing any user navigation solution. This will slightly degrade the user navigation solution (as there is a bias between C5I or C5X with respect to C5Q).&lt;br&gt;</string>
                            </property>
                            <property name="styleSheet">
                             <string notr="true">color: rgb(0, 0, 0);</string>
                            </property>
                            <property name="text">
                             <string>Allow to Use None MOPS Measurements</string>
                            </property>
                           </widget>
                          </item>
                          <item row="18" column="0">
                           <widget class="QGroupBox" name="groupBoxShowOldMessages">
                            <property name="font">
                             <font>
                              <pointsize>9</pointsize>
                              <weight>75</weight>
                              <bold>true</bold>
                             </font>
                            </property>
                            <property name="title">
                             <string>Show Old Messages</string>
                            </property>
                            <property name="checkable">
                             <bool>true</bool>
                            </property>
                            <property name="checked">
                             <bool>true</bool>
                            </property>
                            <layout class="QGridLayout" name="gridLayout_240">
                             <property name="horizontalSpacing">
                              <number>6</number>
                             </property>
                             <property name="verticalSpacing">
                              <number>3</number>
                             </property>
                             <item row="0" column="0">
                              <widget class="QFrame" name="frameShowOldMessages">
                               <property name="frameShape">
                                <enum>QFrame::NoFrame</enum>
                               </property>
                               <property name="frameShadow">
                                <enum>QFrame::Raised</enum>
                               </property>
                               <layout class="QGridLayout" name="gridLayout_357">
                                <property name="leftMargin">
                                 <number>0</number>
                                </property>
                                <property name="topMargin">
                                 <number>0</number>
                                </property>
                                <property name="rightMargin">
                                 <number>0</number>
                                </property>
                                <property name="bottomMargin">
                                 <number>0</number>
                                </property>
                                <item row="0" column="0">
                                 <widget class="QCheckBox" name="checkBoxDecodeMT37">
                                  <property name="toolTip">
                                   <string>&lt;b&gt;Decode Message Type 37 using ED-259 version &amp;le; 0.4&lt;/b&gt;&lt;br&gt;&lt;br&gt;In ED-259 version 0.5 message type 37 (&lt;i&gt;OBAD Parameters and DFREI Scale Table&lt;/i&gt;) had the following changes:&lt;ul&gt;&lt;li&gt;&amp;sigma;&lt;sub&gt;DFREI=14&lt;/sub&gt; parameter size changed from 2 to 4 bits.&lt;/li&gt;&lt;li&gt;&amp;sigma;&lt;sub&gt;DFREI=14&lt;/sub&gt; scale factor changed from 30 to 6 metres.&lt;/li&gt;&lt;/ul&gt;gLAB by default will decode MT37 message using the last version defined in gLAB code. Enabling this option will make gLAB decode MT37 with ED-259 version 0.4.&lt;br&gt;</string>
                                  </property>
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>Decode Message Type 37 using ED-259 version &lt;=0.4</string>
                                  </property>
                                 </widget>
                                </item>
                                <item row="1" column="0">
                                 <widget class="QCheckBox" name="checkBoxDecodeMT3940">
                                  <property name="toolTip">
                                   <string>&lt;b&gt;Decode Message Type 39/40 using ED-259 version &amp;le; 0.4&lt;/b&gt;&lt;br&gt;&lt;br&gt;In ED-259 version 0.5 message type 39 and 40 (&lt;i&gt;SBAS Satellite Ephemeris Corrections and Covariance Matrix&lt;/i&gt;) had the following changes:&lt;ul&gt;&lt;li&gt;&lt;i&gt;a&lt;/i&gt; parameter is moved from MT39 to MT40.&lt;/li&gt;&lt;li&gt;&lt;i&gt;a&lt;/i&gt; parameter size changed from 32 to 31 bits.&lt;/li&gt;&lt;li&gt;&lt;i&gt;a&lt;/i&gt; scale factor changed from 0.01 to 0.02 metres.&lt;/li&gt;&lt;li&gt;&amp;omega; parameter size changed from 35 to 34 bits.&lt;/li&gt;&lt;li&gt;&amp;omega; scale factor changed from &amp;pi; · 2&lt;sup&gt;-34&lt;/sup&gt; to &amp;pi; · 2&lt;sup&gt;-33&lt;/sup&gt; radians.&lt;/li&gt;&lt;li&gt;&amp;Omega;&lt;sub&gt;0&lt;/sub&gt; parameter size changed from 35 to 34 bits.&lt;/li&gt;&lt;li&gt;&amp;Omega;&lt;sub&gt;0&lt;/sub&gt; scale factor changed from &amp;pi; · 2&lt;sup&gt;-34&lt;/sup&gt; to &amp;pi; · 2&lt;sup&gt;-33&lt;/sup&gt; radians.&lt;/li&gt;&lt;li&gt;M&lt;sub&gt;0&lt;/sub&gt; parameter size changed from 35 to 34 bits.&lt;/li&gt;&lt;li&gt;M&lt;sub&gt;0&lt;/sub&gt; scale factor changed from &amp;pi; · 2&lt;sup&gt;-34&lt;/sup&gt; to &amp;pi; · 2&lt;sup&gt;-33&lt;/sup&gt; radians.&lt;/li&gt;&lt;li&gt;&lt;i&gt;a&lt;sub&gt;Gf0&lt;/sub&gt;&lt;/i&gt; parameter is moved from MT40 to MT39.&lt;/li&gt;&lt;li&gt;&lt;i&gt;a&lt;sub&gt;Gf0&lt;/sub&gt;&lt;/i&gt; parameter size changed from 15 to 25 bits.&lt;/li&gt;&lt;li&gt;&lt;i&gt;a&lt;sub&gt;Gf1&lt;/sub&gt;&lt;/i&gt; parameter is moved from MT40 to MT39.&lt;/li&gt;&lt;li&gt;&lt;i&gt;a&lt;sub&gt;Gf1&lt;/sub&gt;&lt;/i&gt; parameter size changed from 11 to 16 bits.&lt;/li&gt;&lt;li&gt;&lt;i&gt;a&lt;sub&gt;Gf1&lt;/sub&gt;&lt;/i&gt; scale factor changed from 5E-5 to 4E-5 metres/second.&lt;/li&gt;&lt;li&gt;&lt;i&gt;i&lt;/i&gt; parameter size changed from 34 to 33 bits.&lt;/li&gt;&lt;li&gt;&lt;i&gt;i&lt;/i&gt; scale factor changed from &amp;pi; · 2&lt;sup&gt;-34&lt;/sup&gt; to &amp;pi; · 2&lt;sup&gt;-33&lt;/sup&gt; radians.&lt;/li&gt;&lt;li&gt;&lt;i&gt;e&lt;/i&gt; parameter size changed from 31 to 30 bits.&lt;/li&gt;&lt;li&gt;&lt;i&gt;e&lt;/i&gt; scale factor changed from 2&lt;sup&gt;-31&lt;/sup&gt; to 2&lt;sup&gt;-30&lt;/sup&gt; (adimensional).&lt;/li&gt;&lt;/ul&gt;gLAB by default will decode MT39 and 40 messages using the last version defined in gLAB code. Enabling this option will make gLAB decode MT39 and 40 with ED-259 version 0.4.&lt;br&gt;</string>
                                  </property>
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>Decode Message Type 39/40 using ED-259 version &lt;=0.4</string>
                                  </property>
                                 </widget>
                                </item>
                                <item row="2" column="0">
                                 <widget class="QCheckBox" name="checkBoxDecodeMT42">
                                  <property name="toolTip">
                                   <string>&lt;b&gt;Decode Message Type 42 using ED-259 version &amp;le; 0.7&lt;/b&gt;&lt;br&gt;&lt;br&gt;In ED-259 version 0.8 message type 42 (&lt;i&gt;GNSS Time Offsets&lt;/i&gt;) had the following change:&lt;ul&gt;&lt;li&gt;DN parameter size changed from 8 to 3 bits.&lt;/li&gt;&lt;/ul&gt;gLAB by default will decode MT42 message using the last version defined in gLAB code. Enabling this option will make gLAB decode MT42 with ED-259 version 0.7.&lt;br&gt;</string>
                                  </property>
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>Decode Message Type 42 using ED-259 version &lt;=0.7</string>
                                  </property>
                                 </widget>
                                </item>
                                <item row="3" column="0">
                                 <widget class="QCheckBox" name="checkBoxDecodeMT47">
                                  <property name="toolTip">
                                   <string>&lt;b&gt;Decode Message Type 47 using ED-259 version &amp;le; 0.4&lt;/b&gt;&lt;br&gt;&lt;br&gt;In ED-259 version 0.5 message type 47 (&lt;i&gt;SBAS Satellites Almanacs&lt;/i&gt;) had the following change:&lt;ul&gt;&lt;li&gt;Added parameter WNRO&lt;sub&gt;count&lt;/sub&gt; (Week Number Roll Over count).&lt;/li&gt;&lt;/ul&gt;gLAB by default will decode MT47 message using the last version defined in gLAB code. Enabling this option will make gLAB decode MT47 with ED-259 version 0.5.&lt;br&gt;</string>
                                  </property>
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>Decode Message Type 47 using ED-259 version &lt;=0.4</string>
                                  </property>
                                 </widget>
                                </item>
                                <item row="4" column="0">
                                 <widget class="QCheckBox" name="checkBoxProcessAustralianTestBedMessages">
                                  <property name="acceptDrops">
                                   <bool>false</bool>
                                  </property>
                                  <property name="toolTip">
                                   <string>&lt;b&gt;Process Australian Test Bed Messages&lt;/b&gt;&lt;br&gt;&lt;br&gt;Australian Test Bed is based on ED-259 v0.3 along with two in-house modifications:&lt;ul&gt;&lt;li&gt;Messages type 34, 35 and 36 (&lt;i&gt;Integrity Messages&lt;/i&gt;) are also sent within MT0 (see &lt;i&gt;Parse Alarm Message as Type 34/35/36 Messages&lt;/i&gt;).&lt;/li&gt;&lt;li&gt;GPS DCB P1 - P2 is included in the corrections, therefore it must &lt;b&gt;not&lt;/b&gt; be applied in the modelling, contrary to what ED-259 states.&lt;/li&gt;&lt;/ul&gt;To properly process Australian Test Bed messages, the following options must be set (all of them are automatically set when this option is set) which are different from the SBAS DFMC default template:&lt;ul&gt;&lt;li&gt;Enable &lt;i&gt;Parse Alarm Message as Type 34/35/36 Messages&lt;/i&gt;.&lt;/li&gt;&lt;li&gt;Disable GPS &lt;i&gt;DCB for Double Frequency&lt;/i&gt;.&lt;/li&gt;&lt;li&gt;Enable &lt;i&gt;Decode Message Type 37 using ED-259 version &amp;le; 0.4&lt;/i&gt;.&lt;/li&gt;&lt;li&gt;Enable &lt;i&gt;Decode Message Type 39/40 using ED-259 version &amp;le; 0.4&lt;/i&gt;.&lt;/li&gt;&lt;li&gt;Enable &lt;i&gt;Decode Message Type 42 using ED-259 version &amp;le; 0.7&lt;/i&gt;.&lt;/li&gt;&lt;li&gt;Enable &lt;i&gt;Decode Message Type 47 using ED-259 version &amp;le; 0.4&lt;/i&gt;.&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;</string>
                                  </property>
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>Process Australian Test Bed Messages</string>
                                  </property>
                                 </widget>
                                </item>
                               </layout>
                              </widget>
                             </item>
                            </layout>
                           </widget>
                          </item>
                          <item row="15" column="0">
                           <widget class="QGroupBox" name="groupBoxSetSepcificSigmas">
                            <property name="font">
                             <font>
                              <pointsize>9</pointsize>
                              <weight>75</weight>
                              <bold>true</bold>
                             </font>
                            </property>
                            <property name="title">
                             <string>Show Set Specific Sigmas</string>
                            </property>
                            <property name="checkable">
                             <bool>true</bool>
                            </property>
                            <property name="checked">
                             <bool>true</bool>
                            </property>
                            <layout class="QGridLayout" name="gridLayout_300">
                             <property name="horizontalSpacing">
                              <number>6</number>
                             </property>
                             <property name="verticalSpacing">
                              <number>3</number>
                             </property>
                             <item row="0" column="0">
                              <widget class="QFrame" name="frameSetSepcificSigmas">
                               <property name="frameShape">
                                <enum>QFrame::NoFrame</enum>
                               </property>
                               <property name="frameShadow">
                                <enum>QFrame::Raised</enum>
                               </property>
                               <layout class="QGridLayout" name="gridLayout_394">
                                <property name="leftMargin">
                                 <number>0</number>
                                </property>
                                <property name="topMargin">
                                 <number>0</number>
                                </property>
                                <property name="rightMargin">
                                 <number>0</number>
                                </property>
                                <property name="bottomMargin">
                                 <number>0</number>
                                </property>
                                <item row="3" column="0">
                                 <widget class="QCheckBox" name="checkBoxSetTroposphericSigma">
                                  <property name="minimumSize">
                                   <size>
                                    <width>0</width>
                                    <height>25</height>
                                   </size>
                                  </property>
                                  <property name="toolTip">
                                   <string>&lt;b&gt;Set Tropospheric Sigma&lt;/b&gt;&lt;br&gt;&lt;br&gt;Set the tropospheric sigma, &amp;sigma;&lt;sub&gt;tropo&lt;/sub&gt; (in metres) instead of using the formula in ED-259 (explained below). This sigma is to account for the tropospheric error.&lt;br&gt;&lt;br&gt;The formula in ED-259 to compute &amp;sigma;&lt;sub&gt;tropo&lt;/sub&gt; is the following:&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;sigma;&lt;sub&gt;tropo&lt;/sub&gt;  =  &amp;sigma;&lt;sub&gt;TVE&lt;/sub&gt; · m(El) (metres)&lt;br&gt;&lt;br&gt;Where:&lt;ul&gt;&lt;li&gt;&lt;b&gt;&amp;sigma;&lt;sub&gt;TVE&lt;/sub&gt;:&lt;/b&gt; = 0.12 (metres)&lt;/li&gt;&lt;li&gt;&lt;b&gt;m(El):&lt;/b&gt; The mapping function for satellite elevation, computed with the following formula:&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;m(El) = 1.001 / ( sqrt( 0.002001 + sin&lt;sup&gt;2&lt;/sup&gt;(El) ) (adimensional)&lt;br&gt;&lt;br&gt;&lt;be&gt; Where El is the satellite elevation (in radians).&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;</string>
                                  </property>
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>Set Tropospheric Sigma</string>
                                  </property>
                                 </widget>
                                </item>
                                <item row="0" column="3">
                                 <spacer name="horizontalSpacer_94">
                                  <property name="orientation">
                                   <enum>Qt::Horizontal</enum>
                                  </property>
                                  <property name="sizeHint" stdset="0">
                                   <size>
                                    <width>0</width>
                                    <height>20</height>
                                   </size>
                                  </property>
                                 </spacer>
                                </item>
                                <item row="0" column="0">
                                 <widget class="QCheckBox" name="checkBoxSetDeltaRcorrParameter">
                                  <property name="minimumSize">
                                   <size>
                                    <width>0</width>
                                    <height>25</height>
                                   </size>
                                  </property>
                                  <property name="toolTip">
                                   <string>&lt;b&gt;Set Delta Rcorr Parameter&lt;/b&gt;&lt;br&gt;&lt;br&gt;Set the &amp;delta;R&lt;sub&gt;corr&lt;/sub&gt; (adimensional) for all satellites and constellations.&lt;br&gt;&lt;br&gt;When this option is set, &amp;delta;R&lt;sub&gt;corr&lt;/sub&gt; sent in message type 32 (&lt;i&gt;Clock Ephemeris Corrections and Covariance Matrix&lt;/i&gt;) or message type 39/40 (&lt;i&gt;SBAS Satellite Ephemeris Corrections and Covariance Matrix&lt;/i&gt;) will be ignored.&lt;br&gt;&lt;br&gt;See tooltip &lt;i&gt;Set Rcorr OBAD Parameter from MT 37&lt;/i&gt; for details on how this parameter is applied.&lt;br&gt;</string>
                                  </property>
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>Set Delta Rcorr Parameter</string>
                                  </property>
                                 </widget>
                                </item>
                                <item row="1" column="1">
                                 <widget class="QLineEdit" name="lineEditSetDeltaDFREFactor">
                                  <property name="clearButtonEnabled">
                                   <bool>true</bool>
                                  </property>
                                 </widget>
                                </item>
                                <item row="2" column="0">
                                 <widget class="QCheckBox" name="checkBoxSetUIRESigmaValue">
                                  <property name="minimumSize">
                                   <size>
                                    <width>0</width>
                                    <height>25</height>
                                   </size>
                                  </property>
                                  <property name="toolTip">
                                   <string>&lt;b&gt;Set Sigma UIRE Value&lt;/b&gt;&lt;br&gt;&lt;br&gt;Set the &amp;sigma;&lt;sub&gt;UIRE&lt;/sub&gt; (sigma User Ionospheric Range Error) (in metres) instead of using the formula in ED-259 (explained below). This sigma is to account for the residual ionospheric error when a ionosphere-free combination is used.&lt;br&gt;&lt;br&gt;Ionosphere-free combination removes the first order ionospheric delay (responsible of around 99% of the ionospheric delay), therefore second or higher order ionospheric delay remain. These higher order terms are very small (millimetres), but can become none negligible in case of high ionospheric activity (e.g. ionospheric storm).&lt;br&gt;&lt;br&gt;The formula in ED-259 to compute &amp;sigma;&lt;sub&gt;UIRE&lt;/sub&gt; is the following:&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;sigma;&lt;sub&gt;UIRE&lt;/sub&gt; = 40.0 / ( 261.0 + El&lt;sub&gt;deg&lt;/sub&gt;&lt;sup&gt;2&lt;/sup&gt; ) +0.018 (in metres)&lt;br&gt;&lt;br&gt; Where  El&lt;sub&gt;deg&lt;/sub&gt; is the satellite elevation (in degrees).&lt;br&gt;</string>
                                  </property>
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>Set Sigma UIRE Value</string>
                                  </property>
                                 </widget>
                                </item>
                                <item row="1" column="0">
                                 <widget class="QCheckBox" name="checkBoxSetDeltaDFREFactor">
                                  <property name="minimumSize">
                                   <size>
                                    <width>0</width>
                                    <height>25</height>
                                   </size>
                                  </property>
                                  <property name="toolTip">
                                   <string>&lt;b&gt;Set Delta DFRE Factor&lt;/b&gt;&lt;br&gt;&lt;br&gt;Set the &amp;delta;DFRE (Delta Dual Frequency Range Error) factor (adimensional) for all satellites and constellations instead of using the formula set in ED-259 (explained below).&lt;br&gt;&lt;br&gt;In ED-259, the following formula is used for computing &amp;delta;DFRE:&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;delta;DFRE = sqrt( I&lt;sup&gt;T&lt;/sup&gt; · C · I ) + &amp;epsilon;&lt;sub&gt;c&lt;/sub&gt; (adimensional)&lt;br&gt;&lt;br&gt;Where:&lt;ul&gt;&lt;li&gt;&lt;b&gt;I:&lt;/b&gt; Tthe 4-D line of sight vector from the user to the satellite in the WGS-84 coordinate frame, where the first three components are the unit vector from the user to the satellite and the fourth component is a one.&lt;/li&gt;&lt;li&gt;&lt;b&gt;C:&lt;/b&gt; The clock-ephemeris covariance matrix.&lt;/li&gt;&lt;li&gt;&lt;b&gt;&amp;epsilon;&lt;sub&gt;c&lt;/sub&gt;:&lt;/b&gt; Degradation parameter for &amp;delta;DFRE. See tooltip &lt;i&gt;Set Ccovariance OBAD Parameter from MT 37&lt;/i&gt; for details on how to compute this degradation factor.&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;</string>
                                  </property>
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>Set Delta DFRE Factor</string>
                                  </property>
                                 </widget>
                                </item>
                                <item row="2" column="1">
                                 <widget class="QLineEdit" name="lineEditSetUIRESigmaValue">
                                  <property name="clearButtonEnabled">
                                   <bool>true</bool>
                                  </property>
                                 </widget>
                                </item>
                                <item row="3" column="1">
                                 <widget class="QLineEdit" name="lineEditSetTroposphericSigma">
                                  <property name="clearButtonEnabled">
                                   <bool>true</bool>
                                  </property>
                                 </widget>
                                </item>
                                <item row="0" column="1">
                                 <widget class="QLineEdit" name="lineEditSetDeltaRcorrParameter">
                                  <property name="clearButtonEnabled">
                                   <bool>true</bool>
                                  </property>
                                 </widget>
                                </item>
                                <item row="0" column="2">
                                 <widget class="QLabel" name="labelSetDeltaRcorrParameter">
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>(adimensional)</string>
                                  </property>
                                 </widget>
                                </item>
                                <item row="1" column="2">
                                 <widget class="QLabel" name="labelSetDeltaDFREFactor">
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>(adimensional)</string>
                                  </property>
                                 </widget>
                                </item>
                                <item row="2" column="2">
