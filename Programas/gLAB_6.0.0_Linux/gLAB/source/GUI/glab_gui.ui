                          <item row="1" column="0">
                           <widget class="QCheckBox" name="checkBoxParseAlarmSBASDFMC">
                            <property name="toolTip">
                             <string>&lt;b&gt;Parse Alarm Message as Type 34/35/36 Messages&lt;/b&gt;&lt;br&gt;&lt;br&gt;In GEOs in test mode, alarm messages (message type 0) may also contain the same data as messages type 34/35/36 (integrity messages), although the integrity of the corrections are not guaranteed.&lt;br&gt;&lt;br&gt;If this option is enabled, Alarm messages will read as a fast correction (no alarm is triggered), except for the case that the message is filled with zeros,  where it will be treated as an alarm message.&lt;br&gt;&lt;br&gt;This behaviour is not implemented in ED-259, but it is an extension made in the Australian test bed.&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTE:&lt;/b&gt; Message types are distinguished by using the two spare bits in positions 222 and 223. Value &quot;00&quot;, correspond to MT0, value &quot;01&quot; correspond to MT34, &quot;10&quot; to MT35 and &quot;11&quot; to MT36.&lt;br&gt;</string>
                            </property>
                            <property name="styleSheet">
                             <string notr="true">color: rgb(0, 0, 0);</string>
                            </property>
                            <property name="text">
                             <string>Parse Alarm Message as Type 34/35/36 Messages</string>
                            </property>
                           </widget>
                          </item>
                         </layout>
                        </widget>
                       </item>
                      </layout>
                     </widget>
                    </item>
