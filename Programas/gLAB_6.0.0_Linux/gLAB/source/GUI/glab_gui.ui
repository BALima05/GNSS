                                    <string>GEO Satellite Almanacs</string>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="10" column="1">
                                  <widget class="QLabel" name="label_130">
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>17</string>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="10" column="2">
                                  <widget class="QLineEdit" name="lineEditGeoSatelliteAlmanacsPA">
                                   <property name="clearButtonEnabled">
                                    <bool>true</bool>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="10" column="3">
                                  <widget class="QLineEdit" name="lineEditGeoSatelliteAlmanacsNPA">
                                   <property name="clearButtonEnabled">
                                    <bool>true</bool>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="10" column="4">
                                  <widget class="QLabel" name="label_19">
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>(s)</string>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="11" column="0">
                                  <widget class="QLabel" name="label_119">
                                   <property name="toolTip">
                                    <string>&lt;b&gt;Ionospheric Grid Points Mask&lt;/b&gt;&lt;br&gt;&lt;br&gt;Message type 18. In order to provide a ionospheric model for users, MOPS defines a (irregular) grid of points covering all the world, and the SBAS providers must trnasmit then which points of this grid are they monitoring, and send the ionospheric delay estimation and its sigma to the user. As the number of points is too large to be transmitted in a single message, the points are divided in 11 bands (9 vertical and 2 horizontal). Each band will have a given number of points,and only some of the points in a band may be monitorized.&lt;br&gt;To inform the user which grid points are monitorized, each message type 18 will send the number of bands monitored, and a mask of 201 bits (each bit corresponds to one point). If the bit is 1, then the grid point is monitored. The conversion from the bit position to the grid point is fixed. It is explained in MOPS document.&lt;br&gt;All band mask have the same associated IODI (Issue of Data Ionosphere), which will only change if the monitored IGPs change in any of the bands (which will be rare).&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTE:&lt;/b&gt; In the first version of MOPS there were no horizontal bands. They were added in MOPS-B due to the few amount of grid points at high latitudes in the vertical bands. See band map below (from &lt;i&gt;Ionospheric information broadcasting methods for standardization in SBAS L5&lt;/i&gt; (Prieto-Cerdeira et al)):&lt;br&gt;&lt;img width=&quot;850&quot;  src=&quot;:/data/igp_grid.jpg&quot; &gt;</string>
                                   </property>
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>Ionospheric Grid Points Mask</string>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="11" column="1">
                                  <widget class="QLabel" name="label_120">
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>18</string>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="11" column="2">
                                  <widget class="QLineEdit" name="lineEditIonosphericGridPointsMaskPA">
                                   <property name="clearButtonEnabled">
                                    <bool>true</bool>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="11" column="3">
                                  <widget class="QLineEdit" name="lineEditIonosphericGridPointsMaskNPA">
                                   <property name="clearButtonEnabled">
                                    <bool>true</bool>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="11" column="4">
                                  <widget class="QLabel" name="label_22">
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>(s)</string>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="12" column="0">
                                  <widget class="QLabel" name="label_117">
                                   <property name="toolTip">
                                    <string>&lt;b&gt;Long Term Satellite Corrections&lt;/b&gt;&lt;br&gt;&lt;br&gt;Message type 25. This message contains corrections to orbit coordinates and clock correction. This correction is tied to a specific GPS navigation message, which is uniquely identified by the IODE (Issue Of Data Ephemerides) field. If the user cannot find a navigation message with the same IODE as in the message type 25, then no SBAS correction can be computed. If the IODE matches, the computed corrections (clock and orbit corrections) have to be added directly to the  orbit and clock values computed with the navigation message.&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTES:&lt;/b&gt;&lt;ul&gt;&lt;li&gt;Long term correction messages have an IODP, which must match with the one received in the message type 1 (PRN mask). If they don't match, this messages cannot be decoded.&lt;/li&gt;&lt;li&gt;For SBAS GEOs, no corrections are sent, as message type 9 is the navigation message for GEOs, which already include the necessary corrections.&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;</string>
                                   </property>
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>Long Term Satellite Corrections</string>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="12" column="1">
                                  <widget class="QLabel" name="label_118">
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>25</string>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="12" column="2">
                                  <widget class="QLineEdit" name="lineEditLongTermSatelliteCorrectionsPA">
                                   <property name="clearButtonEnabled">
                                    <bool>true</bool>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="12" column="3">
                                  <widget class="QLineEdit" name="lineEditLongTermSatelliteCorrectionsNPA">
                                   <property name="clearButtonEnabled">
                                    <bool>true</bool>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="12" column="4">
                                  <widget class="QLabel" name="label_23">
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>(s)</string>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="13" column="0">
                                  <widget class="QLabel" name="label_121">
                                   <property name="enabled">
                                    <bool>false</bool>
                                   </property>
                                   <property name="toolTip">
                                    <string>&lt;b&gt;Ionospheric Delay Corrections&lt;/b&gt;&lt;br&gt;&lt;br&gt;Message type 26. This message contains the ionospheric delay estimations and its sigma. As explained in message type 18 tooltip, the grid points are divided into maps in order to be sent to the user. Therefore, each message type 26 will have a band number indicator. Furthermore, all the corrections for all the grid points monitored in a band do no fit in a single message type 18, so tthe corrections are sent by blocks identified by the &quot;Block ID&quot; in the message.&lt;br&gt;Only the corrections for the monitored grid points monitored are given, and they are sent in the same order as they appear in the band mask sent in message type 18.&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTE:&lt;/b&gt; All messages type 26 have an IODI (Issue of Data Ionosphere), which must match with the one given in message type 18 in order to decode the message. If the IODI does not match, the user must save the message and wait to receive the band mask with the right IODI in order to decode message type 26.&lt;br&gt;</string>
                                   </property>
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>Ionospheric Delay Corrections</string>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="13" column="1">
                                  <widget class="QLabel" name="label_122">
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>26</string>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="13" column="2">
                                  <widget class="QLineEdit" name="lineEditIonosphericDelayCorrectionsPA">
                                   <property name="clearButtonEnabled">
                                    <bool>true</bool>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="13" column="3">
                                  <widget class="QLineEdit" name="lineEditIonosphericDelayCorrectionsNPA">
                                   <property name="clearButtonEnabled">
                                    <bool>true</bool>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="13" column="4">
                                  <widget class="QLabel" name="label_44">
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>(s)</string>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="14" column="0">
                                  <widget class="QLabel" name="label_123">
                                   <property name="toolTip">
                                    <string>&lt;b&gt;Service Message&lt;/b&gt;&lt;br&gt;&lt;br&gt;Message type 27. This message contains data for computing the &amp;delta;UDRE for the fast and long term correction degradation. The &amp;delta;UDRE is a adimensional factor that multiplies the &amp;sigma;&lt;sub&gt;UDRE&lt;/sub&gt; received in the fast correction message (see &lt;i&gt;Degradation Parameters&lt;/i&gt; tooltip above). This factor will never be smaller than 1, and can be computed in two ways (one way is with message type 27, and the other with message type 28). The way to compute the &amp;delta;UDRE is decided by the SBAS service provider. For the case that the service provider sends message type 27:&lt;br&gt;&lt;br&gt;A series of regions are defined in this message (which can be squared or triangular, and can be split in several message type 27), along with values of the &amp;delta;UDRE inside and outside of these regions. The user must select the appropiate &amp;delta;UDRE value according to his position and the regions defined.&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTES:&lt;/b&gt;&lt;ul&gt;&lt;li&gt;EGNOS system sends message type 27 for computing the &amp;delta;UDRE.&lt;/li&gt;&lt;li&gt;SBAS service providers can only send either message type 27 or 28, but not both. If user receives both messages, a &amp;delta;UDRE equal to 1 will be used.&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;</string>
                                   </property>
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>Service Message</string>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="14" column="1">
                                  <widget class="QLabel" name="label_124">
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>27</string>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="14" column="2">
                                  <widget class="QLineEdit" name="lineEditServiceMessagePA">
                                   <property name="clearButtonEnabled">
                                    <bool>true</bool>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="14" column="3">
                                  <widget class="QLineEdit" name="lineEditServiceMessageNPA">
                                   <property name="clearButtonEnabled">
                                    <bool>true</bool>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="14" column="4">
                                  <widget class="QLabel" name="label_46">
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>(s)</string>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="15" column="0">
                                  <widget class="QLabel" name="label_125">
                                   <property name="toolTip">
                                    <string>&lt;b&gt;Clock Ephemeris Covariance Matrix&lt;/b&gt;&lt;br&gt;&lt;br&gt;Message type 28. This message contains data for computing the &amp;delta;UDRE for the fast and long term correction degradation. The &amp;delta;UDRE is an adimensional factor that multiplies the &amp;sigma;&lt;sub&gt;UDRE&lt;/sub&gt; received in the fast correction message (see &lt;i&gt;Degradation Parameters&lt;/i&gt; tooltip above). This factor will never be smaller than 1, and can be computed in two ways (one way is with message type 27, and the other with message type 28). The way to compute the &amp;delta;UDRE is decided by the SBAS service provider. For the case that the service provider sends message type 28:&lt;br&gt;&lt;br&gt;For each satellite a covariance matrix from which the &amp;delta;UDRE can be computed. This covariance matrix can be updated at the same rate of the slow corrections&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTES:&lt;/b&gt;&lt;ul&gt;&lt;li&gt;WAAS system sends message type 28 for computing the &amp;delta;UDRE.&lt;/li&gt;&lt;li&gt;SBAS service providers can only send either message type 27 or 28, but not both. If user receives both messages, a &amp;delta;UDRE equal to 1 will be used.&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;</string>
                                   </property>
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>Clock Ephemeris Covariance Matrix</string>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="15" column="1">
                                  <widget class="QLabel" name="label_126">
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>28</string>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="15" column="2">
                                  <widget class="QLineEdit" name="lineEditClockEphemerisCovarianceMatrixPA">
                                   <property name="clearButtonEnabled">
                                    <bool>true</bool>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="15" column="3">
                                  <widget class="QLineEdit" name="lineEditClockEphemerisCovarianceMatrixNPA">
                                   <property name="clearButtonEnabled">
                                    <bool>true</bool>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="15" column="4">
                                  <widget class="QLabel" name="label_48">
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>(s)</string>
                                   </property>
                                  </widget>
                                 </item>
                                </layout>
                               </widget>
                              </item>
                             </layout>
                            </widget>
