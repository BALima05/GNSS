                               <number>0</number>
                              </property>
                              <item row="0" column="6">
                               <widget class="QRadioButton" name="radioButtonConstantISCB">
                                <property name="minimumSize">
                                 <size>
                                  <width>73</width>
                                  <height>0</height>
                                 </size>
                                </property>
                                <property name="maximumSize">
                                 <size>
                                  <width>73</width>
                                  <height>16777215</height>
                                 </size>
                                </property>
                                <property name="toolTip">
                                 <string>&lt;b&gt;Constant&lt;/b&gt;&lt;br&gt;&lt;br&gt;Select this option to perform a processing supposing that the inter-system clock biases do not drift (e.g. when using precise orbits, as all clock corrections are estimated with the same reference clock), so inter-system clock biases correlation between epochs is maintained.&lt;br&gt;This modifies the filter parameters &lt;b&gt;Phi&lt;/b&gt; (propagation) and &lt;b&gt;Q&lt;/b&gt; (process noise) for the inter-system clock biases estimation to:&lt;ul&gt;&lt;li&gt;Phi = 1&lt;/li&gt;&lt;li&gt;Q =  0 m&lt;sup&gt;2&lt;/sup&gt;&lt;/li&gt;&lt;/ul&gt;&lt;b&gt;NOTE:&lt;/b&gt; When loading a configuration file and no Q value for the inter-system clock bias is provided or Q!=0, this option will be set as it is the default one (only in PPP mode). This is due to that the command line has no notion of &lt;i&gt;constant&lt;/i&gt; or &lt;i&gt;White noise&lt;/i&gt;, as it just sets the value of Q accordingly (therefore there is no parameter to set this option directly).&lt;br&gt;</string>
                                </property>
                                <property name="styleSheet">
                                 <string notr="true">color: rgb(0, 0, 0);</string>
                                </property>
                                <property name="text">
                                 <string>Constant</string>
                                </property>
                               </widget>
                              </item>
                              <item row="0" column="7">
                               <widget class="QRadioButton" name="radioButtonWhiteNoiseISCB">
                                <property name="minimumSize">
                                 <size>
                                  <width>93</width>
                                  <height>0</height>
                                 </size>
                                </property>
                                <property name="maximumSize">
                                 <size>
                                  <width>93</width>
                                  <height>16777215</height>
                                 </size>
                                </property>
                                <property name="toolTip">
                                 <string>&lt;b&gt;White noise&lt;/b&gt;&lt;br&gt;&lt;br&gt;Select this option to perform a processing supposing that the inter-system clock biases drift are unprecitable (e.g. when using broadcast orbits, as each constellation clock varies differently), so there is no inter-system clock bias correlation between epochs.&lt;br&gt;This modifies the filter parameters &lt;b&gt;Phi&lt;/b&gt; (propagation) and &lt;b&gt;Q&lt;/b&gt; (process noise) for the inter-system clock bias estimation to:&lt;ul&gt;&lt;li&gt;Phi = 0&lt;/li&gt;&lt;li&gt;Q =  9·10&lt;sup&gt;10&lt;/sup&gt; m&lt;sup&gt;2&lt;/sup&gt;&lt;/li&gt;&lt;/ul&gt;&lt;b&gt;NOTES:&lt;/b&gt;&lt;ul&gt;&lt;li&gt;When loading a configuration file and no Q value for the inter-system clock bias is provided or Q!=0, this option will be set as it is the default one (except for PPP mode). This is due to that the command line has no notion of &lt;i&gt;constant&lt;/i&gt; or &lt;i&gt;White noise&lt;/i&gt;, as it just sets the value of Q accordingly (therefore there is no parameter to set this option directly).&lt;/li&gt;&lt;li&gt;Setting the inter-system clock bias to a &lt;i&gt;White Noise&lt;/i&gt; behaviour makes the Kalman filter to behave as a Weighted Least Square (WLS) algorithm (in inter-system clock bias estimation).&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;</string>
                                </property>
                                <property name="styleSheet">
                                 <string notr="true">color: rgb(0, 0, 0);</string>
                                </property>
                                <property name="text">
                                 <string>White Noise</string>
                                </property>
                               </widget>
                              </item>
                              <item row="0" column="8">
                               <widget class="QRadioButton" name="radioButtonRandomwalkISCB">
                                <property name="minimumSize">
                                 <size>
                                  <width>105</width>
                                  <height>0</height>
                                 </size>
                                </property>
                                <property name="maximumSize">
                                 <size>
                                  <width>105</width>
                                  <height>16777215</height>
                                 </size>
                                </property>
                                <property name="toolTip">
                                 <string>&lt;b&gt;Random Walk&lt;/b&gt;&lt;br&gt;&lt;br&gt;Select this option to perform a processing supposing that the inter-system clock biases drift slowly, so the filter can keep some inter-system clock biases correlation between epochs. In order for random walk to make a difference with respect to white noise, the clock drift (set by process noise) must be small.&lt;br&gt;This modifies the filter parameters &lt;b&gt;Phi&lt;/b&gt; (propagation) and &lt;b&gt;Q&lt;/b&gt; (process noise) for the inter-system clock biases estimation to:&lt;ul&gt;&lt;li&gt;Phi = 1&lt;/li&gt;&lt;li&gt;Q = 9 m&lt;sup&gt;2&lt;/sup&gt;/day&lt;/li&gt;&lt;/ul&gt;&lt;b&gt;NOTE:&lt;/b&gt; Units for process noise (&lt;b&gt;Q&lt;/b&gt;) are changed from m&lt;sup&gt;2&lt;/sup&gt; to m&lt;sup&gt;2&lt;/sup&gt;/day in order to be dependent on time.&lt;br&gt;</string>
                                </property>
                                <property name="styleSheet">
                                 <string notr="true">color: rgb(0, 0, 0);
</string>
                                </property>
                                <property name="text">
                                 <string>Random Walk</string>
                                </property>
                               </widget>
                              </item>
                             </layout>
                            </widget>
                           </item>
                          </layout>
                         </widget>
                        </item>
