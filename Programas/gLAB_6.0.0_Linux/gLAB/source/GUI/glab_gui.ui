                                       <item row="0" column="0">
                                        <widget class="QComboBox" name="comboBoxDcbSourcePPP">
                                         <property name="sizePolicy">
                                          <sizepolicy hsizetype="Minimum" vsizetype="Fixed">
                                           <horstretch>0</horstretch>
                                           <verstretch>0</verstretch>
                                          </sizepolicy>
                                         </property>
                                         <property name="minimumSize">
                                          <size>
                                           <width>220</width>
                                           <height>0</height>
                                          </size>
                                         </property>
                                         <property name="focusPolicy">
                                          <enum>Qt::StrongFocus</enum>
                                         </property>
                                         <property name="toolTip">
                                          <string>&lt;b&gt;DCB Source types:&lt;/b&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;Broadcast (specify):&lt;/b&gt; A RINEX navigation file for reading DCB data.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Precise .DCB file:&lt;/b&gt; A precise .DCB file where an accurate estimation of the (P1-P2) bias (for GPS and GLONASS only) is provided.&lt;/li&gt;&lt;li&gt;&lt;b&gt;IONEX (same as ionosphere):&lt;/b&gt; Use the same IONEX file provided for ionosphere correction (in the &lt;i&gt;Ionosphere Source&lt;/i&gt; section above). The DCB are provided in the header of the IONEX file.&lt;/li&gt;&lt;li&gt;&lt;b&gt;IONEX (specify):&lt;/b&gt; Provide an additional IONEX for reading DCB data.&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;</string>
                                         </property>
                                         <item>
                                          <property name="text">
                                           <string>Broadcast (specify)</string>
                                          </property>
                                         </item>
                                         <item>
                                          <property name="text">
                                           <string>Precise .DCB file</string>
                                          </property>
                                         </item>
                                         <item>
                                          <property name="text">
                                           <string>IONEX (same as ionosphere)</string>
                                          </property>
                                         </item>
                                         <item>
                                          <property name="text">
                                           <string>IONEX (specify)</string>
                                          </property>
                                         </item>
                                        </widget>
                                       </item>
                                      </layout>
                                     </widget>
                                    </widget>
                                   </item>
                                   <item row="0" column="2">
                                    <spacer name="horizontalSpacer_3">
                                     <property name="orientation">
                                      <enum>Qt::Horizontal</enum>
                                     </property>
                                     <property name="sizeHint" stdset="0">
                                      <size>
                                       <width>140</width>
                                       <height>20</height>
                                      </size>
                                     </property>
                                    </spacer>
                                   </item>
                                   <item row="0" column="0">
                                    <widget class="QLabel" name="label_9">
                                     <property name="toolTip">
                                      <string>&lt;b&gt;DCB Source: &lt;/b&gt;&lt;br&gt;&lt;br&gt;Depending on the Differential Code Bias (&lt;b&gt;DCB&lt;/b&gt;) corrections source, three different files can be upload here:&lt;ul &gt;&lt;li &gt;A &lt;b&gt;RINEX Navigation&lt;/b&gt; file where the bias correction (different for each constellation) is provided in the navigation message as the Total Group Delay (&lt;b&gt;TGD&lt;/b&gt;) (usually located in the the 7&lt;sup&gt;th&lt;/sup&gt; row of the broadcast ephemerides). This estimation is generated by the Control Segment that monitorises all satellites.&lt;br&gt;RINEX navigation files can be found in the links provided in the following menu:&lt;br&gt;&lt;font style=&quot; color:#0000ff;&quot;&gt;Help-&amp;gt;Download data files-&amp;gt;RINEX Navigation Files&lt;/font&gt;&lt;/li&gt;&lt;li &gt;A &lt;b&gt;Precise .DCB&lt;/b&gt; file where an accurate estimation of the (P1-P2) bias (for GPS and GLONASS only) is provided. This file contains a monthly estimation of the (P1-P2) Differential Code Bias (&lt;b&gt;DCB&lt;/b&gt;) for all GPS/GLONASS Satellites. These DCB files can be found in the links provided in the following menu:&lt;br/&gt;&lt;font style=&quot; color:#0000ff;&quot;&gt;Help-&amp;gt;Download data files-&amp;gt;Other Files&lt;/font&gt;&lt;/li&gt;&lt;li&gt;A &lt;b&gt;IONEX&lt;/b&gt; file where the (P2-P1) bias (for GPS and GLONASS only) are given in the &lt;b&gt;PRN / BIAS / RMS&lt;/b&gt; header lines. IONEX files can be found in the links provided in the following menu:&lt;br&gt;&lt;font style=&quot; color:#0000ff;&quot;&gt;Help-&amp;gt;Download data files-&amp;gt;Other Files&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;br&gt;&lt;font style=&quot;color:#c00000;&quot;&gt;About TGDs &amp;amp; DCBs:&lt;/font&gt;&lt;br&gt;&lt;br&gt;The relation between the DCBs of the precise files and the TGDs broadcast in the GPS navigation message is:&lt;br&gt;&lt;br&gt;TGD&lt;sub&gt;GPS Broadcast Message&lt;/sub&gt; = -&amp;alpha;&lt;sub&gt;1&lt;/sub&gt; / ( &amp;alpha;&lt;sub&gt;2&lt;/sub&gt; - &amp;alpha;&lt;sub&gt;1&lt;/sub&gt; ) · DCB&lt;sub&gt;File&lt;/sub&gt;&lt;br&gt;&lt;br&gt;Where &amp;alpha;&lt;sub&gt;i&lt;/sub&gt; = 40.3 / f&lt;sub&gt;i&lt;/sub&gt;&lt;sup&gt;2&lt;/sup&gt;&lt;br&gt;</string>
                                     </property>
                                     <property name="styleSheet">
                                      <string notr="true">color: rgb(0, 0, 0);</string>
                                     </property>
