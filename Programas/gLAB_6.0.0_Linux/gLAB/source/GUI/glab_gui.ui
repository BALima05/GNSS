                           <item row="0" column="0">
                            <widget class="QFrame" name="frame_51">
                             <property name="frameShape">
                              <enum>QFrame::NoFrame</enum>
                             </property>
                             <property name="frameShadow">
                              <enum>QFrame::Raised</enum>
                             </property>
                             <layout class="QGridLayout" name="gridLayout_231">
                              <property name="leftMargin">
                               <number>0</number>
                              </property>
                              <property name="topMargin">
                               <number>0</number>
                              </property>
                              <property name="rightMargin">
                               <number>0</number>
                              </property>
                              <property name="bottomMargin">
                               <number>0</number>
                              </property>
                              <property name="verticalSpacing">
                               <number>3</number>
                              </property>
                              <item row="0" column="1">
                               <widget class="QRadioButton" name="radioButtonSmoothing">
                                <property name="minimumSize">
                                 <size>
                                  <width>0</width>
                                  <height>0</height>
                                 </size>
                                </property>
                                <property name="font">
                                 <font>
                                  <weight>50</weight>
                                  <bold>false</bold>
                                 </font>
                                </property>
                                <property name="toolTip">
                                 <string>&lt;b&gt;Pseudorange smoothing&lt;/b&gt;&lt;br&gt;&lt;br&gt;Use the Hatch filter to smooth the pseudorange measurements with carrier phase measurements. This option will decrease the noise of the measurements included in the filter. This should only be activated when processing with pseudorange only (no carrier phase), as the carrier phase is better included in the filter in that other way better than using smoothing. The use of smoothing allows to enhance the pseudorange without the cost of the increased filter complexity for carrier phase ambiguities estimations.&lt;br&gt;The Hatch filter is defined as:&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;P&lt;fint size=&quot;-2&quot;&gt;i&lt;/font&gt;&lt;font size=&quot;-3&quot;&gt;smoothed&lt;/font&gt; = mean(P-L)&lt;font size=&quot;-2&quot;&gt;i&lt;/font&gt; + L&lt;font size=&quot;-2&quot;&gt;i&lt;/font&gt;&lt;br&gt;&lt;br&gt;Being the mean() a function that computes the mean of pseudorange and carrier phase measurements. This mean at epoch &lt;i&gt;i&lt;/i&gt; is obtained from:&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;mean(P-L)&lt;font size=&quot;-2&quot;&gt;i&lt;/font&gt; = ((n-1)*mean(P-L)&lt;font size=&quot;-2&quot;&gt;i-1&lt;/font&gt; + (P-L)&lt;font size=&quot;-2&quot;&gt;i&lt;/font&gt;)/n&lt;br&gt;&lt;br&gt;Being &lt;i&gt;n&lt;/i&gt; the arc length at epoch &lt;i&gt;i&lt;/i&gt; limited to a maximum value. This limitation is to avoid problems with ionospheric divergence between pseudorange and carrier phase measurements. If both measurements do not have ionospheric divergence (i.e. pseudorange and carrier phase iono-free combination and any single frequency pseudorange smoothed with a divergence-free combination), the parameter can be as high as desired (see &lt;font color=&quot;#0000FF&quot;&gt;https://gssc.esa.int/navipedia/index.php/Code-Carrier_Divergence_Effect&lt;/font&gt; for details about ionosphere divergence).&lt;br&gt;&lt;br&gt;The smoothing window in terms of time is the multiplication of the smoothing samples (selected with this parameter) by the data interval of the RINEX file. When smoothing data separated more than about 300 seconds will be affected from ionospheric divergence. In this case good values for smoothing are 100 samples for 1 second data rate, and 3 samples for 30 seconds data rate.&lt;br&gt;</string>
                                </property>
                                <property name="styleSheet">
                                 <string notr="true">color: rgb(0, 0, 0);</string>
                                </property>
                                <property name="text">
                                 <string>Pseudorange Smoothing</string>
                                </property>
                               </widget>
                              </item>
                              <item row="0" column="4">
                               <spacer name="horizontalSpacer_22">
                                <property name="orientation">
                                 <enum>Qt::Horizontal</enum>
                                </property>
                                <property name="sizeHint" stdset="0">
                                 <size>
                                  <width>40</width>
                                  <height>20</height>
                                 </size>
                                </property>
                               </spacer>
                              </item>
                              <item row="0" column="3">
                               <widget class="QRadioButton" name="radioButtonSelectionGraphic">
                                <property name="toolTip">
                                 <string>&lt;b&gt;Graphic Combination&lt;/b&gt;&lt;br&gt;&lt;br&gt;Use a Graphic Combination (GC) in the filter. This single frequency combination removes the ionosphere and has the pseudorange code noise halved.&lt;br&gt;It is obtained with the following formula:&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;GC = (&lt;i&gt;Pseudorange&lt;/i&gt; + &lt;i&gt;Carrier_phase&lt;/i&gt;)/2&lt;br&gt;</string>
                                </property>
                                <property name="styleSheet">
                                 <string notr="true">color: rgb(0, 0, 0);</string>
                                </property>
                                <property name="text">
                                 <string>Graphic Combination</string>
                                </property>
                               </widget>
                              </item>
                              <item row="0" column="0">
                               <widget class="QRadioButton" name="radioButtonSelectionPseudorange">
                                <property name="minimumSize">
                                 <size>
                                  <width>0</width>
                                  <height>0</height>
                                 </size>
                                </property>
                                <property name="font">
                                 <font>
                                  <weight>50</weight>
                                  <bold>false</bold>
                                 </font>
                                </property>
                                <property name="toolTip">
                                 <string>&lt;b&gt;Pseudorange measurements&lt;/b&gt;&lt;br&gt;&lt;br&gt;Use only pseudorange measurements for the processing. The ambiguity estimation in the filter will be disconnected with this option set.&lt;br&gt;</string>
                                </property>
                                <property name="styleSheet">
                                 <string notr="true">color: rgb(0, 0, 0);</string>
                                </property>
                                <property name="text">
                                 <string>Pseudorange</string>
                                </property>
                                <property name="checked">
                                 <bool>true</bool>
                                </property>
                               </widget>
                              </item>
                              <item row="0" column="2">
