                                   <item row="1" column="0" colspan="2">
                                    <widget class="QCheckBox" name="checkBoxUserAddedErrorAfterPrepocessing">
                                     <property name="toolTip">
                                      <string>&lt;b&gt;Insert User Added Error after preprocessing:&lt;/b&gt;&lt;br&gt;&lt;br&gt;If &lt;b&gt;unchecked&lt;/b&gt;, added error values will be added to measurements just after reading the observation file, affecting all steps of measurements processing.&lt;br&gt;If &lt;b&gt;checked&lt;/b&gt;, added error values will be added to measurements after the preprocessing, therefore, the preprocessing steps (code jumps detection, cycle-slip detection and smoothing) will not be affected by the added error values.&lt;br&gt;</string>
                                     </property>
