                                        <item row="0" column="12">
                                         <widget class="QLineEdit" name="lineEditStdDevPhaseAGLONASS_3">
                                          <property name="maximumSize">
                                           <size>
                                            <width>55</width>
                                            <height>16777215</height>
                                           </size>
                                          </property>
