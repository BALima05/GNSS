                           <item row="0" column="1">
                            <widget class="QLabel" name="label_79">
                             <property name="font">
                              <font>
                               <weight>50</weight>
                               <bold>false</bold>
                              </font>
                             </property>
                             <property name="toolTip">
                              <string>&lt;b&gt;Phi &lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Phi&lt;/b&gt; sets the propagation of parameters between epochs. '1' means that the value estimated in the epoch &lt;i&gt;i+1&lt;/i&gt; is used as a priori value in the epoch &lt;i&gt;i&lt;/i&gt;, '0', means that the a priori value is always '0'.&lt;br&gt;</string>
                             </property>
                             <property name="styleSheet">
                              <string notr="true">color: rgb(0, 0, 0);</string>
                             </property>
                             <property name="text">
                              <string>Phi</string>
                             </property>
                             <property name="alignment">
                              <set>Qt::AlignCenter</set>
                             </property>
                            </widget>
                           </item>
                           <item row="2" column="6">
                            <widget class="QFrame" name="frame_49">
                             <property name="frameShape">
                              <enum>QFrame::NoFrame</enum>
                             </property>
                             <property name="frameShadow">
                              <enum>QFrame::Raised</enum>
                             </property>
                             <layout class="QGridLayout" name="gridLayout_595">
                              <property name="leftMargin">
                               <number>0</number>
                              </property>
                              <property name="topMargin">
                               <number>0</number>
                              </property>
                              <property name="rightMargin">
                               <number>0</number>
                              </property>
                              <property name="bottomMargin">
                               <number>0</number>
                              </property>
                              <property name="verticalSpacing">
                               <number>0</number>
                              </property>
                              <item row="0" column="0">
                               <widget class="QRadioButton" name="radioButtonConstantClock">
                                <property name="minimumSize">
                                 <size>
                                  <width>73</width>
                                  <height>0</height>
                                 </size>
                                </property>
                                <property name="maximumSize">
                                 <size>
                                  <width>73</width>
                                  <height>16777215</height>
                                 </size>
                                </property>
                                <property name="toolTip">
                                 <string>&lt;b&gt;Constant&lt;/b&gt;&lt;br&gt;&lt;br&gt;Select this option to perform a processing supposing that the receiver clock does not drift (e.g. ideal clock), so clock correlation between epochs is maintained.&lt;br&gt;This modifies the filter parameters &lt;b&gt;Phi&lt;/b&gt; (propagation) and &lt;b&gt;Q&lt;/b&gt; (process noise) for the receiver clock estimation to:&lt;ul&gt;&lt;li&gt;Phi = 1&lt;/li&gt;&lt;li&gt;Q =  0 m&lt;sup&gt;2&lt;/sup&gt;&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;</string>
                                </property>
                                <property name="styleSheet">
                                 <string notr="true">color: rgb(0, 0, 0);</string>
                                </property>
                                <property name="text">
                                 <string>Constant</string>
                                </property>
                               </widget>
                              </item>
                              <item row="0" column="1">
                               <widget class="QRadioButton" name="radioButtonWhiteNoiseClock">
                                <property name="minimumSize">
                                 <size>
                                  <width>93</width>
                                  <height>0</height>
                                 </size>
                                </property>
                                <property name="maximumSize">
                                 <size>
                                  <width>93</width>
                                  <height>16777215</height>
                                 </size>
                                </property>
                                <property name="toolTip">
                                 <string>&lt;b&gt;White noise&lt;/b&gt;&lt;br&gt;&lt;br&gt;Select this option to perform a processing supposing that the receiver clock drift is unprecitable (e.g. non atomic clocks), so there is no clock correlation between epochs.&lt;br&gt;This modifies the filter parameters &lt;b&gt;Phi&lt;/b&gt; (propagation) and &lt;b&gt;Q&lt;/b&gt; (process noise) for the receiver clock estimation to:&lt;ul&gt;&lt;li&gt;Phi = 0&lt;/li&gt;&lt;li&gt;Q =  9·10&lt;sup&gt;10&lt;/sup&gt; m&lt;sup&gt;2&lt;/sup&gt;&lt;/li&gt;&lt;/ul&gt;&lt;b&gt;NOTES:&lt;/b&gt;&lt;ul&gt;&lt;li&gt;When loading a configuration file and no Q value for the receiver clock is provided or Q!=0, this option will be set as it is the default one. This is due to that the command line has no notion of &lt;i&gt;constant&lt;/i&gt; or &lt;i&gt;White noise&lt;/i&gt;, as it just sets the value of Q accordingly (therefore there is no parameter to set this option directly).&lt;/li&gt;&lt;li&gt;Setting the receiver clock to a &lt;i&gt;White Noise&lt;/i&gt; behaviour makes the Kalman filter to behave as a Weighted Least Square (WLS) algorithm (in receiver clock estimation).&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;</string>
                                </property>
                                <property name="styleSheet">
                                 <string notr="true">color: rgb(0, 0, 0);</string>
                                </property>
                                <property name="text">
                                 <string>White Noise</string>
                                </property>
                               </widget>
                              </item>
                              <item row="0" column="2">
                               <widget class="QRadioButton" name="radioButtonRandomwalkClock">
                                <property name="minimumSize">
                                 <size>
                                  <width>105</width>
                                  <height>0</height>
                                 </size>
                                </property>
                                <property name="maximumSize">
                                 <size>
                                  <width>105</width>
                                  <height>16777215</height>
                                 </size>
                                </property>
                                <property name="toolTip">
                                 <string>&lt;b&gt;Random Walk&lt;/b&gt;&lt;br&gt;&lt;br&gt;Select this option to perform a processing supposing that the receiver clock drifts slowly (e.g. atomic clocks), so the filter can keep some clock correlation between epochs. In order for random walk to make a difference with respect to white noise, the clock drift (set by process noise) must be small.&lt;br&gt;This modifies the filter parameters &lt;b&gt;Phi&lt;/b&gt; (propagation) and &lt;b&gt;Q&lt;/b&gt; (process noise) for the receiver clock estimation to:&lt;ul&gt;&lt;li&gt;Phi = 1&lt;/li&gt;&lt;li&gt;Q = 9 m&lt;sup&gt;2&lt;/sup&gt;/day&lt;/li&gt;&lt;/ul&gt;&lt;b&gt;NOTE:&lt;/b&gt; Units for process noise (&lt;b&gt;Q&lt;/b&gt;) are changed from m&lt;sup&gt;2&lt;/sup&gt; to m&lt;sup&gt;2&lt;/sup&gt;/day in order to be dependent on time.&lt;br&gt;</string>
                                </property>
                                <property name="styleSheet">
                                 <string notr="true">color: rgb(0, 0, 0);</string>
                                </property>
                                <property name="text">
                                 <string>Random Walk</string>
                                </property>
                               </widget>
                              </item>
                             </layout>
                            </widget>
                           </item>
