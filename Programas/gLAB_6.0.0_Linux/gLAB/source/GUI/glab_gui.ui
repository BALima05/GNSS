                                 <number>0</number>
                                </property>
                                <item row="0" column="0">
                                 <widget class="QLabel" name="label_249">
                                  <property name="toolTip">
                                   <string>&lt;b&gt;Sigma offset if MT10 is not used:&lt;/b&gt;&lt;br&gt;&lt;br&gt;If message type 10 is not available (in NPA mode only), or is disabled with the option &lt;i&gt;Disable Message Type 10 (Degradation parameters&lt;/i&gt;), the fast and long term corrections degradation is computed with the following formula:&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;sigma;&lt;sup&gt;2&lt;/sup&gt;&lt;sub&gt;flt&lt;/sub&gt; = ( &amp;sigma;&lt;sub&gt;UDRE&lt;/sub&gt;·&amp;delta;UDRE +8 )&lt;sup&gt;2&lt;/sup&gt;&lt;br&gt;&lt;br&gt;With this option, the fixed offset '8' in the formula above can be changed to any value.&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTES:&lt;/b&gt;&lt;ul&gt;&lt;li&gt;All units for all elements in the formulas above are in metres (except for &amp;delta;UDRE, which is adimensional)&lt;/li&gt;&lt;li&gt;See MOPS for details on how to compute the degradation terms.&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;</string>
                                  </property>
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>Sigma offset if MT10 is not used:</string>
                                  </property>
                                 </widget>
                                </item>
                                <item row="0" column="1">
                                 <widget class="QLineEdit" name="lineEditOffsetFastCorrNoMT10">
                                  <property name="sizePolicy">
                                   <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
