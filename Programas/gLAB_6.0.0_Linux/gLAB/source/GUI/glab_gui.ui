                                         <widget class="QLabel" name="label_328">
                                          <property name="toolTip">
                                           <string>&lt;b&gt;Phase:&lt;/b&gt;&lt;br&gt;&lt;br&gt;Set the carrier phase measurement for the first GEO graphical combination (GC) in the filter. &lt;br&gt;&lt;br&gt;&lt;b&gt;NOTE:&lt;/b&gt; If it is set to &lt;i&gt;Auto&lt;/i&gt;, gLAB will automatically select them according to the measurement order (see option &lt;i&gt;Set GNSS Frequencies and Measurements Order&lt;/i&gt; above) and the available ones in the RINEX observation file.&lt;br&gt;</string>
                                          </property>
                                          <property name="styleSheet">
                                           <string notr="true">color: rgb(0, 0, 0);</string>
                                          </property>
                                          <property name="text">
                                           <string>Phase:</string>
                                          </property>
                                         </widget>
                                        </item>
                                        <item row="0" column="5">
                                         <widget class="QComboBox" name="comboBoxMeasGCPhaseGEO_1">
                                          <property name="minimumSize">
                                           <size>
                                            <width>65</width>
                                            <height>0</height>
                                           </size>
                                          </property>
                                          <property name="maximumSize">
                                           <size>
                                            <width>75</width>
                                            <height>16777215</height>
                                           </size>
                                          </property>
                                          <property name="focusPolicy">
