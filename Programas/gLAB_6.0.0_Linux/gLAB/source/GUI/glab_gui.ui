                                  <widget class="QLabel" name="label_148">
                                   <property name="toolTip">
                                    <string>&lt;b&gt;Samples:&lt;/b&gt;&lt;br&gt;&lt;br&gt;Set the size of the sliding window (in epochs) for smoothing. &lt;br&gt;&lt;br&gt;&lt;b&gt;NOTE:&lt;/b&gt; With single frequency measurements, it is not recommended to use a sliding windows greater than 100 seconds (100 epochs at 1Hz or 3 epochs with a 30 second file) due to the ionosphere divergence (except when smoothing with a Divergence-Free measurement).&lt;br&gt;</string>
                                   </property>
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
