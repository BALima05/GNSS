                                 <number>0</number>
                                </property>
                                <item row="0" column="0">
                                 <widget class="QCheckBox" name="checkBoxDisableMT10">
                                  <property name="toolTip">
                                   <string>&lt;b&gt;Disable Message Type 10 (Degradation parameters)&lt;/b&gt;&lt;br&gt;&lt;br&gt; In nominal conditions, message type 10 is necessary for computing degradation parameters in PA navigation mode. If this message is not available, no SBAS correction can be computed in PA navigation mode (in NPA are not compulsory). If this option is enabled, message type 10 will be ignored and SBAS correction will be computed even in PA mode, but the sigma for the fast and slow correction will be affected (read &lt;i&gt;Degradation Parameters&lt;/i&gt; tooltip for details).&lt;br&gt;</string>
                                  </property>
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>Disable Message Type 10 (Degradation parameters)</string>
                                  </property>
                                 </widget>
                                </item>
                                <item row="1" column="0">
                                 <widget class="QCheckBox" name="checkBoxDisableMT2728">
                                  <property name="toolTip">
                                   <string>&lt;b&gt;Disable Messages Type 27 and 28 (δUDRE value)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Messages Type 27 and 28 are used for δUDRE computation (see &lt;i&gt;Service Message&lt;/i&gt; and &lt;i&gt;Clock Ephemeris Covariance Matrix&lt;/i&gt; tooltips for details). If this option is enabled, these messages will be ignored and the δUDRE will be set to 1.&lt;br&gt;</string>
                                  </property>
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>Disable Messages Type 27 and 28 (δUDRE value)</string>
                                  </property>
                                 </widget>
                                </item>
                               </layout>
                              </widget>
                             </item>
                            </layout>
                           </widget>
                          </item>
                          <item row="2" column="0">
                           <widget class="QCheckBox" name="checkBoxIgnoreAllAlarm">
                            <property name="toolTip">
                             <string>&lt;b&gt;Ignore All Alarm Messages&lt;/b&gt;&lt;br&gt;&lt;br&gt;If this option is enabled, alarm messages (message type 0) will be skipped. Therefore, no alarms will be triggered.&lt;br&gt;</string>
                            </property>
                            <property name="styleSheet">
                             <string notr="true">color: rgb(0, 0, 0);</string>
                            </property>
                            <property name="text">
                             <string>Ignore All Alarm Messages</string>
                            </property>
                           </widget>
                          </item>
