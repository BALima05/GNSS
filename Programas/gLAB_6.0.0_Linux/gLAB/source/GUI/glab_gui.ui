                                <item row="3" column="2">
                                 <widget class="QLabel" name="label_310">
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>(adimensional)</string>
                                  </property>
                                 </widget>
                                </item>
                                <item row="1" column="1">
                                 <widget class="QLineEdit" name="lineEditkvpa">
                                  <property name="clearButtonEnabled">
                                   <bool>true</bool>
                                  </property>
                                 </widget>
                                </item>
                                <item row="0" column="2">
                                 <widget class="QLabel" name="label_307">
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>(adimensional)</string>
                                  </property>
                                 </widget>
                                </item>
                                <item row="2" column="1">
                                 <widget class="QLineEdit" name="lineEditkhnpa">
                                  <property name="clearButtonEnabled">
                                   <bool>true</bool>
                                  </property>
                                 </widget>
                                </item>
                                <item row="0" column="0">
                                 <widget class="QLabel" name="labelkhpa">
                                  <property name="toolTip">
                                   <string>&lt;b&gt;K&lt;sub&gt;H&lt;/sub&gt; PA&lt;/b&gt;&lt;br&gt;&lt;br&gt;The horizontal protection level is computed with the following formula:&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;K · d&lt;sub&gt;major&lt;/sub&gt;&lt;br&gt;&lt;br&gt; d&lt;sub&gt;major&lt;/sub&gt; corresponds to the semimajor axis of the error ellipse, and is obtained using a formula from Appendix J in MOPS-D for SBAS 1F (or Appendix E in ED-259 for SBAS DFMC), which uses values computed from the matrix (GWG)&lt;sup&gt;-1&lt;/sup&gt;.&lt;br&gt;&lt;br&gt;K is the factor for bounding the error with a given probability, which is fixed in both Appendix J of MOPS-D for SBAS 1F and Appendix E in ED-259 for SBAS DFMC. The value is dependent on the navigation mode (PA or NPA). The default K factor for the horizontal component in PA mode is 6 (assuming a Normal distribution in one dimension, it corresponds to a probability of 2·10&lt;sup&gt;-9&lt;/sup&gt;).&lt;br&gt;</string>
                                  </property>
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>K&lt;sub&gt;H&lt;/sub&gt; PA</string>
                                  </property>
                                 </widget>
                                </item>
                                <item row="0" column="1">
                                 <widget class="QLineEdit" name="lineEditkhpa">
                                  <property name="clearButtonEnabled">
                                   <bool>true</bool>
                                  </property>
                                 </widget>
                                </item>
                                <item row="3" column="0">
                                 <widget class="QLabel" name="labelkvnpa">
                                  <property name="toolTip">
                                   <string>&lt;b&gt;K&lt;sub&gt;V&lt;/sub&gt; NPA&lt;/b&gt;&lt;br&gt;&lt;br&gt;The vertical protection level is computed with the following formula:&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;K · d&lt;sub&gt;U&lt;/sub&gt;&lt;br&gt;&lt;br&gt; d&lt;sub&gt;U&lt;/sub&gt; corresponds to the error in the UP component, and is obtained using a formula from Appendix J in MOPS-D (or Appendix E in ED-259 for SBAS DFMC), obtained from the matrix (GWG)&lt;sup&gt;-1&lt;/sup&gt;.&lt;br&gt;&lt;br&gt;K is the factor for bounding the error with a given probability, which is fixed in Appendix J of MOPS-D for SBAS 1F and Appendix E in ED-259 for SBAS DFMC. The value is dependent on the navigation mode (PA or NPA). The default K factor for the vertical component in PA mode is 5.33 (assuming a Normal distribution in one dimension, it corresponds to a probability of 1·10&lt;sup&gt;-7&lt;/sup&gt;).&lt;br&gt;</string>
                                  </property>
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>K&lt;sub&gt;V&lt;/sub&gt; NPA</string>
                                  </property>
                                 </widget>
                                </item>
                                <item row="3" column="1">
                                 <widget class="QLineEdit" name="lineEditkvnpa">
                                  <property name="clearButtonEnabled">
                                   <bool>true</bool>
                                  </property>
                                 </widget>
                                </item>
                                <item row="2" column="0">
                                 <widget class="QLabel" name="labelkhnpa">
                                  <property name="toolTip">
                                   <string>&lt;b&gt;K&lt;sub&gt;H&lt;/sub&gt; NPA&lt;/b&gt;&lt;br&gt;&lt;br&gt;The horizontal protection level is computed with the following formula:&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;K · d&lt;sub&gt;major&lt;/sub&gt;&lt;br&gt;&lt;br&gt; d&lt;sub&gt;major&lt;/sub&gt; corresponds to the semimajor axis of the error ellipse, and is obtained using a formula from Appendix J in MOPS-D (or Appendix E in ED-259 for SBAS DFMC), which uses values computed from the matrix (GWG)&lt;sup&gt;-1&lt;/sup&gt;.&lt;br&gt;&lt;br&gt;K is the factor for bounding the error with a given probability, which is fixed in Appendix J of MOPS-D for SBAS 1F and Appendix E in ED-259 for SBAS DFMC. The value is dependent on the navigation mode (PA or NPA). The default K factor for the horizontal component in NPA mode is 6.18 (assuming a Rayleigh distribution in two dimensions, it corresponds to a probability of 5·10&lt;sup&gt;-9&lt;/sup&gt;).&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTE:&lt;/b&gt; The assumption of Rayleigh distribution in two dimensions and the probability of 5·10&lt;sup&gt;-9&lt;/sup&gt; is detailed in MOPS-C.&lt;br&gt;</string>
                                  </property>
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>K&lt;sub&gt;H&lt;/sub&gt; NPA</string>
                                  </property>
                                 </widget>
                                </item>
                                <item row="1" column="2">
                                 <widget class="QLabel" name="label_308">
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>(adimensional)</string>
                                  </property>
                                 </widget>
                                </item>
                                <item row="1" column="0">
                                 <widget class="QLabel" name="labelkvpa">
                                  <property name="toolTip">
                                   <string>&lt;b&gt;K&lt;sub&gt;V&lt;/sub&gt; PA&lt;/b&gt;&lt;br&gt;&lt;br&gt;The vertical protection level is computed with the following formula:&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;K · d&lt;sub&gt;U&lt;/sub&gt;&lt;br&gt;&lt;br&gt; d&lt;sub&gt;U&lt;/sub&gt; corresponds to the error in the UP component, and is obtained using a formula from Appendix J in MOPS-D (or Appendix E in ED-259 for SBAS DFMC), obtained from the matrix (GWG)&lt;sup&gt;-1&lt;/sup&gt;.&lt;br&gt;&lt;br&gt;K is the factor for bounding the error with a given probability, which is fixed in Appendix J of MOPS-D for SBAS 1F and Appendix E in ED-259 for SBAS DFMC. The value is dependent on the navigation mode (PA or NPA). The default K factor for the vertical component in PA mode is 5.33 (assuming a Normal distribution in one dimension, it corresponds to a probability of 1·10&lt;sup&gt;-7&lt;/sup&gt;).&lt;br&gt;</string>
                                  </property>
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>K&lt;sub&gt;V&lt;/sub&gt; PA</string>
                                  </property>
                                 </widget>
                                </item>
                                <item row="2" column="3">
                                 <spacer name="horizontalSpacer_81">
                                  <property name="orientation">
                                   <enum>Qt::Horizontal</enum>
                                  </property>
                                  <property name="sizeHint" stdset="0">
                                   <size>
                                    <width>0</width>
                                    <height>20</height>
                                   </size>
                                  </property>
                                 </spacer>
                                </item>
                               </layout>
                              </widget>
                             </item>
                            </layout>
                           </widget>
                          </item>
                          <item row="0" column="0">
                           <widget class="QCheckBox" name="checkBoxParseAlarmSBAS1F">
                            <property name="toolTip">
                             <string>&lt;b&gt;Parse Alarm Message as Type 2 Message&lt;/b&gt;&lt;br&gt;&lt;br&gt;In GEOs in test mode, alarm messages (message type 0) may also contain the same data as message type 2 (fast corrections), although the integrity of the corrections are not guaranteed.&lt;br&gt;&lt;br&gt;If this option is enabled, Alarm messages will read as a fast correction (no alarm is triggered), except for the case that the message is filled with zeros,  where MOPS states that in this case it must be treated as an alarm message.&lt;br&gt;</string>
                            </property>
                            <property name="styleSheet">
                             <string notr="true">color: rgb(0, 0, 0);</string>
                            </property>
                            <property name="text">
                             <string>Parse Alarm Message as Type 2 Message</string>
                            </property>
                           </widget>
                          </item>
                          <item row="10" column="0">
                           <widget class="QGroupBox" name="groupBoxGEOandSwitchOptions">
                            <property name="font">
                             <font>
                              <pointsize>9</pointsize>
                              <weight>75</weight>
                              <bold>true</bold>
                             </font>
                            </property>
                            <property name="title">
                             <string>GEO &amp;&amp; Mode Switch Options</string>
                            </property>
                            <layout class="QGridLayout" name="gridLayout_132">
                             <property name="verticalSpacing">
                              <number>3</number>
                             </property>
                             <item row="3" column="0">
                              <widget class="QLabel" name="label_136">
                               <property name="toolTip">
                                <string>&lt;b&gt;Switching Cool time:&lt;/b&gt;&lt;br&gt;&lt;br&gt; Each time a GEO or mode switch is triggered, gLAB will not try another GEO or mode switch after the switching cool time has expired. This to avoid constant switches during consecutive epochs, and also to permit the current (or previous) GEO used to gather more messages, so in the following mode or GEO switch there are higher possibility that a navigation solution can be computed after doing the switch.&lt;br&gt;In other words, the switching cool time is the countdown between consecutive GEO or mode switches in order to allow the GEO data to be updated.&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTES:&lt;/b&gt;&lt;ul&gt;&lt;li&gt; If switching cooldown is set to 0, a maximum of fifty switches (counting both GEO and navigation mode) per epoch will be allowed during one epoch, in order to prevent infinite loops.&lt;/li&gt;&lt;li&gt;If option 'Select Best GEO' is enabled, this option will automatically be set to 0, as in one epoch there will be multiple GEO changes.&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;</string>
                               </property>
                               <property name="styleSheet">
                                <string notr="true">color: rgb(0, 0, 0);</string>
                               </property>
                               <property name="text">
                                <string>Switching Cool time:</string>
                               </property>
                              </widget>
                             </item>
                             <item row="1" column="0">
                              <widget class="QCheckBox" name="checkBoxReturnToInitialGEO">
                               <property name="toolTip">
                                <string>&lt;b&gt;Return to Initial GEO&lt;/b&gt;&lt;br&gt;&lt;br&gt;After a successful GEO switch, if this option is enabled, gLAB will try to switch to the initial GEO after the switching cool time has expired. If it is not possible, it will keep trying every time the switching cool time has expired.&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTE:&lt;/b&gt; If both options &lt;i&gt;Return to Initial GEO&lt;/i&gt; and &lt;i&gt;After GEO Switch, Maintain the New Selected GEO&lt;/i&gt; are enabled, the first one will prevail (in the GUI these options are exclusive, but in command line both options can be enabled).&lt;br&gt;</string>
                               </property>
                               <property name="styleSheet">
                                <string notr="true">color: rgb(0, 0, 0);</string>
                               </property>
                               <property name="text">
                                <string>Return to Initial GEO</string>
                               </property>
                              </widget>
                             </item>
                             <item row="3" column="2">
                              <widget class="QFrame" name="frameSwitchinCooltime">
                               <property name="frameShape">
                                <enum>QFrame::NoFrame</enum>
                               </property>
                               <property name="frameShadow">
                                <enum>QFrame::Raised</enum>
                               </property>
                               <layout class="QGridLayout" name="gridLayout_134">
                                <property name="leftMargin">
                                 <number>0</number>
                                </property>
                                <property name="topMargin">
                                 <number>0</number>
                                </property>
                                <property name="rightMargin">
                                 <number>0</number>
                                </property>
                                <property name="bottomMargin">
                                 <number>0</number>
                                </property>
                                <property name="verticalSpacing">
                                 <number>0</number>
                                </property>
                                <item row="0" column="0">
                                 <widget class="QLineEdit" name="lineEditSwitchinCooltime">
                                  <property name="clearButtonEnabled">
                                   <bool>true</bool>
                                  </property>
                                 </widget>
                                </item>
                                <item row="0" column="2">
                                 <spacer name="horizontalSpacer_29">
                                  <property name="orientation">
                                   <enum>Qt::Horizontal</enum>
                                  </property>
                                  <property name="sizeHint" stdset="0">
                                   <size>
                                    <width>40</width>
                                    <height>20</height>
                                   </size>
                                  </property>
                                 </spacer>
                                </item>
                                <item row="0" column="1">
                                 <widget class="QLabel" name="label_160">
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>(s)</string>
                                  </property>
                                 </widget>
                                </item>
                               </layout>
                              </widget>
                             </item>
                             <item row="2" column="0">
                              <widget class="QLabel" name="label_135">
                               <property name="toolTip">
                                <string>&lt;b&gt;GEO Acquisition Time:&lt;/b&gt;&lt;br&gt;&lt;br&gt; In a cold start, it takes some time since the receiver starts gathering messages from the SBAS GEO until it has enough data to compute SBAS corrections. This is the GEO acquisition time.&lt;br&gt;gLAB will not make a GEO or mode switch if no solution could be computed during the acquisition time, as the cause is that we do not have enough data (so switching mode or GEO will be useless, as at the beginning of the processing, all GEOs available are under acquisition time). Furthermore, if a GEO switch is triggered, gLAB will not change to a GEO which is under acquisition time (except if we are switching GEO due to an alarm message and the GEO under acquisition time is the only one available).&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTE:&lt;/b&gt; GEO acquisition time is reset every time an alarm is received, and it will be started again when the first message is read after the one minute cooldown (when an alarm is received, the user must ignore during one minute all messages from the GEO that received the alarm).&lt;br&gt;</string>
                               </property>
                               <property name="styleSheet">
                                <string notr="true">color: rgb(0, 0, 0);</string>
                               </property>
                               <property name="text">
                                <string>GEO Acquisition Time:</string>
                               </property>
                              </widget>
                             </item>
                             <item row="2" column="2">
                              <widget class="QFrame" name="frameGEOadquisitionTime">
                               <property name="frameShape">
                                <enum>QFrame::NoFrame</enum>
                               </property>
                               <property name="frameShadow">
                                <enum>QFrame::Raised</enum>
                               </property>
                               <layout class="QGridLayout" name="gridLayout_133">
                                <property name="leftMargin">
                                 <number>0</number>
                                </property>
                                <property name="topMargin">
                                 <number>0</number>
                                </property>
                                <property name="rightMargin">
                                 <number>0</number>
                                </property>
                                <property name="bottomMargin">
                                 <number>0</number>
                                </property>
                                <property name="verticalSpacing">
                                 <number>0</number>
                                </property>
                                <item row="0" column="0">
                                 <widget class="QLineEdit" name="lineEditGEOadquisitionTime">
                                  <property name="clearButtonEnabled">
                                   <bool>true</bool>
                                  </property>
                                 </widget>
                                </item>
                                <item row="0" column="2">
                                 <spacer name="horizontalSpacer_28">
                                  <property name="orientation">
                                   <enum>Qt::Horizontal</enum>
                                  </property>
                                  <property name="sizeHint" stdset="0">
                                   <size>
                                    <width>40</width>
                                    <height>20</height>
                                   </size>
                                  </property>
                                 </spacer>
                                </item>
                                <item row="0" column="1">
                                 <widget class="QLabel" name="label_159">
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>(s)</string>
                                  </property>
                                 </widget>
                                </item>
                               </layout>
                              </widget>
                             </item>
                             <item row="0" column="0" colspan="3">
                              <widget class="QFrame" name="frame_14">
                               <property name="frameShape">
                                <enum>QFrame::NoFrame</enum>
                               </property>
                               <property name="frameShadow">
                                <enum>QFrame::Raised</enum>
                               </property>
                               <layout class="QGridLayout" name="gridLayout_139">
                                <property name="leftMargin">
                                 <number>0</number>
                                </property>
                                <property name="topMargin">
                                 <number>0</number>
                                </property>
                                <property name="rightMargin">
                                 <number>0</number>
                                </property>
                                <property name="bottomMargin">
                                 <number>0</number>
                                </property>
                                <property name="verticalSpacing">
                                 <number>0</number>
                                </property>
                                <item row="0" column="0">
                                 <widget class="QCheckBox" name="checkBoxMaintainCurrentGEOafterGEOswitch">
                                  <property name="toolTip">
                                   <string>&lt;b&gt;After GEO Switch, Maintain the New Selected GEO&lt;/b&gt;&lt;br&gt;&lt;br&gt;After a successful GEO switch, if this option is enabled, the new GEO will be maintained as long as possible. Otherwise, gLAB will try to switch to the previous GEO (which may not be the initial one if consecutive GEO switches have been done) or to the initial one (if &lt;i&gt;Return to Initial GEO&lt;/i&gt;  option is enabled) after the switching cool time has expired.&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTE:&lt;/b&gt; If both options &lt;i&gt;Return to Initial GEO&lt;/i&gt; and &lt;i&gt;After GEO Switch, Maintain the New Selected GEO&lt;/i&gt; are enabled, the former will prevail (in the GUI these options are exclusive, but in command line both options can be enabled).&lt;br&gt;</string>
                                  </property>
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>After GEO Switch, Maintain the New Selected GEO</string>
                                  </property>
                                 </widget>
                                </item>
                               </layout>
                              </widget>
                             </item>
                            </layout>
                           </widget>
                          </item>
                          <item row="16" column="0">
                           <widget class="QGroupBox" name="groupBoxDisableSpecificCorrections">
                            <property name="font">
                             <font>
                              <pointsize>9</pointsize>
                              <weight>75</weight>
                              <bold>true</bold>
                             </font>
                            </property>
                            <property name="title">
                             <string>Show Disable Specific Corrections</string>
                            </property>
                            <property name="checkable">
                             <bool>true</bool>
                            </property>
                            <property name="checked">
                             <bool>true</bool>
                            </property>
                            <layout class="QGridLayout" name="gridLayout_135">
                             <property name="verticalSpacing">
                              <number>3</number>
                             </property>
                             <item row="0" column="0">
                              <widget class="QFrame" name="frameDisableSpecificCorrections">
                               <property name="frameShape">
                                <enum>QFrame::NoFrame</enum>
                               </property>
                               <property name="frameShadow">
                                <enum>QFrame::Raised</enum>
                               </property>
                               <layout class="QGridLayout" name="gridLayout_137">
                                <property name="leftMargin">
                                 <number>0</number>
                                </property>
                                <property name="topMargin">
                                 <number>0</number>
                                </property>
                                <property name="rightMargin">
                                 <number>0</number>
                                </property>
                                <property name="bottomMargin">
                                 <number>0</number>
                                </property>
                                <item row="0" column="0">
                                 <widget class="QCheckBox" name="checkBoxDisableFastCorrections">
                                  <property name="toolTip">
                                   <string>&lt;b&gt;Disable Fast Corrections&lt;/b&gt;&lt;br&gt;&lt;br&gt;Fast corrections will be set to zero, but the conditions to apply a fast correction must be fulfilled (if they are not fulfilled, fast corrections will be declared as not available). This would be equivalent as if the correction received from the SBAS message was zero.&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTE:&lt;/b&gt; RRC corrections will also be set to 0 if this option is enabled (range rate corrections are for taking into account the variation of the fast corrections in time. If fast corrections are zero, their variation in time will also be zero).&lt;br&gt;</string>
                                  </property>
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>Disable Fast Corrections</string>
                                  </property>
                                 </widget>
                                </item>
                                <item row="1" column="0">
                                 <widget class="QCheckBox" name="checkBoxDisableRRCcorrections">
                                  <property name="toolTip">
                                   <string>&lt;b&gt;Disable RRC Corrections&lt;/b&gt;&lt;br&gt;&lt;br&gt; Range Rate Correction will be set to zero, but the conditions to apply a range rate correction must be fulfilled (if they are not fulfilled, RRC corrections will be declared as not available).&lt;br&gt;</string>
                                  </property>
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>Disable RRC Corrections</string>
                                  </property>
                                 </widget>
                                </item>
                                <item row="2" column="0">
                                 <widget class="QCheckBox" name="checkBoxDisableSlowCorrections">
                                  <property name="toolTip">
                                   <string>&lt;b&gt;Disable Slow Corrections&lt;/b&gt;&lt;br&gt;&lt;br&gt;Slow corrections will be set to zero, but the conditions to apply a slow correction must be fulfilled (if they are not fulfilled, slow corrections will be declared as not available). This would be equivalent as if the correction received from the SBAS message was zero.&lt;br&gt;</string>
                                  </property>
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>Disable Slow Corrections</string>
                                  </property>
                                 </widget>
                                </item>
                                <item row="3" column="0">
                                 <widget class="QCheckBox" name="checkBoxDisableIonosphereCorrections">
                                  <property name="toolTip">
                                   <string>&lt;b&gt;Disable Ionosphere Corrections&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ionosphere correction will be set to zero, but the conditions to apply a ionosphere correction must be fulfilled (if they are not fulfilled, ionosphere corrections will be declared as not available). This would be equivalent as if the correction received from the SBAS message was zero.&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTE:&lt;/b&gt; If the user want to apply a ionosphere model different from SBAS or no ionosphere model (effectively ignoring messages type 18 and 26), the user should leave this option unchecked and set the appropriate ionosphere model in the &lt;i&gt;Ionospheric Correction&lt;/i&gt; option.&lt;br&gt;</string>
                                  </property>
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>Disable Ionosphere Corrections</string>
                                  </property>
                                 </widget>
                                </item>
                               </layout>
                              </widget>
                             </item>
                            </layout>
                           </widget>
                          </item>
                          <item row="6" column="0">
                           <widget class="QFrame" name="frame_discardSatellitesUDREI">
                            <property name="frameShape">
                             <enum>QFrame::NoFrame</enum>
                            </property>
