                                 <item row="0" column="0">
                                  <widget class="QLabel" name="label_82">
                                   <property name="toolTip">
                                    <string>&lt;b&gt;Set ISCB unit&lt;/b&gt;&lt;br&gt;&lt;br&gt;Set the ISCB (Inter System Clock Bias) unit between constellations in the table below. The available units are metres, seconds, and nanoseconds.&lt;br&gt;&lt;br&gt;The table below provides the user two ways for setting the ISCB for each pair of constellations:&lt;ul&gt;&lt;li&gt;&lt;b&gt;Estimate:&lt;/b&gt; The ISCB between each pair of constellation is estimated by the filter (with the Phi, Q and Po set in the &lt;i&gt;Parameters&lt;/i&gt; section above).&lt;/li&gt;&lt;li&gt;&lt;b&gt;&amp;lt;Value&amp;gt;:&lt;/b&gt; User provided value (double click in a cell to set a value). The value set is for the ISCB from the reference constellation (on the first column) to the destination constellation (on the first row). The inverse conversion will be set automatically in gLAB with the same value but the sign inverted.&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;</string>
                                   </property>
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>Set ISCB unit:</string>
                                   </property>
                                  </widget>
