                                     <property name="toolTip">
                                      <string>&lt;b&gt;User Added Error File:&lt;/b&gt;&lt;br&gt;&lt;br&gt;Text file for adding error to satelite raw measurements on certain epochs. Using an adder error file is equivalent to modifying the measurement values in the RINEX observation file.&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTE:&lt;/b&gt; For details on how to generate a user added error file, read the manual entry available in the following menu:&lt;br&gt;&lt;font color=&quot;#0000FF&quot;&gt;Help-&gt;User manuals-&gt;User Adder Error File Manual.&lt;/font&gt;&lt;br&gt;</string>
                                     </property>
                                     <property name="styleSheet">
                                      <string notr="true">color: rgb(0, 0, 0);</string>
