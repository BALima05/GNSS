                          <item row="1" column="0">
                           <widget class="QLabel" name="label_300">
                            <property name="toolTip">
                             <string>&lt;b&gt;Initial stdDev&lt;/b&gt;&lt;br&gt;&lt;br&gt;Initial standard deviation (in metres) to initialize the cycle-slip detector.&lt;br&gt;</string>
