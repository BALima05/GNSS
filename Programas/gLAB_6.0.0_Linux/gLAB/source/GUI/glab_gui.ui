                                 <item row="0" column="0">
                                  <widget class="QLabel" name="label_101">
                                   <property name="text">
                                    <string/>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="0" column="1">
                                  <widget class="QLabel" name="label_102">
                                   <property name="toolTip">
                                    <string>&lt;b&gt;MT&lt;/b&gt;&lt;br&gt;&lt;br&gt;Message Type number defined in MOPS.&lt;br&gt;</string>
                                   </property>
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>MT</string>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="0" column="2">
                                  <widget class="QLabel" name="label_SBAS_PA_timeouts">
                                   <property name="toolTip">
                                    <string>&lt;b&gt;PA&lt;/b&gt;&lt;br&gt;&lt;br&gt;Time-out values (in seconds) in PA (Precision Approach) navigation mode.&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTE:&lt;/b&gt; The condition to check if a message has time-out for any message (except for range rate corrections) is:&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(t - t&lt;sub&gt;lastbit&lt;/sub&gt;) &gt; t&lt;sub&gt;max&lt;/sub&gt;&lt;br&gt;&lt;br&gt;Where:&lt;ul&gt;&lt;li&gt;&lt;b&gt;t:&lt;/b&gt; The current epoch.&lt;/li&gt;&lt;li&gt;&lt;b&gt;t&lt;sub&gt;lastbit&lt;/sub&gt;:&lt;/b&gt; Time of reception of last bit of current message (taking into account the 0.1 seconds of signal travel time).&lt;/li&gt;&lt;li&gt;&lt;b&gt;t&lt;sub&gt;max&lt;/sub&gt;:&lt;/b&gt; The time-out value for the current message and navigation mode.&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;</string>
                                   </property>
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>PA</string>
                                   </property>
                                   <property name="alignment">
                                    <set>Qt::AlignCenter</set>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="0" column="3">
                                  <widget class="QLabel" name="label_SBAS_NPA_timeouts">
                                   <property name="toolTip">
                                    <string>&lt;b&gt;NPA&lt;/b&gt;&lt;br&gt;&lt;br&gt;Time-out values (in seconds) in NPA (Non Precision Approach) navigation mode.&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTE:&lt;/b&gt; The condition to check if a message has time-out for any message (except for range rate corrections) is:&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(t - t&lt;sub&gt;lastbit&lt;/sub&gt;) &gt; t&lt;sub&gt;max&lt;/sub&gt;&lt;br&gt;&lt;br&gt;Where:&lt;ul&gt;&lt;li&gt;&lt;b&gt;t:&lt;/b&gt; The current epoch.&lt;/li&gt;&lt;li&gt;&lt;b&gt;t&lt;sub&gt;lastbit&lt;/sub&gt;:&lt;/b&gt; Time of reception of last bit of current message (taking into account the 0.1 seconds of signal travel time).&lt;/li&gt;&lt;li&gt;&lt;b&gt;t&lt;sub&gt;max&lt;/sub&gt;:&lt;/b&gt; The time-out value for the current message and navigation mode.&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;</string>
                                   </property>
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>NPA</string>
                                   </property>
                                   <property name="alignment">
                                    <set>Qt::AlignCenter</set>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="1" column="0">
                                  <widget class="QLabel" name="label_133">
                                   <property name="toolTip">
                                    <string>&lt;b&gt;Do Not Use for Safety Applications&lt;/b&gt;&lt;br&gt;&lt;br&gt;Message type 0. This message to inform the user that there is a problem in the GEO that has sent this message. When the user receives this message, an alarm is triggered, and the user has to erase all information received from this GEO (except for the almanac), and also wait for one minute until the user can start using this GEO again (during this minute of cooldown, all messages from this GEO must be ignored).&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTES:&lt;/b&gt;&lt;ul&gt;&lt;li&gt;The alarm is triggered just after reading the message&lt;/li&gt;&lt;li&gt;If user has enabled the option &lt;i&gt;Parse Alarm Message as Type 2 Message&lt;/i&gt;, then this message will be read as a type 2 message (no alarm triggered), except for the case that this message is filled with all zeros, which means that the user is forced to read it as an alarm message.&lt;/li&gt;&lt;li&gt;If user has enabled the option &lt;i&gt;Ignore All Alarm Messages&lt;/i&gt;, then this message will be ignored and no alarm will be triggered.&lt;/li&gt;&lt;li&gt;When an alarm is triggered, after the cooldown minute, the GEO acquisition time will be restarted.&lt;/li&gt;&lt;li&gt;The time-out of 9999999 seconds is to indicate that is has an infinite time-out (due to, as explained above, the message is applied instantaneously)&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;</string>
                                   </property>
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>Do Not Use for Safety Applications</string>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="1" column="1">
                                  <widget class="QLabel" name="label_134">
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>0</string>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="1" column="2">
                                  <widget class="QLineEdit" name="lineEditDoNotUseForSafetyAppPA">
                                   <property name="clearButtonEnabled">
                                    <bool>true</bool>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="1" column="3">
                                  <widget class="QLineEdit" name="lineEditDoNotUseForSafetyAppNPA">
                                   <property name="clearButtonEnabled">
                                    <bool>true</bool>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="1" column="4">
                                  <widget class="QLabel" name="label_2">
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>(s)</string>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="2" column="0">
                                  <widget class="QLabel" name="label_105">
                                   <property name="toolTip">
                                    <string>&lt;b&gt;PRN Mask Assignments&lt;/b&gt;&lt;br&gt;&lt;br&gt;Message type 1. This message has 210 ordered slots, each one corresponding to a given satellite PRN and constellation. Each slot is one bit, if the bit is 1, the satellite is monitored, otherwise the satellite is not monitored. This set of ordered slots is called the PRN mask. The order is important, as the order of the monitored satellites in the mask will be the order in which the corrections will be sent in other messages. Currently, the slots are assigned in the following way:&lt;ul&gt;&lt;li&gt;&lt;b&gt;Slots 1- 37:&lt;/b&gt; For GPS satellites.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Slots 38- 61:&lt;/b&gt; For GLONASS satellites (GLONASS PRN +37).&lt;/li&gt;&lt;li&gt;&lt;b&gt;Slots 62- 119:&lt;/b&gt; For future GNSS.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Slots 120- 138:&lt;/b&gt; For GEO/SBAS satellites.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Slots 139- 210:&lt;/b&gt; For future GNSS/GEO/SBAS satellites.&lt;/li&gt;&lt;/ul&gt;&lt;b&gt;NOTES:&lt;/b&gt;&lt;ul&gt;&lt;li&gt;Each message has an IODP (Issue Of Data PRN Mask), which identifyies each PRN mask. If any bit of the PRN mask changes, the IODP will change (which will be rare).&lt;/li&gt;&lt;li&gt;The maximum number of concurrent monitored satellites is 51 (including all constellations), due to the limited space in the SBAS messages. PRN Mask messages with more than 51 satellites monitored will be rejected by gLAB.&lt;/li&gt;&lt;li&gt;All messages that need a PRN mask (to get the order for the satellite corrections), will also have an IODP associated. Thence, the user must have the mask with the given IODP in order to read the message.&lt;/li&gt;&lt;li&gt;When a PRN mask occurs (a mask with a different IODP), the user will have to save the previous mask and also all messages associated to the old IODP until new corrections with the new IODP are received or the old corrections time-out. This assures that a PRN mask transition is smooth and there is continuity of corrections. In practice, SBAS providers usually prefer to send alarm messages during some minutes when a PRN mask change occurs, to force the user clear all the data and switch to another GEO.&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;</string>
                                   </property>
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>PRN Mask Assignments</string>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="2" column="1">
                                  <widget class="QLabel" name="label_106">
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>1</string>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="2" column="2">
                                  <widget class="QLineEdit" name="lineEditPRNmaskPA">
                                   <property name="clearButtonEnabled">
                                    <bool>true</bool>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="2" column="3">
                                  <widget class="QLineEdit" name="lineEditPRNmaskNPA">
                                   <property name="clearButtonEnabled">
                                    <bool>true</bool>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="2" column="4">
                                  <widget class="QLabel" name="label_3">
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>(s)</string>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="3" column="0">
                                  <widget class="QLabel" name="label_107">
                                   <property name="toolTip">
                                    <string>&lt;b&gt;Fast Corrections&lt;/b&gt;&lt;br&gt;&lt;br&gt;Fast corrections are given in messages type 2, 3, 4 ,5 and 6. Messages type 2, 3, 4 and 5 provide each of a set of corrections for 13 satellites. These corrections include a PRC (PseudoRange Correction), which is added directly to the satellite computed model, and a sigma or UDREI (User Differential Range Error Indicator) for the correction. The distribution of corrections sent are as follows:&lt;ul&gt;&lt;li&gt;&lt;b&gt;Message type 2:&lt;/b&gt; Corrections from satellite 1 to 13 in the PRN mask.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Message type 3:&lt;/b&gt; Corrections from satellite 14 to 26 in the mask.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Message type 4:&lt;/b&gt; Corrections from satellite 27 to 39 in the mask.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Message type 5:&lt;/b&gt; Corrections from satellite 40 to 51 in the mask.&lt;/li&gt;&lt;/ul&gt;Message type 6 sends only the sigmas for the 51 satellites in the mask. Each time this message arrives, it is considered that PRC for all satellites remain constant, while the sigmas are updated.&lt;br&gt;Messages type 2, 3 ,4 ,5 will have each one an IODF (Issue Of Data Fast corrections), independent from each other-, value which will change every time a PRC changes. The IODFs in message type 6 must match the ones sent in messages type 2, 3, 4, 5. If a message type 6 is received and the IODFs do not match with the ones in messages type 2, 3, 4, 5, then the user must ignore message type 6 until new messages type 2, 3, 4 and 5 with the new IODFs are received.&lt;br&gt;Time-outs for all satellite fast correction are independent from each other. These time-outs are sent in message type 7 (but are typically set to 6 seconds). If user sets a time-out for fast corrections, then all satellites will have the same time-out (message type 7 will be ignored).&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTES:&lt;/b&gt;&lt;ul&gt;&lt;li&gt;When a message type 6 is received, as a sigma is received for all satellites, time-outs for all satellites are reset (except for the case that IODFs do not match, which in this case user must ignore message type 6).&lt;/li&gt;&lt;li&gt;If a message type 6 is received and the IODFs do not match, but one or more IODFs have a value of 3 (IODF in normal conditions only have values from 0 to 2), then any satellite under this IODF is under alarm condition. In this condition, the sigma (UDREI) from message type 6 must be used, but the timeout of the fast corrections must be computed using the epoch of the last message type 2, 3, 4 or 5 (the one associated with that IODF).&lt;/li&gt;&lt;li&gt;If an UDREI with value 14 or 15 is received, then the satellite must not be used for ranging, and all other previous fast corrections received from this satellite must be erased. An UDREI=14 means that the satellite is not monitored, and UDREI=15 means that the satellite must not be used.&lt;/li&gt;&lt;li&gt;Fast correction messages have an IODP, which must match with the one received in the message type 1 (PRN mask). If they don't match, these messages cannot be decoded.&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;</string>
                                   </property>
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>Fast Corrections</string>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="3" column="1">
                                  <widget class="QLabel" name="label_108">
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>-</string>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="3" column="2">
                                  <widget class="QLineEdit" name="lineEditFastCorrectionsPA">
                                   <property name="clearButtonEnabled">
                                    <bool>true</bool>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="3" column="3">
                                  <widget class="QLineEdit" name="lineEditFastCorrectionsNPA">
                                   <property name="clearButtonEnabled">
                                    <bool>true</bool>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="3" column="4">
                                  <widget class="QLabel" name="label_7">
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>(s)</string>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="4" column="0">
                                  <widget class="QLabel" name="label_109">
                                   <property name="toolTip">
                                    <string>&lt;b&gt;RRC Corrections&lt;/b&gt;&lt;br&gt;&lt;br&gt;RRC (Range-Rate Corrections) are not sent by the SBAS system. The user has to compute them using the PRC (PseudoRange Correction) provided in messages type 2, 3, 4, 5 and 24. The formula to compute the RRC correction  is:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;RRC(t) = (PRC&lt;sub&gt;current&lt;/sub&gt; - PRC&lt;sub&gt;previous&lt;/sub&gt;)/&amp;Delta;t · (t-t&lt;sub&gt;of&lt;/sub&gt;)&lt;br&gt;&lt;br&gt;Where:&lt;ul&gt;&lt;li&gt;&lt;b&gt;PRC&lt;sub&gt;current&lt;/sub&gt;:&lt;/b&gt; The most recent fast correction received.&lt;/li&gt;&lt;li&gt;&lt;b&gt;PRC&lt;sub&gt;previous&lt;/sub&gt;:&lt;/b&gt; The previous fast correction received.&lt;/li&gt;&lt;li&gt;&lt;b&gt;t:&lt;/b&gt; The current epoch.&lt;/li&gt;&lt;li&gt;&lt;b&gt;&amp;Delta;t:&lt;/b&gt; t&lt;sub&gt;of&lt;/sub&gt; - t&lt;sub&gt;of,previous&lt;/sub&gt;&lt;/li&gt;&lt;li&gt;&lt;b&gt;t&lt;sub&gt;of&lt;/sub&gt;:&lt;/b&gt; Time of applicability of the most recent fast correction received.&lt;/li&gt;&lt;li&gt;&lt;b&gt;t&lt;sub&gt;of,previous&lt;/sub&gt;:&lt;/b&gt; Time of applicability of the previous fast correction received.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Time of applicability:&lt;/b&gt; Is the epoch where the first bit of the message was sent in the SBAS GEO&lt;/li&gt;&lt;/ul&gt;RRC corrections must time-out if any of these conditions are met:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;Delta;t &gt; I&lt;sub&gt;fc&lt;/sub&gt;     OR     (t - t&lt;sub&gt;of&lt;/sub&gt; -1 ) &gt; 8·&amp;Delta;t&lt;br&gt;Where:&lt;ul&gt;&lt;li&gt;&lt;b&gt;I&lt;sub&gt;fc&lt;/sub&gt;:&lt;/b&gt; Is the shortest time-out of all satellites included in a fast correction message.&lt;/li&gt;&lt;li&gt;&lt;b&gt;t:&lt;/b&gt; The current epoch.&lt;/li&gt;&lt;li&gt;&lt;b&gt;&amp;Delta;t:&lt;/b&gt; t&lt;sub&gt;of&lt;/sub&gt; - t&lt;sub&gt;of,previous&lt;/sub&gt;&lt;/li&gt;&lt;li&gt;&lt;b&gt;t&lt;sub&gt;of&lt;/sub&gt;:&lt;/b&gt; Time of applicability of the most recent fast correction received.&lt;/li&gt;&lt;li&gt;&lt;b&gt;t&lt;sub&gt;of,previous&lt;/sub&gt;:&lt;/b&gt; Time of applicability of the previous fast correction received.&lt;/li&gt;&lt;/ul&gt;When user sets a time-out for RRC corrections, the conditions stated above will also be evaluated, but with I&lt;sub&gt;fc&lt;/sub&gt; set to the user's value.&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTES:&lt;/b&gt;&lt;ul&gt;&lt;li&gt;When a IODF with value 3 is received (satellite under alarm), then, instead of using the previous PRC correction, the user should search for the PRC closest to I&lt;sub&gt;fc&lt;/sub&gt;/2 seconds prior to the last PRC received and has not timed-out (this is to minimize the noise effect in RRC, as during an alarm, it is likely that fast corrections will be updated very frequently)&lt;/li&gt;&lt;li&gt;EGNOS system does not implement the alarm for fast corrections (no IODF=3 will be sent), but WAAS system does have it.&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;</string>
                                   </property>
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>RRC Corrections</string>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="4" column="1">
                                  <widget class="QLabel" name="label_110">
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>-</string>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="4" column="2">
                                  <widget class="QLineEdit" name="lineEditRRCcorrectionsPA">
                                   <property name="clearButtonEnabled">
                                    <bool>true</bool>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="4" column="3">
                                  <widget class="QLineEdit" name="lineEditRRCcorrectionsNPA">
                                   <property name="clearButtonEnabled">
                                    <bool>true</bool>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="4" column="4">
                                  <widget class="QLabel" name="label_8">
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>(s)</string>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="5" column="0">
                                  <widget class="QLabel" name="label_111">
                                   <property name="toolTip">
                                    <string>&lt;b&gt;Integrity Info&lt;/b&gt;&lt;br&gt;&lt;br&gt;Message type 6. This message transmits the sigma or UDREI (User Differential Range Error Indicator) for the 51 monitored satellites, along with IODF (Issue of Data Fast corrections) of messages type 2, 3, 4, 5. If IODFs in message type 6 does not match with the ones of messages type 2, 3, 4 and 5, then the user is aware that he has lost a fast correction message, and will have to keep using the PRC and UDREIs from the last messages type 2, 3, 4 and 5.&lt;br&gt;If IODFs match, then the user updates the UDREIs of all satellites and resets the time-outs for messages type 2, 3, 4 and 5, as message type 6 indicates that the PRC of all satellites have not changed.&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTE:&lt;/b&gt; This message has an IODP, which must match with the one received in the message type 1 (PRN mask). If they don't match, it cannot be decoded.&lt;br&gt;</string>
                                   </property>
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>Integrity Info</string>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="5" column="1">
                                  <widget class="QLabel" name="label_112">
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>6</string>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="5" column="2">
                                  <widget class="QLineEdit" name="lineEditIntegrityInfoPA">
                                   <property name="clearButtonEnabled">
                                    <bool>true</bool>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="5" column="3">
                                  <widget class="QLineEdit" name="lineEditIntegrityInfoNPA">
                                   <property name="clearButtonEnabled">
                                    <bool>true</bool>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="5" column="4">
                                  <widget class="QLabel" name="label_10">
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>(s)</string>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="6" column="0">
                                  <widget class="QLabel" name="label_113">
                                   <property name="toolTip">
                                    <string>&lt;b&gt;Fast Correction Degradation Factor&lt;/b&gt;&lt;br&gt;&lt;br&gt;Message type 7. This message contains the time-out to be applied to each of the 51 monitored satellites, as well as the system latency (t&lt;sub&gt;lat&lt;/sub&gt;) value, used for computing the fast correction degradation.&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTE:&lt;/b&gt; This message has an IODP, which must match with the one received in the message type 1 (PRN mask). If they don't match, it cannot be decoded.&lt;br&gt;</string>
                                   </property>
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>Fast Correction Degradation Factor</string>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="6" column="1">
                                  <widget class="QLabel" name="label_114">
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>7</string>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="6" column="2">
                                  <widget class="QLineEdit" name="lineEditFastCorrectionDegradationFactorPA">
                                   <property name="clearButtonEnabled">
                                    <bool>true</bool>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="6" column="3">
                                  <widget class="QLineEdit" name="lineEditFastCorrectionDegradationFactorNPA">
                                   <property name="clearButtonEnabled">
                                    <bool>true</bool>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="6" column="4">
                                  <widget class="QLabel" name="label_11">
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>(s)</string>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="7" column="0">
                                  <widget class="QLabel" name="label_127">
                                   <property name="toolTip">
                                    <string>&lt;b&gt;GEO Navigation Message&lt;/b&gt;&lt;br&gt;&lt;br&gt;Message type 9. This message contains the navigation message for one SBAS GEO. It can be used to compute the GEOs position and clock correction if it used in the navigation solution. With this message a RINEX navigation for GEOs (type H) can be generated (actually, when converting a RINEX-B or EMS to Pegasus format with gLAB,  the RINEX navigation message is generated).&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTE:&lt;/b&gt; GEO navigation message include a URA (User Range Accuracy) index. If URA index is 15 or greater, then the GEO should not be used for ranging.&lt;br&gt;</string>
                                   </property>
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>GEO Navigation Message</string>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="7" column="1">
                                  <widget class="QLabel" name="label_128">
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>9</string>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="7" column="2">
                                  <widget class="QLineEdit" name="lineEditGeoNavigationMessagePA">
                                   <property name="clearButtonEnabled">
                                    <bool>true</bool>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="7" column="3">
                                  <widget class="QLineEdit" name="lineEditGeoNavigationMessageNPA">
                                   <property name="clearButtonEnabled">
                                    <bool>true</bool>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="7" column="4">
                                  <widget class="QLabel" name="label_12">
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>(s)</string>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="8" column="0">
                                  <widget class="QLabel" name="label_115">
                                   <property name="toolTip">
                                    <string>&lt;b&gt;Degradation Parameters&lt;/b&gt;&lt;br&gt;&lt;br&gt;Message type 10. This message contains a series of values necessary to compute the degradation terms for all corrections.&lt;br&gt;If PA navigation mode is selected, and this message is not available, no SBAS correction is available, but if option &lt;i&gt;Disable Message Type 10 (Degradation parameters)&lt;/i&gt; is enabled or navigation mode is NPA, then a SBAS correction will be computed, but the fast and long term corrections degradation will be greatly increased.&lt;br&gt;In concrete, if message type 10 is available, the fast and long term corrections degradation is computed with the following formula:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;If RSS&lt;sub&gt;UDRE&lt;/sub&gt;= 0 (from message type 10)&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;sigma;&lt;sup&gt;2&lt;/sup&gt;&lt;sub&gt;flt&lt;/sub&gt; = ( &amp;sigma;&lt;sub&gt;UDRE&lt;/sub&gt;·&amp;delta;UDRE + &amp;epsilon;&lt;sub&gt;fc&lt;/sub&gt; + &amp;epsilon;&lt;sub&gt;rrc&lt;/sub&gt; + &amp;epsilon;&lt;sub&gt;ltc&lt;/sub&gt; + &amp;epsilon;&lt;sub&gt;er&lt;/sub&gt; )&lt;sup&gt;2&lt;/sup&gt;&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;If RSS&lt;sub&gt;UDRE&lt;/sub&gt;= 1 (from message type 10)&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;sigma;&lt;sup&gt;2&lt;/sup&gt;&lt;sub&gt;flt&lt;/sub&gt; = (&amp;sigma;&lt;sub&gt;UDRE&lt;/sub&gt;·&amp;delta;UDRE)&lt;sup&gt;2&lt;/sup&gt; + &amp;epsilon;&lt;sup&gt;2&lt;/sup&gt;&lt;sub&gt;fc&lt;/sub&gt; + &amp;epsilon;&lt;sub&gt;rrc&lt;/sub&gt; + &amp;epsilon;&lt;sup&gt;2&lt;/sup&gt;&lt;sub&gt;ltc&lt;/sub&gt; + &amp;epsilon;&lt;sup&gt;2&lt;/sup&gt;&lt;sub&gt;er&lt;/sub&gt;&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Where:&lt;ul&gt;&lt;li&gt;&lt;b&gt;RSS&lt;sub&gt;UDRE&lt;/sub&gt;:&lt;/b&gt; Root Sum Square flag in message type 10.&lt;/li&gt;&lt;li&gt;&lt;b&gt;&amp;sigma;&lt;sub&gt;UDRE&lt;/sub&gt;:&lt;/b&gt; Sigma received in fast corrections messages type 2-6.&lt;/li&gt;&lt;li&gt;&lt;b&gt;&amp;delta;UDRE:&lt;/b&gt; &amp;sigma;&lt;sub&gt;UDRE&lt;/sub&gt; factor computed from message type 27 or 28.&lt;/li&gt;&lt;li&gt;&lt;b&gt;&amp;epsilon;&lt;sub&gt;fc&lt;/sub&gt;:&lt;/b&gt; Degradation parameter for fast correction data.&lt;/li&gt;&lt;li&gt;&lt;b&gt; &amp;epsilon;&lt;sub&gt;rrc&lt;/sub&gt;:&lt;/b&gt; Degradation parameter for range rate correction data.&lt;/li&gt;&lt;li&gt;&lt;b&gt;&amp;epsilon;&lt;sub&gt;ltc&lt;/sub&gt;:&lt;/b&gt; Degradation parameter for long term correction or GEO navigation message data.&lt;/li&gt;&lt;li&gt;&lt;b&gt;&amp;epsilon;&lt;sub&gt;er&lt;/sub&gt;:&lt;/b&gt; Degradation parameter for en route through NPA applications.&lt;/li&gt;&lt;/ul&gt;If message type 10 is not available (in NPA mode only), or is disabled with the option &lt;i&gt;Disable Message Type 10 (Degradation parameters&lt;/i&gt;), the fast and long term corrections degradation is computed with the following formula:&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;sigma;&lt;sup&gt;2&lt;/sup&gt;&lt;sub&gt;flt&lt;/sub&gt; = ( &amp;sigma;&lt;sub&gt;UDRE&lt;/sub&gt;·&amp;delta;UDRE +8 )&lt;sup&gt;2&lt;/sup&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTES:&lt;/b&gt;&lt;ul&gt;&lt;li&gt;All units for all elements in the formulas above are in metres (except for &amp;delta;UDRE, which is adimensional)&lt;/li&gt;&lt;li&gt;See MOPS for details on how to compute the degradation terms.&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;</string>
                                   </property>
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>Degradation Parameters</string>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="8" column="1">
                                  <widget class="QLabel" name="label_116">
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>10</string>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="8" column="2">
                                  <widget class="QLineEdit" name="lineEditDegradationParametersPA">
                                   <property name="clearButtonEnabled">
                                    <bool>true</bool>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="8" column="3">
                                  <widget class="QLineEdit" name="lineEditDegradationParametersNPA">
                                   <property name="clearButtonEnabled">
                                    <bool>true</bool>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="8" column="4">
                                  <widget class="QLabel" name="label_13">
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>(s)</string>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="9" column="0">
                                  <widget class="QLabel" name="label_131">
                                   <property name="toolTip">
                                    <string>&lt;b&gt;Network Time Parameters&lt;/b&gt;&lt;br&gt;&lt;br&gt;Message type 12. This message contains time parameters in UTC to synchronize receiver time. It is decoded but not used in gLAB, as time is set by the RINEX observation file.&lt;br&gt;</string>
                                   </property>
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>Network Time Parameters</string>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="9" column="1">
                                  <widget class="QLabel" name="label_132">
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>12</string>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="9" column="2">
                                  <widget class="QLineEdit" name="lineEditNetworkTimeParametersPA">
                                   <property name="clearButtonEnabled">
                                    <bool>true</bool>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="9" column="3">
                                  <widget class="QLineEdit" name="lineEditNetworkTimeParametersNPA">
                                   <property name="clearButtonEnabled">
                                    <bool>true</bool>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="9" column="4">
                                  <widget class="QLabel" name="label_14">
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>(s)</string>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="10" column="0">
                                  <widget class="QLabel" name="label_129">
                                   <property name="toolTip">
                                    <string>&lt;b&gt;GEO Satellite Almanacs&lt;/b&gt;&lt;br&gt;&lt;br&gt;Message type 17. This message contains the almanac for the SBAS GEO transmitting signals. This message allows the user to be aware of all the SBAS GEO available, and also compute a rough position of each GEO (this is useful if user wants to use the GEO with highest elevation in the minimum time possible).&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTE:&lt;/b&gt; The timeout of 9999999 seconds is to indicate an infinite timeout.&lt;br&gt;</string>
                                   </property>
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
