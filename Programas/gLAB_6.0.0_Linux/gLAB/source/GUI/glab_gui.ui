                                          <widget class="QWidget" name="pageStdDevGPSSBAS_1">
                                           <layout class="QGridLayout" name="gridLayout_751">
                                            <property name="leftMargin">
                                             <number>0</number>
                                            </property>
                                            <property name="topMargin">
                                             <number>0</number>
                                            </property>
                                            <property name="rightMargin">
                                             <number>0</number>
                                            </property>
                                            <property name="bottomMargin">
                                             <number>0</number>
                                            </property>
