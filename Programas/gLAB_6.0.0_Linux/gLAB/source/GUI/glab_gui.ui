                                 </font>
                                </property>
                                <property name="toolTip">
                                 <string>&lt;b&gt;Pseudorange and carrier phase measurements&lt;/b&gt;&lt;br&gt;&lt;br&gt;Use both pseudorange and carrier phase measurements for the processing.&lt;br&gt;</string>
                                </property>
                                <property name="styleSheet">
