                                    <item row="0" column="0">
                                     <widget class="QRadioButton" name="radioButtonRtcmBaseline">
                                      <property name="toolTip">
                                       <string>&lt;b&gt;DGNSS: Baseline&lt;/b&gt;&lt;br&gt;&lt;br&gt;If reference station data is from a RINEX observation file, coordinates will be read from the header record &lt;b&gt;&lt;i&gt;APPROX POSITION XYZ&lt;/i&gt;&lt;/b&gt;, otherwise they will be read from the RTCM file. &lt;br&gt;The rover coordinates will be computed (using the reference station coordinates as initial position), and the differential fields of the &lt;b&gt;OUTPUT&lt;/b&gt; message will be compared with the reference station coordinates.&lt;br&gt;</string>
                                      </property>
                                      <property name="styleSheet">
                                       <string notr="true">color: rgb(0, 0, 0);</string>
                                      </property>
                                      <property name="text">
                                       <string>Baseline</string>
                                      </property>
                                     </widget>
                                    </item>
                                    <item row="0" column="1">
                                     <widget class="QRadioButton" name="radioButtonRtcmUserBaseline">
                                      <property name="toolTip">
                                       <string>&lt;b&gt;DGNSS: User Baseline&lt;/b&gt;&lt;br&gt;&lt;br&gt;Reference station coordinates are provided by the user. &lt;br&gt;The rover coordinates will be computed (using the reference station coordinates as initial position), and the differential fields of the &lt;b&gt;OUTPUT&lt;/b&gt; message will be compared with the reference station coordinates.&lt;br&gt;</string>
                                      </property>
                                      <property name="styleSheet">
                                       <string notr="true">color: rgb(0, 0, 0);</string>
                                      </property>
                                      <property name="text">
                                       <string>User Baseline</string>
                                      </property>
