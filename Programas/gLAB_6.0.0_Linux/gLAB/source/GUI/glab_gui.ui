                                 <item row="1" column="0" colspan="3">
                                  <widget class="QFrame" name="frameInputRinexNavFileGLO1">
                                   <property name="sizePolicy">
                                    <sizepolicy hsizetype="Preferred" vsizetype="Minimum">
                                     <horstretch>0</horstretch>
                                     <verstretch>0</verstretch>
                                    </sizepolicy>
                                   </property>
                                   <property name="frameShape">
                                    <enum>QFrame::NoFrame</enum>
                                   </property>
                                   <property name="frameShadow">
                                    <enum>QFrame::Raised</enum>
                                   </property>
                                   <layout class="QGridLayout" name="gridLayout_403">
                                    <property name="leftMargin">
                                     <number>0</number>
                                    </property>
                                    <property name="topMargin">
                                     <number>0</number>
                                    </property>
                                    <property name="rightMargin">
                                     <number>0</number>
                                    </property>
                                    <property name="bottomMargin">
                                     <number>0</number>
                                    </property>
                                    <property name="verticalSpacing">
                                     <number>6</number>
                                    </property>
                                    <item row="0" column="2">
                                     <widget class="QPushButton" name="pushButtonRinexNavFileGLO1">
                                      <property name="minimumSize">
                                       <size>
                                        <width>0</width>
                                        <height>23</height>
                                       </size>
                                      </property>
                                      <property name="text">
                                       <string>...</string>
                                      </property>
                                     </widget>
                                    </item>
                                    <item row="0" column="1">
                                     <widget class="QLineEdit" name="lineEditRinexNavFileGLO1">
                                      <property name="minimumSize">
                                       <size>
                                        <width>0</width>
                                        <height>23</height>
                                       </size>
                                      </property>
                                      <property name="clearButtonEnabled">
                                       <bool>true</bool>
                                      </property>
                                     </widget>
                                    </item>
                                    <item row="0" column="0">
                                     <widget class="QCheckBox" name="checkBoxRinexNavFileGLO1">
                                      <property name="minimumSize">
                                       <size>
                                        <width>0</width>
                                        <height>23</height>
                                       </size>
                                      </property>
                                      <property name="toolTip">
                                       <string>&lt;b&gt;GLONASS RINEX Navigation File:&lt;/b&gt;&lt;br&gt;&lt;br&gt;Selects the input RINEX navigation file for GLONASS.&lt;br&gt; In order to process GLONASS data, it is needed the frequency number assigned to each satellite. as each satellite uses a different frequency (which is referred to a central frequency). As in PPP mode SP3 and CLK files are used, which do not provide these numbers, the frequency offsets have to be read from the RINEX observation header (provided since version 3.02) or by providing a RINEX navigation file in order to read the GLONASS navigation messages.&lt;br&gt;&lt;br&gt;If a GLONASS RINEX navigation file is not provided and the frequency offset are not available  in the RINEX observation header, GLONASS satellites will be automatically unselected (with the SATSEL message &quot;Missing frequency number (k) for FDMA signals&quot;)&lt;br&gt;&lt;br&gt;RINEX navigation files can be found in the links provided in the following menu:&lt;br&gt;&lt;font color=&quot;#0000FF&quot;&gt;Help-&gt;Download data files-&gt;RINEX Navigation Files&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTES:&lt;/b&gt;&lt;ul&gt;&lt;li&gt; The RINEX navigation file does not need to be a GLONASS only navigation file, as other constellations will be ignored.&lt;/li&gt;&lt;li&gt;Every time a RINEX observation header is read and it contains GLONASS frequency offsets, the frequency offsets will be updated.&lt;/li&gt;&lt;li&gt;To process multiple days in a single run, RINEX navigation files from multiple days must be concatenated (in chronological order) with or without header (recommended with header). To concatenate files, use the following command line instruction:&lt;ul&gt;&lt;li&gt;&lt;b&gt;Linux/Mac/Cygwin terminal:&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;cat file1 file2 file3 ... file N &gt; &lt;i&gt;Concatenated_file&lt;/i&gt;&lt;br&gt;&lt;/li&gt;&lt;li&gt;&lt;b&gt;Windows terminal:&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;copy /b file1+file2+...+fileN &lt;i&gt;Concatenated_file&lt;/i&gt;&lt;/li&gt;&lt;/ul&gt;&lt;br&gt;File1, file2, etc, are the input files to be concatenated. &lt;i&gt;Concatenated_file&lt;/i&gt; is the resulting file after concatenating all input files into one.&lt;br&gt;&lt;br&gt;Note that gLAB does not care about filename or extensions (as gLAB will check that the file contents matches the expected one), so any filename or extension can be used for the concatenated file.&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;</string>
                                      </property>
                                      <property name="styleSheet">
                                       <string notr="true">color: rgb(0, 0, 0);</string>
                                      </property>
                                      <property name="text">
                                       <string>GLONASS RINEX Navigation File:</string>
                                      </property>
                                     </widget>
                                    </item>
                                    <item row="1" column="0">
                                     <widget class="QCheckBox" name="checkBoxRinexNavFileHealth1">
                                      <property name="minimumSize">
                                       <size>
                                        <width>0</width>
                                        <height>23</height>
                                       </size>
                                      </property>
                                      <property name="toolTip">
                                       <string>&lt;b&gt;RINEX Navigation File for Health Flags:&lt;/b&gt;&lt;br&gt;&lt;br&gt;Selects the input RINEX navigation file for health flags.&lt;br&gt; In PPP mode SP3 and CLK files are used, which do not provide health flags, therefore a RINEX navigation file needs to be read in order to gather these flags from the navigation messages.&lt;br&gt;&lt;br&gt;RINEX navigation files can be found in the links provided in the following menu:&lt;br&gt;&lt;font color=&quot;#0000FF&quot;&gt;Help-&gt;Download data files-&gt;RINEX Navigation Files&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTE:&lt;/b&gt; To process multiple days in a single run, RINEX navigation files from multiple days must be concatenated (in chronological order) with or without header (recommended with header). To concatenate files, use the following command line instruction:&lt;ul&gt;&lt;li&gt;&lt;b&gt;Linux/Mac/Cygwin terminal:&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;cat file1 file2 file3 ... file N &gt; &lt;i&gt;Concatenated_file&lt;/i&gt;&lt;br&gt;&lt;/li&gt;&lt;li&gt;&lt;b&gt;Windows terminal:&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;copy /b file1+file2+...+fileN &lt;i&gt;Concatenated_file&lt;/i&gt;&lt;/li&gt;&lt;/ul&gt;&lt;br&gt;File1, file2, etc, are the input files to be concatenated. &lt;i&gt;Concatenated_file&lt;/i&gt; is the resulting file after concatenating all input files into one.&lt;br&gt;&lt;br&gt;Note that gLAB does not care about filename or extensions (as gLAB will check that the file contents matches the expected one), so any filename or extension can be used for the concatenated file.&lt;br&gt;</string>
                                      </property>
                                      <property name="styleSheet">
                                       <string notr="true">color: rgb(0, 0, 0);</string>
                                      </property>
                                      <property name="text">
                                       <string>RINEX Navigation File for Health flags:</string>
                                      </property>
                                     </widget>
                                    </item>
                                    <item row="1" column="1">
                                     <widget class="QLineEdit" name="lineEditRinexNavFileHealth1">
                                      <property name="minimumSize">
                                       <size>
                                        <width>0</width>
                                        <height>23</height>
                                       </size>
                                      </property>
                                      <property name="clearButtonEnabled">
                                       <bool>true</bool>
                                      </property>
                                     </widget>
                                    </item>
                                    <item row="1" column="2">
                                     <widget class="QPushButton" name="pushButtonRinexNavFileHealth1">
                                      <property name="minimumSize">
                                       <size>
                                        <width>0</width>
                                        <height>23</height>
                                       </size>
                                      </property>
                                      <property name="text">
                                       <string>...</string>
                                      </property>
                                     </widget>
                                    </item>
                                   </layout>
                                  </widget>
                                 </item>
                                 <item row="0" column="0">
                                  <widget class="QLabel" name="labelInputSP3OrbitsClocksFile">
                                   <property name="toolTip">
                                    <string>&lt;b&gt;Precise orbit and clocks SP3 file&lt;/b&gt;&lt;br&gt;&lt;br&gt;This file contains the orbits and clocks of the satellite at specific times. The orbit and clock interpolation degrees in the &lt;i&gt;Modelling&lt;/i&gt; section affects the computation of orbit and clocks in this mode.&lt;br&gt;SP3 files can be found in the links provided in the following menu:&lt;br&gt;&lt;font color=&quot;#0000FF&quot;&gt;Help-&gt;Download data files-&gt;Precise Files&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTES:&lt;/b&gt;&lt;ul&gt;&lt;li&gt;SP3 files usually end at 23:45 (15 minute interval files) or 23:55 (5 minute interval files), therefore the last 15 minutes (or 5 minutes) cannot be processed due to the lack of orbits and clocks. To avoid this issue, it is necessary to concatenate the SP3 file with the next day (see bullet below).&lt;/li&gt;&lt;li&gt;To process multiple days in a single run (or for processing the last epochs in day, as explained in bullet above) SP3 files from multiple days must be concatenated (in chronological order) with or without header (recommended with header). To concatenate files, use the following command line instruction:&lt;ul&gt;&lt;li&gt;&lt;b&gt;Linux/Mac/Cygwin terminal:&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;cat file1 file2 file3 ... file N &gt; &lt;i&gt;Concatenated_file&lt;/i&gt;&lt;br&gt;&lt;/li&gt;&lt;li&gt;&lt;b&gt;Windows terminal:&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;copy /b file1+file2+...+fileN &lt;i&gt;Concatenated_file&lt;/i&gt;&lt;/li&gt;&lt;/ul&gt;&lt;br&gt;File1, file2, etc, are the input files to be concatenated. &lt;i&gt;Concatenated_file&lt;/i&gt; is the resulting file after concatenating all input files into one.&lt;br&gt;&lt;br&gt;Note that gLAB does not care about filename or extensions (as gLAB will check that the file contents matches the expected one), so any filename or extension can be used for the concatenated file.&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;</string>
                                   </property>
                                   <property name="styleSheet">
                                    <string notr="true">color: rgb(0, 0, 0);</string>
                                   </property>
                                   <property name="text">
                                    <string>SP3 File:</string>
                                   </property>
                                  </widget>
                                 </item>
                                </layout>
                               </widget>
                               <widget class="QWidget" name="pageSP3CLKOrbits">
                                <property name="sizePolicy">
                                 <sizepolicy hsizetype="Preferred" vsizetype="Minimum">
                                  <horstretch>0</horstretch>
                                  <verstretch>0</verstretch>
                                 </sizepolicy>
                                </property>
                                <layout class="QGridLayout" name="gridLayout_24">
                                 <property name="leftMargin">
                                  <number>0</number>
                                 </property>
                                 <property name="rightMargin">
                                  <number>0</number>
                                 </property>
                                 <item row="0" column="1">
                                  <widget class="QLineEdit" name="lineEditPrecise2Files">
                                   <property name="dragEnabled">
                                    <bool>false</bool>
                                   </property>
                                   <property name="clearButtonEnabled">
                                    <bool>true</bool>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="1" column="1">
                                  <widget class="QLineEdit" name="lineEditPreciseClk">
                                   <property name="sizePolicy">
                                    <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
                                     <horstretch>0</horstretch>
                                     <verstretch>0</verstretch>
                                    </sizepolicy>
                                   </property>
                                   <property name="dragEnabled">
                                    <bool>false</bool>
