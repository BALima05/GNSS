                             <item row="0" column="0">
                              <widget class="QLabel" name="labelStfdESADataFile">
                               <property name="toolTip">
                                <string>&lt;b&gt;Stanford-ESA Data File&lt;/b&gt;&lt;br&gt;&lt;br&gt;Sets the output file for the information about each iteration in the Stanford-ESA computation that had any integrity ratio (either horizontal or vertical) equal or greater than their respective thresholds (see options in the right side). It is a columnar text file, and each line will have the following data: epoch, computed integrity ratios, satellites available in the current epoch and satellites used in the current iteration.&lt;br&gt;</string>
                               </property>
                               <property name="styleSheet">
                                <string notr="true">color: rgb(0, 0, 0);</string>
                               </property>
