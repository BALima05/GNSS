                                        <item row="0" column="3">
                                         <widget class="QLabel" name="label_578">
                                          <property name="toolTip">
                                           <string>&lt;b&gt;Meas:&lt;/b&gt;&lt;br&gt;&lt;br&gt;Set the carrier phase (for single frequency) or the two carrier phases (for dual frequency combinations) for the second GPS carrier phase measurement in the filter. &lt;br&gt;&lt;br&gt;&lt;b&gt;NOTE:&lt;/b&gt; If it is set to &lt;i&gt;Auto&lt;/i&gt;, gLAB will automatically select them according to the measurement order (see option &lt;i&gt;Set GNSS Frequencies and Measurements Order&lt;/i&gt; above) and the available ones in the RINEX observation file.&lt;br&gt;</string>
                                          </property>
                                          <property name="styleSheet">
                                           <string notr="true">color: rgb(0, 0, 0);</string>
                                          </property>
                                          <property name="text">
                                           <string>Meas:</string>
                                          </property>
                                         </widget>
                                        </item>
                                        <item row="0" column="12">
