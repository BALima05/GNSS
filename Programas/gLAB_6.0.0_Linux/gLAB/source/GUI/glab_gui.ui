                                         </property>
                                         <property name="sizeHint" stdset="0">
                                          <size>
                                           <width>0</width>
                                           <height>20</height>
                                          </size>
                                         </property>
                                        </spacer>
                                       </item>
                                      </layout>
                                     </widget>
                                    </widget>
