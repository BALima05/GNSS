                               <property name="text">
                                <string>...</string>
                               </property>
                              </widget>
                             </item>
                             <item row="2" column="0">
                              <widget class="QLabel" name="labelStfdESAPlotFile">
                               <property name="minimumSize">
                                <size>
                                 <width>141</width>
                                 <height>0</height>
                                </size>
                               </property>
                               <property name="toolTip">
                                <string>&lt;b&gt;Stanford-ESA Plot File&lt;/b&gt;&lt;br&gt;&lt;br&gt;Sets the output file for the plotting data of the Stanford-ESA plot. This file is a columnar text file which will be read by the plotting tool (graph).&lt;br&gt;This file contains three header lines at the beginning indicating the plot ranges, the axes pixel resolution (with labels for each of the values in the files). From the fourth line until the end, each line contains the X,Y coordinates, and the number of occurrences in that coordinate for the horizontal and vertical components.&lt;br&gt;</string>
                               </property>
                               <property name="styleSheet">
                                <string notr="true">color: rgb(0, 0, 0);</string>
                               </property>
                               <property name="text">
                                <string>Stanford-ESA Plot File:</string>
                               </property>
                              </widget>
                             </item>
                            </layout>
                           </widget>
                          </item>
                          <item row="0" column="0">
                           <widget class="QLabel" name="labelOutputFile">
                            <property name="toolTip">
                             <string>&lt;b&gt;Output file&lt;/b&gt;&lt;br&gt;&lt;br&gt;Set the output file where all messages will be written.&lt;br&gt;</string>
                            </property>
                            <property name="styleSheet">
                             <string notr="true">color: rgb(0, 0, 0);</string>
                            </property>
                            <property name="text">
                             <string>Output File:</string>
                            </property>
                           </widget>
                          </item>
                          <item row="1" column="0">
                           <widget class="QCheckBox" name="checkBoxKML">
                            <property name="sizePolicy">
                             <sizepolicy hsizetype="Fixed" vsizetype="Minimum">
                              <horstretch>0</horstretch>
                              <verstretch>0</verstretch>
                             </sizepolicy>
                            </property>
                            <property name="minimumSize">
                             <size>
                              <width>0</width>
                              <height>23</height>
                             </size>
                            </property>
                            <property name="toolTip">
                             <string>&lt;b&gt;KML File&lt;/b&gt;&lt;br&gt;&lt;br&gt;Set the output KML file which will be generated with gLAB's solution at the same rate as the &lt;i&gt;Data Decimation&lt;/i&gt; parameter in the PREPROCESS section. Optionally, it may include also timestamps (see KML options below).&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTES:&lt;/b&gt;&lt;ul&gt;&lt;li&gt;In SBAS mode, if switching mode is enabled, epochs computed in NPA mode will be shown in red colour.&lt;/li&gt;&lt;li&gt;In DGNSS mode, epochs computed in SPP mode will be shown in red colour.&lt;/li&gt;&lt;li&gt;In DGNSS mode, if more than one reference station was used, a PlaceMark will be set in the position were the new reference station started to be used. This PlaceMark will have as title &quot;Started to use reference station #Nsta&quot; (being Nsta the number of the reference station used (in the same order as they appear in the DGNSS file), and in its description there will be the timestamp for that epoch (in format YYYY DoY Seconds_of_Day HH:MM:SS) in  GPS time.&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;</string>
                            </property>
                            <property name="styleSheet">
                             <string notr="true">color: rgb(0, 0, 0);</string>
                            </property>
                            <property name="text">
                             <string>KML File:</string>
                            </property>
                           </widget>
                          </item>
                          <item row="2" column="0">
                           <widget class="QCheckBox" name="checkBoxKML0">
                            <property name="minimumSize">
                             <size>
                              <width>0</width>
                              <height>23</height>
                             </size>
                            </property>
                            <property name="toolTip">
                             <string>&lt;b&gt;KML0 File&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Set the output KML0 file which will be generated with gLAB's solution at the same rate as the &lt;i&gt;Data Decimation&lt;/i&gt; parameter in the PREPROCESS section, but projected to the ground (i.e. the height will be 0). Optionally, it may include also timestamps (see KML options below).&lt;br/&gt;&lt;br/&gt;&lt;b&gt;NOTES:&lt;/b&gt;&lt;ul&gt;&lt;li&gt;In SBAS mode, if switching mode is enabled, epochs computed in NPA mode will be shown in red colour.&lt;/li&gt;&lt;li&gt;In DGNSS mode, epochs computed in SPP mode will be shown in red colour.&lt;/li&gt;&lt;li&gt;In DGNSS mode, if more than one reference station was used, a PlaceMark will be set in the position were the new reference station started to be used. This PlaceMark will have as title &quot;Started to use reference station #Nsta&quot; (being Nsta the number of the reference station used (in the same order as they appear in the DGNSS file), and in its description there will be the timestamp for that epoch (in format YYYY DoY Seconds_of_Day HH:MM:SS) in  GPS time.&lt;/li&gt;&lt;/ul&gt;</string>
                            </property>
                            <property name="styleSheet">
                             <string notr="true">color: rgb(0, 0, 0);</string>
                            </property>
                            <property name="text">
                             <string>KML0 File:</string>
                            </property>
                           </widget>
                          </item>
