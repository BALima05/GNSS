                                <item row="0" column="0">
                                 <widget class="QCheckBox" name="checkBoxSetCerOBADParameterMT37">
                                  <property name="minimumSize">
                                   <size>
                                    <width>0</width>
                                    <height>25</height>
                                   </size>
                                  </property>
                                  <property name="toolTip">
                                   <string>&lt;b&gt;Set Cer OBAD Parameter from MT 37&lt;/b&gt;&lt;br&gt;&lt;br&gt;Message type 37 sends OBAD (Old But Active Data) parameters for computing degradation parameters (as described in &lt;i&gt;OBAD Parameters and DFREI Scale Table&lt;/i&gt;). C&lt;sub&gt;er&lt;/sub&gt; is a common parameter to all constellations.&lt;br&gt;&lt;br&gt;With this parameter, C&lt;sub&gt;er&lt;/sub&gt; set by user (in metres) will be used instead of reading it from MT37.&lt;br&gt;&lt;br&gt;C&lt;sub&gt;er&lt;/sub&gt; is used for computing &amp;epsilon;&lt;sub&gt;er&lt;/sub&gt; with the following formula:&lt;ul&gt;&lt;li&gt;&amp;epsilon;&lt;sub&gt;er&lt;/sub&gt; = 0 when corrections have not timed out for PA mode.&lt;/li&gt;&lt;li&gt;&amp;epsilon;&lt;sub&gt;er&lt;/sub&gt; = C&lt;sub&gt;er&lt;/sub&gt; (metres) when corrections have timed out for PA mode but not for NPA mode.&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;</string>
                                  </property>
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>Set Cer OBAD Parameter from MT 37</string>
                                  </property>
                                 </widget>
                                </item>
                                <item row="0" column="1">
                                 <widget class="QFrame" name="frameCerOBADParameterMT37">
                                  <property name="frameShape">
                                   <enum>QFrame::NoFrame</enum>
                                  </property>
                                  <property name="frameShadow">
                                   <enum>QFrame::Raised</enum>
                                  </property>
                                  <layout class="QGridLayout" name="gridLayout_401">
                                   <property name="leftMargin">
                                    <number>0</number>
                                   </property>
                                   <property name="topMargin">
                                    <number>0</number>
                                   </property>
                                   <property name="rightMargin">
                                    <number>0</number>
                                   </property>
                                   <property name="bottomMargin">
                                    <number>0</number>
                                   </property>
                                   <property name="verticalSpacing">
                                    <number>0</number>
                                   </property>
                                   <item row="0" column="0">
                                    <widget class="QLineEdit" name="lineEditCerOBADParameterMT37">
                                     <property name="clearButtonEnabled">
                                      <bool>true</bool>
                                     </property>
                                    </widget>
                                   </item>
                                   <item row="0" column="1">
                                    <widget class="QLabel" name="label_417">
                                     <property name="styleSheet">
                                      <string notr="true">color: rgb(0, 0, 0);</string>
                                     </property>
