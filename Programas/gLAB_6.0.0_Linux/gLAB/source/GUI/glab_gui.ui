                                               <string>(m)</string>
                                              </property>
                                             </widget>
                                            </item>
                                            <item row="0" column="4">
                                             <widget class="QFrame" name="frameCodeBIRNSS_2">
                                              <property name="frameShape">
                                               <enum>QFrame::NoFrame</enum>
                                              </property>
                                              <property name="frameShadow">
                                               <enum>QFrame::Raised</enum>
                                              </property>
