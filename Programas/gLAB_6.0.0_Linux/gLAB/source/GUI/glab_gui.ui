                              </item>
                              <item row="8" column="1">
                               <widget class="QLabel" name="label_343">
                                <property name="styleSheet">
                                 <string notr="true">color: rgb(0, 0, 0);</string>
                                </property>
                                <property name="text">
                                 <string>47</string>
