                             <item row="0" column="0">
                              <widget class="QCheckBox" name="checkBoxSFConsistencyCheck">
                               <property name="minimumSize">
                                <size>
                                 <width>0</width>
                                 <height>23</height>
                                </size>
                               </property>
                               <property name="toolTip">
                                <string>&lt;b&gt;Consistency Check&lt;/b&gt;&lt;br&gt;&lt;br&gt;This a code to detect large variations in code and carrier phase measurements from epoch to epoch (both measurements should vary in a similar way). It is computed with the following method:&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;DeltaCode = Code - Code&lt;sub&gt;Previous Epoch&lt;/sub&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;DeltaPhase = Phase - Phase&lt;sub&gt;Previous Epoch&lt;/sub&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;DeltaCodePhase = abs(DeltaCode - DeltaPhase)&lt;br&gt;&lt;br&gt;If option is checked, and DeltaCodePhase is greater than a threshold, the satellite is skipped in this epoch.&lt;br&gt;</string>
                               </property>
                               <property name="styleSheet">
                                <string notr="true">color: rgb(0, 0, 0);</string>
                               </property>
                               <property name="text">
                                <string>Consistency Check</string>
                               </property>
                              </widget>
                             </item>
                             <item row="0" column="1">
                              <widget class="QFrame" name="frameSFConsCheckValue">
                               <property name="frameShape">
