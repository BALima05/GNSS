                                <property name="orientation">
                                 <enum>Qt::Vertical</enum>
                                </property>
                                <property name="sizeHint" stdset="0">
                                 <size>
                                  <width>20</width>
                                  <height>0</height>
                                 </size>
                                </property>
                               </spacer>
                              </item>
                             </layout>
                            </widget>
                           </widget>
                          </item>
                         </layout>
                        </widget>
                       </item>
                      </layout>
                     </widget>
                    </item>
                    <item row="2" column="0">
                     <widget class="QGroupBox" name="groupBoxReceiverAntennaReferencePointCorrection">
                      <property name="sizePolicy">
                       <sizepolicy hsizetype="Preferred" vsizetype="Fixed">
                        <horstretch>0</horstretch>
                        <verstretch>0</verstretch>
                       </sizepolicy>
                      </property>
                      <property name="font">
                       <font>
                        <pointsize>9</pointsize>
                        <weight>75</weight>
                        <bold>true</bold>
                       </font>
                      </property>
                      <property name="styleSheet">
                       <string notr="true">QGroupBox {color: rgb(45, 36, 90);}</string>
                      </property>
                      <property name="title">
                       <string>Receiver Antenna Reference Point Correction</string>
                      </property>
                      <layout class="QGridLayout" name="gridLayout_78">
                       <property name="leftMargin">
                        <number>6</number>
                       </property>
                       <property name="topMargin">
                        <number>9</number>
                       </property>
                       <property name="rightMargin">
                        <number>6</number>
                       </property>
                       <property name="bottomMargin">
                        <number>6</number>
                       </property>
                       <property name="verticalSpacing">
                        <number>3</number>
                       </property>
                       <item row="0" column="0">
                        <widget class="QRadioButton" name="radioButtonARPspecify">
                         <property name="sizePolicy">
                          <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
                           <horstretch>0</horstretch>
                           <verstretch>0</verstretch>
                          </sizepolicy>
                         </property>
                         <property name="toolTip">
                          <string>&lt;b&gt;Specify receiver Antenna Reference Point&lt;/b&gt;&lt;br&gt;&lt;br&gt;Specify in North/East/Up components the receiver Antenna Reference Point.&lt;br&gt;&lt;br&gt;The Antenna Reference Point is the reference point where the station coordinates are referred to. If the receiver antenna is moved from this reference point, this correction allows to maintain the receiver coordinates unchanged (allowing, for instance, long term stability study of the receiver coordinates).&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTE:&lt;/b&gt; In DGNSS mode, reference station ARP will always be read from reference RTCM or RINEX file (if ARP correction is enabled).&lt;br&gt;</string>
                         </property>
                         <property name="styleSheet">
                          <string notr="true">color: rgb(0, 0, 0);</string>
                         </property>
                         <property name="text">
                          <string>Specify</string>
                         </property>
                        </widget>
                       </item>
                       <item row="0" column="1">
                        <widget class="QRadioButton" name="radioButtonARPread">
                         <property name="toolTip">
                          <string>&lt;b&gt;Read receiver Antenna Reference Point from RINEX&lt;/b&gt;&lt;br&gt;&lt;br&gt;Read the receiver Antenna Reference Point from the RINEX observation file. It seeks for the &lt;b&gt;ANTENNA: DELTA H/E/N&lt;/b&gt; RINEX header record.&lt;br&gt;&lt;br&gt;The Antenna Reference Point is the reference point where the station coordinates are referred to. If the receiver antenna is moved from this reference point, this correction allows to maintain the receiver coordinates unchanged (allowing, for instance, long term stability study of the receiver coordinates).&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTE:&lt;/b&gt; In DGNSS mode, reference station ARP will always be read from reference RTCM or RINEX file (if ARP correction is enabled).&lt;br&gt;</string>
                         </property>
                         <property name="styleSheet">
                          <string notr="true">color: rgb(0, 0, 0);</string>
                         </property>
                         <property name="text">
                          <string>Read from RINEX</string>
                         </property>
                         <property name="checked">
                          <bool>true</bool>
