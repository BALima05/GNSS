                        <item row="0" column="0">
                         <widget class="QGroupBox" name="groupBoxOrbitsComparisonMessages">
                          <property name="sizePolicy">
                           <sizepolicy hsizetype="Preferred" vsizetype="Fixed">
                            <horstretch>0</horstretch>
                            <verstretch>0</verstretch>
                           </sizepolicy>
                          </property>
                          <property name="font">
                           <font>
                            <pointsize>9</pointsize>
                            <weight>75</weight>
                            <bold>true</bold>
                           </font>
                          </property>
                          <property name="styleSheet">
                           <string notr="true">QGroupBox {color: rgb(45, 36, 90);}</string>
                          </property>
                          <property name="title">
                           <string>Orbits Comparison Messages</string>
                          </property>
                          <layout class="QGridLayout" name="gridLayout_111">
                           <property name="leftMargin">
                            <number>6</number>
                           </property>
                           <property name="topMargin">
                            <number>9</number>
                           </property>
