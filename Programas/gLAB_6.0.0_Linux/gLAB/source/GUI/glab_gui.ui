                                           <enum>Qt::StrongFocus</enum>
                                          </property>
                                          <item>
                                           <property name="text">
                                            <string>Fixed</string>
                                           </property>
                                          </item>
                                          <item>
                                           <property name="text">
                                            <string>Elevation</string>
                                           </property>
                                          </item>
                                          <item>
