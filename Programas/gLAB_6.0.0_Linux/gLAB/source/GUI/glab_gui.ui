                                  <bold>false</bold>
                                 </font>
                                </property>
                                <property name="toolTip">
                                 <string>&lt;b&gt;Carrier phase ambiguities&lt;/b&gt;&lt;br&gt;&lt;br&gt;Carrier phase ambiguities are the parameters which estimates the ambiguities of the carrier phase measurements (or combinations) used in the filter. Each epoch, there is one parameter for each satellite. Additionally, when a cycle-slip is detected, the carrier phase ambiguity is reset (by providing a new initial value and covariance). Typical values:&lt;ul&gt;&lt;li&gt;&lt;b&gt;A priori value:&lt;/b&gt; '0'&lt;/li&gt;&lt;li&gt;&lt;b&gt;Phi:&lt;/b&gt; '1'&lt;/li&gt;&lt;li&gt;&lt;b&gt;Process noise:&lt;/b&gt; '0'&lt;/li&gt;&lt;li&gt;&lt;b&gt;Initial covariance:&lt;/b&gt; '400' (equivalent to 20 metres in relation to the pseudorange measurement used to prealign the carrier phase).&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;</string>
                                </property>
                                <property name="styleSheet">
                                 <string notr="true">color: rgb(0, 0, 0);</string>
                                </property>
                                <property name="text">
                                 <string>Phase Ambiguities</string>
                                </property>
                               </widget>
                              </item>
                             </layout>
                            </widget>
                           </item>
                           <item row="5" column="0" colspan="6">
                            <widget class="QFrame" name="frameTroposphereParameters">
                             <property name="frameShape">
                              <enum>QFrame::NoFrame</enum>
                             </property>
                             <property name="frameShadow">
                              <enum>QFrame::Raised</enum>
