                             <item row="2" column="0">
                              <widget class="QLabel" name="label_272">
                               <property name="sizePolicy">
                                <sizepolicy hsizetype="Fixed" vsizetype="Preferred">
                                 <horstretch>0</horstretch>
                                 <verstretch>0</verstretch>
                                </sizepolicy>
                               </property>
                               <property name="minimumSize">
                                <size>
                                 <width>43</width>
                                 <height>0</height>
                                </size>
                               </property>
                               <property name="styleSheet">
                                <string notr="true">color: rgb(0, 0, 0);</string>
                               </property>
                               <property name="text">
                                <string>Clocks:</string>
                               </property>
                              </widget>
                             </item>
                             <item row="0" column="0" colspan="4">
                              <widget class="QLabel" name="label_279">
                               <property name="styleSheet">
                                <string notr="true">color: rgb(0, 0, 0);</string>
                               </property>
                               <property name="text">
                                <string>If  sample at 0h 0m is present in both days, select which one to use:</string>
                               </property>
                              </widget>
                             </item>
                             <item row="1" column="1" colspan="2" alignment="Qt::AlignLeft">
                              <widget class="QFrame" name="frame_30">
                               <property name="minimumSize">
                                <size>
                                 <width>191</width>
                                 <height>0</height>
                                </size>
                               </property>
                               <property name="frameShape">
                                <enum>QFrame::NoFrame</enum>
                               </property>
                               <property name="frameShadow">
                                <enum>QFrame::Raised</enum>
                               </property>
                               <layout class="QGridLayout" name="gridLayout_352">
                                <property name="leftMargin">
                                 <number>0</number>
                                </property>
                                <property name="topMargin">
                                 <number>0</number>
                                </property>
                                <property name="rightMargin">
                                 <number>0</number>
                                </property>
                                <property name="bottomMargin">
                                 <number>0</number>
                                </property>
                                <property name="verticalSpacing">
                                 <number>0</number>
                                </property>
                                <item row="0" column="0">
                                 <widget class="QRadioButton" name="radioButtonOrbitCurrentDay">
                                  <property name="toolTip">
                                   <string>&lt;b&gt;Current Day&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;This value is only valid for orbits obtained from &lt;b&gt;SP3&lt;/b&gt; files, as they require an interpolation.&lt;br&gt;When interpolating orbits from precise products, when using single day orbit files, at the beginning and at the end of the day, the interpolated value will have an additional error of few centimetres due to a non homogenous distribution (in time) of the samples used for interpolation (Runge effect). To avoid this effect, the user can introduce a concatenated orbit file from several days (ideally, from the previous and the following day), so gLAB can interpolate using always samples with homogenous distribution (when a concatenated file is introduced, gLAB will read the file using a sliding data window of three days).&lt;br&gt;In some orbit files (typically in MGEX files), the last sample given from one day is the sample at 0 hours and 0 minutes from the following day (i.e. the first sample from the next day). The problem is that this last sample has a similar (but not equal) value to the first sample of the next day (after concatenating an orbit files, this samples appears twice), therefore, depending on the sample used, the interpolation value will slightly vary during several hours (as orbit use a high interpolation degree, and date rate is typically of 15 minutes).&lt;br&gt;If this option is set, the first sample read (the one at the end of the current day), will be used for interpolation.&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTE:&lt;/b&gt; To see the Runge effect in the interpolation, the user can do a comparation of the same SP3 file, but using one concatenated and another without concatenation in the 'Compare Orbits &amp;amp; Clocks' mode of gLAB (in the menu Mode-&gt;Compare Orbits &amp;amp; Clocks).&lt;br&gt;</string>
                                  </property>
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>Current Day</string>
                                  </property>
                                 </widget>
                                </item>
                                <item row="0" column="1">
                                 <widget class="QRadioButton" name="radioButtonOrbitNextDay">
                                  <property name="toolTip">
                                   <string>&lt;b&gt;Next Day&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;This value is only valid for orbits obtained from &lt;b&gt;SP3&lt;/b&gt; files, as they require an interpolation.&lt;br&gt;When interpolating orbits from precise products, when using single day orbit files, at the beginning and at the end of the day, the interpolated value will have an additional error of few centimetres due to a non homogenous distribution (in time) of the samples used for interpolation (Runge effect). To avoid this effect, the user can introduce a concatenated orbit file from several days (ideally, from the previous and the following day), so gLAB can interpolate using always samples with homogenous distribution (when a concatenated file is introduced, gLAB will read the file using a sliding data window of three days).&lt;br&gt;In some orbit files (typically in MGEX files), the last sample given from one day is the sample at 0 hours and 0 minutes from the following day (i.e. the first sample from the next day). The problem is that this last sample has a similar (but not equal) value to the first sample of the next day (after concatenating an orbit files, this samples appears twice), therefore, depending on the sample used, the interpolation value will slightly vary during several hours (as orbit use a high interpolation degree, and date rate is typically of 15 minutes).&lt;br&gt;If this option is set, the second sample read (the one at the beginning of the next day), will be used for interpolation.&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTE:&lt;/b&gt; To see the Runge effect in the interpolation, the user can do a comparation of the same SP3 file, but using one concatenated and another without concatenation in the 'Compare Orbits &amp;amp; Clocks' mode of gLAB (in the menu Mode-&gt;Compare Orbits &amp;amp; Clocks).&lt;br&gt;</string>
                                  </property>
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>Next Day</string>
                                  </property>
                                 </widget>
                                </item>
                               </layout>
                              </widget>
                             </item>
                             <item row="2" column="1" alignment="Qt::AlignLeft">
                              <widget class="QFrame" name="frame_33">
                               <property name="minimumSize">
                                <size>
                                 <width>191</width>
                                 <height>0</height>
                                </size>
                               </property>
                               <property name="frameShape">
                                <enum>QFrame::NoFrame</enum>
                               </property>
                               <property name="frameShadow">
                                <enum>QFrame::Raised</enum>
                               </property>
                               <layout class="QGridLayout" name="gridLayout_353">
                                <property name="leftMargin">
                                 <number>0</number>
                                </property>
                                <property name="topMargin">
                                 <number>0</number>
                                </property>
                                <property name="rightMargin">
                                 <number>0</number>
                                </property>
                                <property name="bottomMargin">
                                 <number>0</number>
                                </property>
                                <property name="verticalSpacing">
                                 <number>0</number>
                                </property>
                                <item row="0" column="0">
                                 <widget class="QRadioButton" name="radioButtonClockCurrentDay">
                                  <property name="toolTip">
                                   <string>&lt;b&gt;Current Day&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;This value is only valid for clocks obtained from &lt;b&gt;SP3&lt;/b&gt; or &lt;b&gt;CLK&lt;/b&gt; files, as they require an interpolation.&lt;br&gt;When interpolating clocks from precise products, when using single day clock files, at the beginning and at the end of the day, the interpolated value will have an additional error of few centimetres due to a non homogenous distribution (in time) of the samples used for interpolation (Runge effect). To avoid this effect, the user can introduce a concatenated clock file from several days (ideally, from the previous and the following day), so gLAB can interpolate using always samples with homogenous distribution (when a concatenated file is introduced, gLAB will read the file using a sliding data window of three days).&lt;br&gt;In some clock files (typically in MGEX files), the last sample given from one day is the sample at 0 hours and 0 minutes from the following day (i.e. the first sample from the next day). The problem is that this last sample has a similar (but not equal) value to the first sample of the next day (after concatenating an orbit files, this samples appears twice), therefore, depending on the sample used, the interpolation value will slightly vary during some seconds or minutes (depending on the clock data rate).&lt;br&gt;If this option is set, the first sample read (the one at the end of the current day), will be used for interpolation.&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTE:&lt;/b&gt; To see the Runge effect in the interpolation, the user can do a comparation of the same SP3 file, but using one concatenated and another without concatenation in the 'Compare Orbits &amp;amp; Clocks' mode of gLAB (in the menu Mode-&gt;Compare Orbits &amp;amp; Clocks).&lt;br&gt;</string>
                                  </property>
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>Current Day</string>
                                  </property>
                                  <property name="autoExclusive">
                                   <bool>true</bool>
                                  </property>
                                 </widget>
                                </item>
                                <item row="0" column="1">
                                 <widget class="QRadioButton" name="radioButtonClockNextDay">
                                  <property name="toolTip">
                                   <string>&lt;b&gt;Next Day&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;This value is only valid for clocks obtained from &lt;b&gt;SP3&lt;/b&gt; or &lt;b&gt;CLK&lt;/b&gt; files, as they require an interpolation.&lt;br&gt;When interpolating clocks from precise products, when using single day clock files, at the beginning and at the end of the day, the interpolated value will have an additional error of few centimetres due to a non homogenous distribution (in time) of the samples used for interpolation (Runge effect). To avoid this effect, the user can introduce a concatenated clock file from several days (ideally, from the previous and the following day), so gLAB can interpolate using always samples with homogenous distribution (when a concatenated file is introduced, gLAB will read the file using a sliding data window of three days).&lt;br&gt;In some clock files (typically in MGEX files), the last sample given from one day is the sample at 0 hours and 0 minutes from the following day (i.e. the first sample from the next day). The problem is that this last sample has a similar (but not equal) value to the first sample of the next day (after concatenating an orbit files, this samples appears twice), therefore, depending on the sample used, the interpolation value will slightly vary during some seconds or minutes (depending on the clock data rate).&lt;br&gt;If this option is set, the second sample read (the one at the beginning of the next day), will be used for interpolation.&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTE:&lt;/b&gt; To see the Runge effect in the interpolation, the user can do a comparation of the same SP3 file, but using one concatenated and another without concatenation in the 'Compare Orbits &amp;amp; Clocks' mode of gLAB (in the menu Mode-&gt;Compare Orbits &amp;amp; Clocks).&lt;br&gt;</string>
                                  </property>
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>Next Day</string>
                                  </property>
                                  <property name="autoExclusive">
                                   <bool>true</bool>
                                  </property>
                                 </widget>
                                </item>
                               </layout>
                              </widget>
                             </item>
                            </layout>
                           </widget>
                          </item>
                         </layout>
                        </widget>
                       </item>
                      </layout>
                     </widget>
                    </item>
                    <item row="4" column="0">
                     <widget class="QGroupBox" name="groupBoxSbasOptions">
                      <property name="font">
                       <font>
                        <pointsize>9</pointsize>
                        <weight>75</weight>
                        <bold>true</bold>
                       </font>
                      </property>
                      <property name="styleSheet">
                       <string notr="true">QGroupBox {color: rgb(45, 36, 90);}</string>
                      </property>
                      <property name="title">
                       <string>SBAS Options (Using MOPS-D)</string>
                      </property>
                      <layout class="QGridLayout" name="gridLayout_120">
                       <property name="leftMargin">
                        <number>6</number>
                       </property>
                       <property name="topMargin">
                        <number>9</number>
                       </property>
                       <property name="rightMargin">
                        <number>6</number>
                       </property>
                       <property name="bottomMargin">
                        <number>6</number>
                       </property>
                       <property name="verticalSpacing">
                        <number>3</number>
                       </property>
                       <item row="1" column="1">
                        <widget class="QComboBox" name="comboBoxSbasNavigationMode">
                         <property name="minimumSize">
                          <size>
                           <width>180</width>
                           <height>0</height>
                          </size>
                         </property>
                         <property name="focusPolicy">
                          <enum>Qt::StrongFocus</enum>
                         </property>
                         <item>
                          <property name="text">
                           <string>Precision Approach</string>
                          </property>
                         </item>
                         <item>
                          <property name="text">
                           <string>Non Precision Approach</string>
                          </property>
                         </item>
                        </widget>
                       </item>
                       <item row="3" column="3">
                        <spacer name="horizontalSpacer_26">
                         <property name="orientation">
                          <enum>Qt::Horizontal</enum>
                         </property>
                         <property name="sizeHint" stdset="0">
                          <size>
                           <width>55</width>
                           <height>20</height>
                          </size>
                         </property>
                        </spacer>
                       </item>
                       <item row="5" column="0" colspan="4">
                        <widget class="QFrame" name="frameGEOmodeSwitch">
                         <property name="frameShape">
                          <enum>QFrame::NoFrame</enum>
                         </property>
                         <property name="frameShadow">
                          <enum>QFrame::Raised</enum>
                         </property>
                         <property name="lineWidth">
                          <number>0</number>
                         </property>
                         <layout class="QGridLayout" name="gridLayout_501">
                          <property name="leftMargin">
                           <number>0</number>
                          </property>
                          <property name="topMargin">
                           <number>0</number>
                          </property>
                          <property name="rightMargin">
                           <number>0</number>
                          </property>
                          <property name="bottomMargin">
                           <number>0</number>
                          </property>
                          <property name="verticalSpacing">
                           <number>5</number>
                          </property>
                          <item row="0" column="0">
                           <widget class="QCheckBox" name="checkBoxAllowMixedGEOdata">
                            <property name="toolTip">
                             <string>&lt;b&gt;Allow Mixed GEO Data&lt;/b&gt;&lt;br&gt;&lt;br&gt;Enable this option to allow during a GEO switching to select the GEO with the mixed data (a fake GEO in gLAB that uses data from all the GEO in the data file, that is, as if all data in the file was sent from the same GEO).&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTES:&lt;/b&gt;&lt;ul&gt;&lt;li&gt;If in &lt;i&gt;GEO Selection&lt;/i&gt; option &lt;i&gt;All Mixed&lt;/i&gt; is selected, this option is automatically enabled.&lt;/li&gt;&lt;li&gt;If this option enabled, it will not replace other GEO. For instance, if a SBAS data file contains GEOs 120 and 123, gLAB will have in memory data for GEO 120, 123 and 0 (the mixed one), thus allowing gLAB to switch between a nominal GEO and the mixed one (if GEO switching is enabled).&lt;/li&gt;&lt;li&gt;If option 'Select Best GEO' is enabled, this option will automatically be disabled.&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;</string>
                            </property>
                            <property name="styleSheet">
                             <string notr="true">color: rgb(0, 0, 0);</string>
                            </property>
                            <property name="text">
                             <string>Allow Mixed GEO Data</string>
                            </property>
                           </widget>
                          </item>
                          <item row="1" column="0">
                           <widget class="QCheckBox" name="checkBoxGEOswitching">
                            <property name="toolTip">
                             <string>&lt;b&gt;GEO Switching&lt;/b&gt;&lt;br&gt;&lt;br&gt;Enable GEO switching during the SBAS processing. The GEO switch will be triggered when any of these conditions are met:&lt;ul&gt;&lt;li&gt;An alarm for the current GEO is received, or an alarm for any GEO is received and data from mixed GEO is being used.&lt;/li&gt;&lt;li&gt;These three conditions are met:&lt;ul&gt;&lt;li&gt;Less than 4 satellites available to compute the navigation solution.&lt;/li&gt;&lt;li&gt;The number of satellites discarded by SBAS criteria plus the number of available satellites sum 4 or more (if satellites were discarded by non SBAS criteria, such as cycle-slips, switching GEOs will be useless).&lt;/li&gt;&lt;li&gt;Current GEO is not under acquisition time. Acquisition time is the time necessary to receive enough messages from a GEO for computing a navigation solution in PA mode (by default is 5 minutes). For example, at the beginning of the day, if we started receiving data from the GEO one second ago, no corrections wil be available.&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;/ul&gt;&lt;br&gt;When a GEO switch is triggered, GEOs which are under alarm or are under acquisition time (except if the current GEO received an alarm) will not be selected.&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTE:&lt;/b&gt; If both GEO and navigation switch are enabled, GEO switching will always have priority, as a GEO switch allows to maintain PA navigation mode.&lt;br&gt;</string>
                            </property>
                            <property name="styleSheet">
                             <string notr="true">color: rgb(0, 0, 0);</string>
                            </property>
                            <property name="text">
                             <string>GEO Switching</string>
                            </property>
                           </widget>
                          </item>
                          <item row="2" column="0">
                           <widget class="QCheckBox" name="checkBoxSelectBestGEO">
                            <property name="toolTip">
                             <string>&lt;b&gt;Select Best GEO&lt;/b&gt;&lt;br&gt;&lt;br&gt;When this option is enabled, gLAB will compute in each epoch the full SBAS model and the protection levels with all the GEOs available, and then select the best GEO according to the following criteria:&lt;ol&gt;&lt;li&gt;Select the GEOs which have PA solution with protection levels under the alarm limits, and from these ones, select the GEO whose sum of the horizontal and vertical protection levels is smaller.&lt;/li&gt;&lt;li&gt;If no GEOs had PA solution with protection levels under the alarm limits, select the GEOs with PA solution and then select the GEO whose sum of the horizontal and vertical protection levels is smaller.&lt;/li&gt;&lt;li&gt;If no GEOs had PA solution, select the GEOs with NPA solution and then select the GEO whose sum of the horizontal and vertical protection levels is smaller.&lt;/li&gt;&lt;/ol&gt;&lt;br&gt;&lt;b&gt;NOTES:&lt;/b&gt;&lt;ul&gt;&lt;li&gt;This option will noticeably increase computation load, specially if there are many GEOs in the SBAS data file.&lt;/li&gt;&lt;li&gt;If INFO messages are enabled (option 'Print INFO'), an INFO message with the epoch, GEO PRN and its protection levels will be printed for each iteration that provided a solution. The unselected iteration will have a '(Not selected)' text to indicate that it was not selected. The selected iteration will be printed last, with the text '(Selected)'.&lt;/li&gt;&lt;li&gt;If option 'Print SBASUNUSED' is enabled, the 'MODEL', 'SBASCORR', 'SBASVAR', 'SBASUNSEL' and 'SATSEL' messages for each discarded iteration will be printed. All messages from discarded iterations will have an '*' next to message name to indicate it was discarded. The iterations without solution will be printed first, and the last ones printed will be the iterations discarded but had solution.&lt;/li&gt;&lt;li&gt;	When this option is set, the options 'GEO Switching' will be automatically set. Moreover, option 'Switching Cooltime:' must be set to 0 (if not set, it will be automatically set to 0), as in an epoch multiple GEO changes will be done, and also, 'Allow Mixed GEO Data' option must be disabled.&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;</string>
                            </property>
                            <property name="styleSheet">
                             <string notr="true">color: rgb(0, 0, 0);</string>
                            </property>
                            <property name="text">
                             <string>Select Best GEO</string>
                            </property>
                           </widget>
                          </item>
                          <item row="3" column="0">
                           <widget class="QCheckBox" name="checkBoxNavigationModeSwitching">
                            <property name="toolTip">
                             <string>&lt;b&gt;Navigation Mode Switching&lt;/b&gt;&lt;br&gt;&lt;br&gt;Enable switching between PA and NPA navigation modes during the SBAS processing. &lt;b&gt;Navigation mode switching will only take effect if initial navigation mode is PA&lt;/b&gt;. The navigation mode switch will be triggered when any of these conditions are met:&lt;ul&gt;&lt;li&gt;An alarm for the current GEO is received, or an alarm for any GEO is received and data from mixed GEO is being used.&lt;/li&gt;&lt;li&gt;These three conditions are met:&lt;ul&gt;&lt;li&gt;Less than 4 satellites available to compute the navigation solution.&lt;/li&gt;&lt;li&gt;The number of satellites discarded by SBAS criteria plus the number of available satellites sum 4 or more (if satellites were discarded by non SBAS criteria, such as cycle-slips, switching navigation mode will be useless).&lt;/li&gt;&lt;li&gt;GEO switching is disabled or no other GEO is available.&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;/ul&gt;&lt;br&gt;&lt;b&gt;NOTE:&lt;/b&gt; After a navigation mode switch to NPA, gLAB will try to go back to PA mode as soon as possible.&lt;br&gt;</string>
                            </property>
                            <property name="styleSheet">
                             <string notr="true">color: rgb(0, 0, 0);</string>
                            </property>
                            <property name="text">
                             <string>Navigation Mode Switching</string>
                            </property>
                           </widget>
                          </item>
                         </layout>
                        </widget>
                       </item>
                       <item row="6" column="0">
                        <widget class="QLabel" name="label_94">
                         <property name="toolTip">
                          <string>&lt;b&gt;Airborne Receiver Type&lt;/b&gt;&lt;br&gt;&lt;br&gt;Set the receiver type in order to compute its &amp;sigma;&lt;sub&gt;i,air&lt;/sub&gt; for each satellite . The receiver types available are:&lt;ul&gt;&lt;li&gt;&lt;b&gt;Class 1:&lt;/b&gt;  &amp;sigma;&lt;sub&gt;i,air&lt;/sub&gt; = 5 metres.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Class 2, 3, 4:&lt;/b&gt; The &amp;sigma;&lt;sub&gt;i,air&lt;/sub&gt; is divided in three components:&lt;ul&gt;&lt;li&gt;&lt;b&gt;&amp;sigma;&lt;sub&gt;multipath&lt;/sub&gt;:&lt;/b&gt; This is the sigma to account for multipath error. It is computed with the following formula:&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;sigma;&lt;sub&gt;multipath&lt;/sub&gt;[i] = 0.13 + 0.53·e&lt;sup&gt;(-&amp;theta;[i]/10)&lt;/sup&gt; (metres)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;theta;[i] is the satellite elevation (in degrees).&lt;br&gt;&lt;/li&gt;&lt;li&gt;&lt;b&gt;&amp;sigma;&lt;sub&gt;divergence&lt;/sub&gt;:&lt;/b&gt; This is the sigma to account for possible biases and ionospheric divergence in the receiver. MOPS does not provide any formula to compute this sigma (it is left to the receiver manufactarer).&lt;/li&gt;&lt;li&gt;&lt;b&gt;&amp;sigma;&lt;sub&gt;noise&lt;/sub&gt;:&lt;/b&gt; This is the sigma to account for noise and signals conditions in the receiver. MOPS does not provide any formula to compute this sigma (it is left to the receiver manufactarer).&lt;/li&gt;&lt;/ul&gt;&lt;br&gt;MOPS does provide upper and lower bounds for &amp;sigma;&lt;sub&gt;divergence&lt;/sub&gt; and &amp;sigma;&lt;sub&gt;noise&lt;/sub&gt;. gLAB will use the upper bound for these sigmas (which is the worst case). The upper bounds in MOPS for GPS and SBAS GEOs are:&lt;ul&gt;&lt;li&gt;GPS satellites:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(&amp;sigma;&lt;sup&gt;2&lt;/sup&gt;&lt;sub&gt;divergence&lt;/sub&gt; + &amp;sigma;&lt;sup&gt;2&lt;/sup&gt;&lt;sub&gt;noise&lt;/sub&gt;)&lt;sup&gt;1/2&lt;/sup&gt; &amp;le; 0.36 (metres)&lt;br&gt;&lt;/li&gt;&lt;li&gt;SBAS GEO satellites:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(&amp;sigma;&lt;sup&gt;2&lt;/sup&gt;&lt;sub&gt;divergence&lt;/sub&gt; + &amp;sigma;&lt;sup&gt;2&lt;/sup&gt;&lt;sub&gt;noise&lt;/sub&gt;)&lt;sup&gt;1/2&lt;/sup&gt; &amp;le; 1.8 (metres)&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;Therefore, the values for the sigmas applied in gLAB will be:&lt;ul&gt;&lt;li&gt;GPS satellites:&lt;ul&gt;&lt;li&gt;&amp;sigma;&lt;sub&gt;divergence&lt;/sub&gt; = 0&lt;/li&gt;&lt;li&gt;&amp;sigma;&lt;sub&gt;noise&lt;/sub&gt; = 0.36 (metres)&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li&gt;SBAS GEO satellites:&lt;ul&gt;&lt;li&gt;&amp;sigma;&lt;sub&gt;divergence&lt;/sub&gt; = 0&lt;/li&gt;&lt;li&gt;&amp;sigma;&lt;sub&gt;noise&lt;/sub&gt; = 1.8 (metres)&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;/ul&gt;The total sigma of a class 2, 3, 4 receiver will be:&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;sigma;&lt;sub&gt;i,air&lt;/sub&gt; = (&amp;sigma;&lt;sup&gt;2&lt;/sup&gt;&lt;sub&gt;multipath&lt;/sub&gt;[i] + &amp;sigma;&lt;sup&gt;2&lt;/sup&gt;&lt;sub&gt;divergence&lt;/sub&gt; + &amp;sigma;&lt;sup&gt;2&lt;/sup&gt;&lt;sub&gt;noise&lt;/sub&gt;)&lt;sup&gt;1/2&lt;/sup&gt; (metres)&lt;br&gt;&lt;/li&gt;&lt;li&gt;&lt;b&gt;User defined:&lt;/b&gt; Let the user define its own receiver sigmas. The user defined receiver will have the same sigma components as a class 2 receiver, and gLAB will use the same default values as the class 2 if any of its components is not defined.&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;</string>
                         </property>
                         <property name="styleSheet">
                          <string notr="true">color: rgb(0, 0, 0);</string>
                         </property>
                         <property name="text">
                          <string>Airborne Receiver Type</string>
                         </property>
                        </widget>
                       </item>
                       <item row="6" column="1">
                        <widget class="QComboBox" name="comboBoxAirboneReceiverType">
                         <property name="minimumSize">
                          <size>
                           <width>170</width>
                           <height>0</height>
                          </size>
                         </property>
