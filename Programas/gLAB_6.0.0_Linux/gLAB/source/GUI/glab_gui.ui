                     <item row="0" column="4">
                      <widget class="QCheckBox" name="checkBox_ems">
                       <property name="minimumSize">
                        <size>
                         <width>0</width>
                         <height>25</height>
                        </size>
                       </property>
                       <property name="toolTip">
                        <string>&lt;b&gt;EMS&lt;/b&gt;&lt;br&gt;&lt;br&gt;Write SBAS messages in EMS format. For SBAS 1F data, EMS 2.0 format will be used, while for SBAS DFMC data Multi-band EMS format will be used (note that Multi-band EMS format is backward compatible with EMS 2.0).&lt;br&gt;&lt;br&gt;EMS 2.0 format description can be found at &lt;font color='#0000FF'&gt;http://www.egnos-pro.esa.int/ems/EMS_UID_2_0.pdf&lt;/font&gt;&lt;br&gt;&lt;br&gt;Multi-band EMS format description can be found at &lt;font color='#0000FF'&gt;http://www.egnos-pro.esa.int/ems/EMS_UID_Multi-band.pdf&lt;/font&gt;&lt;br&gt;</string>
                       </property>
                       <property name="styleSheet">
                        <string notr="true">color: rgb(0, 0, 0);</string>
                       </property>
                       <property name="text">
                        <string>EMS</string>
                       </property>
                      </widget>
                     </item>
                     <item row="0" column="1">
                      <widget class="QCheckBox" name="checkBox_rinexb">
                       <property name="minimumSize">
                        <size>
                         <width>0</width>
                         <height>25</height>
                        </size>
                       </property>
                       <property name="toolTip">
                        <string>&lt;b&gt;RINEX-B&lt;/b&gt;&lt;br&gt;&lt;br&gt;Write SBAS(both 1F and DFMC) messages in RINEX-B format.&lt;br&gt;RINEX-B format description can be found at &lt;font color='#0000FF'&gt;ftp://ftp.igs.org/pub/data/format/geo_sbas.txt&lt;/font&gt;&lt;br&gt;</string>
                       </property>
                       <property name="styleSheet">
                        <string notr="true">color: rgb(0, 0, 0);</string>
                       </property>
                       <property name="text">
                        <string>RINEX-B</string>
                       </property>
                      </widget>
                     </item>
                     <item row="0" column="7">
                      <widget class="QCheckBox" name="checkBox_pegasus">
                       <property name="minimumSize">
                        <size>
                         <width>0</width>
                         <height>25</height>
                        </size>
                       </property>
                       <property name="toolTip">
                        <string>&lt;b&gt;Pegasus&lt;/b&gt;&lt;br&gt;&lt;br&gt;Write SBAS messages in Pegasus format. Pegasus is the Eurocontrol propietary software for computing solution using SBAS and GBAS augmentation systems.&lt;br&gt;The advantage of Pegasus format is that corrections are written in decimal format and in several columnar text files (according to message types), thus it is human readable.&lt;br&gt;An obsolete&lt;sup&gt;1&lt;/sup&gt; Pegasus format description can be found at &lt;font color='#0000FF'&gt;https://www.icao.int/Meetings/AMC/MA/2004/GNSS/icd.pdf&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;sup&gt;1&lt;/sup&gt;In the ICD at the given link, the file format description is valid, but not the header name records.&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTE:&lt;/b&gt; Pegasus format only supports SBAS 1F messages (SBAS DFMC messages will be skipped for this format).</string>
                       </property>
                       <property name="styleSheet">
                        <string notr="true">color: rgb(0, 0, 0);</string>
                       </property>
                       <property name="text">
                        <string>Pegasus</string>
                       </property>
                      </widget>
                     </item>
                    </layout>
                   </widget>
                  </item>
                  <item row="2" column="0">
                   <widget class="QLabel" name="label_244">
                    <property name="minimumSize">
                     <size>
                      <width>0</width>
                      <height>25</height>
                     </size>
                    </property>
                    <property name="toolTip">
                     <string>&lt;b&gt;Output formats:&lt;/b&gt;&lt;br&gt;&lt;br&gt;Select the output formats for conversion. More than one format can be selected at once. &lt;br&gt;</string>
                    </property>
                    <property name="styleSheet">
                     <string notr="true">color: rgb(0, 0, 0);</string>
                    </property>
                    <property name="text">
                     <string>Output formats:</string>
                    </property>
                   </widget>
                  </item>
                 </layout>
                 <zorder>frameConverterSBASOutputTypes</zorder>
                 <zorder>lineEdit_convert_sbas</zorder>
                 <zorder>labelConvOutputPath</zorder>
                 <zorder>pushButton_output_path_sbas</zorder>
                 <zorder>labelConvSbasFile</zorder>
                 <zorder>lineEdit_outputpath_sbas</zorder>
                 <zorder>pushButton_convert_sbas</zorder>
                 <zorder>label_244</zorder>
                </widget>
               </item>
              </layout>
             </widget>
            </item>
           </layout>
