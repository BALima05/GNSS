                            <horstretch>0</horstretch>
                            <verstretch>0</verstretch>
                           </sizepolicy>
                          </property>
                          <property name="font">
                           <font>
                            <pointsize>9</pointsize>
                            <weight>75</weight>
                            <bold>true</bold>
                           </font>
                          </property>
                          <property name="styleSheet">
                           <string notr="true">QGroupBox {color: rgb(45, 36, 90);}</string>
                          </property>
                          <property name="title">
                           <string>SBAS Messages</string>
                          </property>
                          <layout class="QGridLayout" name="gridLayout_109">
                           <property name="leftMargin">
                            <number>6</number>
                           </property>
                           <property name="topMargin">
                            <number>9</number>
                           </property>
                           <property name="rightMargin">
                            <number>6</number>
                           </property>
                           <property name="bottomMargin">
                            <number>6</number>
                           </property>
                           <property name="verticalSpacing">
                            <number>3</number>
                           </property>
                           <item row="0" column="0">
                            <widget class="QFrame" name="frame_17">
                             <property name="sizePolicy">
                              <sizepolicy hsizetype="Preferred" vsizetype="Fixed">
                               <horstretch>0</horstretch>
                               <verstretch>0</verstretch>
                              </sizepolicy>
                             </property>
                             <property name="frameShape">
                              <enum>QFrame::NoFrame</enum>
                             </property>
                             <property name="frameShadow">
                              <enum>QFrame::Raised</enum>
                             </property>
                             <layout class="QGridLayout" name="gridLayout_113">
                              <property name="leftMargin">
                               <number>0</number>
                              </property>
                              <property name="topMargin">
                               <number>0</number>
                              </property>
                              <property name="rightMargin">
                               <number>0</number>
                              </property>
                              <property name="bottomMargin">
                               <number>0</number>
                              </property>
                              <item row="0" column="0">
                               <widget class="QPushButton" name="pushButtonSbasMessagesAll">
                                <property name="toolTip">
                                 <string>Select all output messages.</string>
                                </property>
                                <property name="text">
                                 <string>All</string>
                                </property>
                               </widget>
                              </item>
                              <item row="0" column="1">
                               <widget class="QPushButton" name="pushButtonSbasMessagesNone">
                                <property name="toolTip">
                                 <string>Unselect all output messages.</string>
                                </property>
                                <property name="text">
                                 <string>None</string>
                                </property>
                               </widget>
                              </item>
                             </layout>
                            </widget>
                           </item>
                           <item row="4" column="0">
                            <widget class="QCheckBox" name="checkBoxPrintSbasunsel">
                             <property name="toolTip">
                              <string>&lt;b&gt;SBASUNSEL messages (SBAS 1F processing mode) &lt;/b&gt;&lt;br/&gt;&lt;br/&gt;SBAS satellite unselection message. When a satellite is discarded due to MOPS criteria, this message details the reason. All time tags are in GPS time.&lt;br/&gt;
&lt;table&gt;&lt;tr&gt;&lt;td&gt;&lt;ul&gt;
&lt;li&gt;&lt;b&gt;Field 1:&lt;/b&gt; 'SBASUNSEL' &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 2:&lt;/b&gt; Year &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 3:&lt;/b&gt; DoY &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 4:&lt;/b&gt; Seconds of day &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 5:&lt;/b&gt; Time of day &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 6:&lt;/b&gt; GNSS System &lt;/li&gt;
&lt;/ul&gt;&lt;/td&gt;&lt;td&gt;&lt;ul&gt;
&lt;li&gt;&lt;b&gt;Field 7:&lt;/b&gt; PRN satellite identifier &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 8:&lt;/b&gt; SBAS processing mode (PA or NPA) &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 9:&lt;/b&gt; GEO PRN from which SBAS corrections are used ('0' means all GEOs) &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 10:&lt;/b&gt; Error code &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 11:&lt;/b&gt; &quot;Discard reason&quot; &lt;/li&gt;
&lt;/ul&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;
&lt;br/&gt;&lt;br/&gt;
&lt;b&gt;Sample: &lt;/b&gt; SBASUNSEL   2019 026  4102.00 01:08:22.00 GPS  26  PA 136 15 &quot;Satellite flagged as 'Do not use' (UDREI=15)&quot;
&lt;br/&gt;&lt;br/&gt;
The error code in field 10 is a number which identifies the discard reason with a range from 1 to 48. Useful for parsing purposes. Field 11 will be always between quotes in order to ease parsing purposes. Fields 10 and 11 may have the following values:&lt;br/&gt;
&lt;table&gt;&lt;tr&gt;&lt;td&gt;&lt;ul&gt;
&lt;li&gt;&lt;b&gt;1:&lt;/b&gt; &quot;No GEO satellites available&quot;&lt;/li&gt;
&lt;li&gt;&lt;b&gt;2:&lt;/b&gt; &quot;No data for user selected GEO&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;3:&lt;/b&gt; &quot;Not enough almanac or GEO navigation message to determine the GEO with highest elevation&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;4:&lt;/b&gt; &quot;Received alarm message for current GEO at epoch &amp;lt;YYYY DoY SoD&amp;gt;. Time remaining to finish alarm: &amp;lt;seconds&amp;gt; seconds&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;5:&lt;/b&gt; &quot;Received &amp;lt;value&amp;gt; consecutive messages with errors (UDREI data has been forced to timeout) [PA only]&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;6:&lt;/b&gt; &quot;Missed &amp;lt;value&amp;gt; consecutive messages&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;7:&lt;/b&gt; &quot;No PRN mask&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;8:&lt;/b&gt; &quot;PRN mask timed out&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;9:&lt;/b&gt; &quot;Satellite is not monitored in any of the PRN mask available&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;10:&lt;/b&gt; &quot;No message type 10 available [PA only]&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;11:&lt;/b&gt; &quot;Message type 10 timed out [PA only]&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;12:&lt;/b&gt; &quot;No fast correction data received for current PRN [PA only]&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;13:&lt;/b&gt; &quot;Sigma UDRE timed out [PA only]&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;14:&lt;/b&gt; &quot;Satellite flagged as 'Not monitored' (UDREI=14)&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;15:&lt;/b&gt; &quot;Satellite flagged as 'Do not use' (UDREI=15)&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;16:&lt;/b&gt; &quot;Satellite has an UDREI value of &amp;lt;value&amp;gt; [PA only] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;17:&lt;/b&gt; &quot;No fast correction degradation data [PA only]&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;18:&lt;/b&gt; &quot;Fast correction degradation data timed out [PA only]&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;19:&lt;/b&gt; &quot;Last PRC received timed out [PA only]&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;20:&lt;/b&gt; &quot;Only one PRC received. RRC calculation not possible [PA only]&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;21:&lt;/b&gt; &quot;RRC timed out (under alarm condition) due to time difference between PRC used [PA only]&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;22:&lt;/b&gt; &quot;RRC timed out (under alarm condition) due to excessive PRC propagation in time [PA only]&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;23:&lt;/b&gt; &quot;RRC timed out due to time difference between PRC used [PA only]&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;24:&lt;/b&gt; &quot;RRC timed out due to excessive PRC propagation in time [PA only]&quot; &lt;/li&gt;
&lt;/ul&gt;&lt;/td&gt;&lt;td&gt;&lt;ul&gt;
&lt;li&gt;&lt;b&gt;25:&lt;/b&gt; &quot;Service message timed out [PA only]&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;26:&lt;/b&gt; &quot;Not received a full set of service messages with the same IODS [PA only]&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;27:&lt;/b&gt; &quot;No clock-ephemeris covariance matrix data for current satellite [PA only]&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;28:&lt;/b&gt; &quot;Clock-ephemeris covariance matrix data timed out [PA only]&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;29:&lt;/b&gt; &quot;No navigation data for ranging GEO&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;30:&lt;/b&gt; &quot;Ranging GEO navigation data timed out&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;31:&lt;/b&gt; &quot;URA index value of &amp;lt;value&amp;gt; for ranging GEO satellite&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;32:&lt;/b&gt; &quot;No long term correction data for current satellite [PA only]&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;33:&lt;/b&gt; &quot;Long term correction data timed out [PA only]&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;34:&lt;/b&gt; &quot;Long term correction data timed out [PA only]&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;35:&lt;/b&gt; &quot;No broadcast block available for current satellite (regardless of SBAS IOD) [NPA only]&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;36:&lt;/b&gt; &quot;No broadcast block available for current satellite (regardless of SBAS IOD) [NPA only]&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;37:&lt;/b&gt; &quot;No broadcast block available for current satellite (regardless of SBAS IOD) [NPA only]&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;38:&lt;/b&gt; &quot;Ionospheric grid mask timed out [PA only]&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;39:&lt;/b&gt; &quot;Ionospheric grid mask timed out [PA only]&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;40:&lt;/b&gt; &quot;Not enough IGPs available in ionospheric grid mask [PA only]&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;41:&lt;/b&gt; &quot;One IGP is set as don't use [PA only]&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;42:&lt;/b&gt; &quot;One or more IGPs is set as not monitored or has timed out [PA only]&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;43:&lt;/b&gt; &quot;Data not available for one or more IGPs [PA only]&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;44:&lt;/b&gt; &quot;Ionospheric pierce point is outside triangle [PA only]&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;45:&lt;/b&gt; &quot;External ionosphere model not available&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;46:&lt;/b&gt; &quot;Satellite has an UDREI value of &amp;lt;value&amp;gt; (user threshold is &lt;value&gt;)&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;47:&lt;/b&gt; &quot;Satellite is not in view (elevation &amp;lt;value&amp;gt; degrees)&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;48:&lt;/b&gt; &quot;Satellite elevation (&amp;lt;value&amp;gt; degrees) is too low&quot; &lt;/li&gt;
&lt;/ul&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;
&lt;br/&gt;&lt;br/&gt;
Error code number 45 will only appear if user has selected another ionosphere model for SBAS processing.&lt;br/&gt;
Error codes number 46 and 47 will only appear in SBAS plots mode.</string>
                             </property>
                             <property name="styleSheet">
                              <string notr="true">color: rgb(0, 0, 0);</string>
                             </property>
                             <property name="text">
                              <string>Print SBASUNSEL</string>
                             </property>
                            </widget>
                           </item>
                           <item row="5" column="0">
                            <widget class="QCheckBox" name="checkBoxPrintSbasDFMCCor">
                             <property name="toolTip">
                              <string>&lt;b&gt;SBASDFMCCORR messages (SBAS DFMC processing mode)&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;SBAS corrections breakdown. It is shown when a model can be fully computed using SBAS DFMC corrections with iono-free measurements. Messages will be sorted by constellation, with this order: GPS, Galileo, GLONASS, GEO, BeiDou, QZSS, IRNSS. All time tags are in GPS time.&lt;br/&gt;
&lt;table&gt;&lt;tr&gt;&lt;td&gt;&lt;ul&gt;
&lt;li&gt;&lt;b&gt;Field 1:&lt;/b&gt; 'SBASDFMCCORR' &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 2:&lt;/b&gt; Year &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 3:&lt;/b&gt; DoY &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 4:&lt;/b&gt; Seconds of day &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 5:&lt;/b&gt; Time of day &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 6:&lt;/b&gt; GNSS System (GPS, GAL, GLO, GEO or BDS) &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 7:&lt;/b&gt; PRN satellite identifier &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 8:&lt;/b&gt; Satellite block type &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 9:&lt;/b&gt; SVN (Space Vehicle Number) &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 10:&lt;/b&gt; Arc number &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 11:&lt;/b&gt; Arc length &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 12:&lt;/b&gt; Satellite elevation [degrees] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 13:&lt;/b&gt; Satellite azimuth [degrees] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 14:&lt;/b&gt; (GPS, GAL, GLO, GEO or BDS) &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 15:&lt;/b&gt; GEO PRN from which SBAS corrections are used ('0' means all GEOs) &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 16:&lt;/b&gt; Measurement identifier (as string) &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 17:&lt;/b&gt; Measurement identifier for smoothing (as string) &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 18:&lt;/b&gt; Measurement-model value (prefit) [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 19:&lt;/b&gt; Measurement value without smoothing [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 20:&lt;/b&gt; Measurement value with smoothing [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 21:&lt;/b&gt; Satellite-receiver geometric distance (with SBAS corrections) [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 22:&lt;/b&gt; Relativity correction (with SBAS corrections) [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 23:&lt;/b&gt; Satellite clock correction (with SBAS corrections) [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 24:&lt;/b&gt; GPS LNAV TGD (Total Group Delay) correction [L1 m] &lt;/li&gt;
&lt;/ul&gt;&lt;/td&gt;&lt;td&gt;&lt;ul&gt;
&lt;li&gt;&lt;b&gt;Field 25:&lt;/b&gt; Troposphere nominal correction [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 26:&lt;/b&gt; X component of the satellite position in WGS84 system at emission time with SBAS corrections [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 27:&lt;/b&gt; Y component of the satellite position in WGS84 system at emission time with SBAS corrections [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 28:&lt;/b&gt; Z component of the satellite position in WGS84 system at emission time with SBAS corrections [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 29:&lt;/b&gt; Correction to be applied to the X component of the satellite [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 30:&lt;/b&gt; Correction to be applied to the Y component of the satellite [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 31:&lt;/b&gt; Correction to be applied to the Z component of the satellite [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 32:&lt;/b&gt; Correction to be applied to the satellite clock [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 33:&lt;/b&gt; DFREI (Dual Frequency Residual Error Indicator) for the current satellite &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 34:&lt;/b&gt; Time (seconds of day) of last DFREI received [s] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 35:&lt;/b&gt; Time (seconds of day) of last MT32 received [s] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 36:&lt;/b&gt; Time (seconds of day) of last MT39/40 pair received [s] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 37:&lt;/b&gt; Validity time of MT32 [s] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 38:&lt;/b&gt; Validity time of MT39/40 message pair [s] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 39:&lt;/b&gt; IODM (Issue of Data Mask) used for corrections &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 40:&lt;/b&gt; IODN (Issue of Data Navigation) for non GEO satellites or IODG (Issue of Data GEO) for GEO satellites &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 41:&lt;/b&gt; Slot Number in PRN mask &lt;/li&gt;
&lt;/ul&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;
&lt;br/&gt;&lt;br/&gt;
&lt;b&gt;Sample: &lt;/b&gt; SBASDFMCCORR    2019 183   366.00 00:06:06.00 GAL  12 GALILEO-1        102   1    367   56.240 -131.144  PA 122 PC15-C1C-C5Q LC15-L1C-L5Q    -77661.5914  22118290.4022  22118290.5451  24090622.3075    -0.2348  -1894344.7968     0.0000     2.8714   1063555.2596  20678074.5523 -21146925.6105   0.5000  -0.1250  -0.0625   1.5938  6   365.12   331.12    -1.00   240.00     0.00 0   30  86
&lt;br/&gt;&lt;br/&gt;
When the '*' appears in field 1, it is due to smoothed code of the satellite has not reached steady-state, a SBAS processing mode switch or SBAS GEO switch. When a mode or GEO switch occurs, the SBAS corrections have to be computed again.&lt;br/&gt;
If no smoothing is enabled, field 17 will be a dash ('-')&lt;br/&gt;
Field 24 will be 0 for non GPS satellites, as TGD is only applied in GPS constellation.&lt;br/&gt;
Field 35 will be -1 when ranging satellite is the same as the GEO providing the corrections.&lt;br/&gt;
Field 36 will be -1 when ranging satellite is not a GEO satellite.&lt;br/&gt;
Field 37 will be 0 when ranging satellite is the same as the GEO providing the corrections.&lt;br/&gt;
Field 38 will be 0 when ranging satellite is not a GEO satellite.
Field 40 is the IODE value from the broadcast message matched with the SBAS corrections.</string>
                             </property>
                             <property name="styleSheet">
                              <string notr="true">color: rgb(0, 0, 0);</string>
                             </property>
                             <property name="text">
                              <string>Print SBASDFMCCORR</string>
                             </property>
                            </widget>
                           </item>
                           <item row="15" column="0">
                            <widget class="QCheckBox" name="checkBoxPrintSbasunused">
                             <property name="toolTip">
                              <string>&lt;b&gt;SBASUNUSED messages  (SBAS 1F/DFMC processing mode)&lt;/b&gt;&lt;br&gt;&lt;br&gt;
Print messages from discarded satellites due to SBAS GEO switch (only for SBAS 1F and DFMC).&lt;br&gt;
The discarded messages are MODEL, SBASCORR, SBASVAR, SBASIONO and SBASUNSEL, but only the ones selected from user parameters will be printed. Also, an asterisk '*' will be added at the end of the first field to indicate that it is a discarded measurement.</string>
                             </property>
                             <property name="styleSheet">
                              <string notr="true">color: rgb(0, 0, 0);</string>
                             </property>
                             <property name="text">
                              <string>Print SBASUNUSED</string>
                             </property>
                            </widget>
                           </item>
                           <item row="2" column="0">
                            <widget class="QCheckBox" name="checkBoxPrintSbasvar">
                             <property name="toolTip">
                              <string>&lt;b&gt;SBASVAR messages (SBAS 1F processing mode)&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;SBAS variance contributions breakdown. It is shown when a model can be fully computed using SBAS corrections for GPS C1C measurement. All time tags are in GPS time.&lt;br/&gt;
&lt;table&gt;&lt;tr&gt;&lt;td&gt;&lt;ul&gt;
&lt;li&gt;&lt;b&gt;Field 1:&lt;/b&gt; 'SBASVAR' &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 2:&lt;/b&gt; Year &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 3:&lt;/b&gt; DoY &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 4:&lt;/b&gt; Seconds of day &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 5:&lt;/b&gt; Time of day &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 6:&lt;/b&gt; GNSS System &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 7:&lt;/b&gt; PRN satellite identifier &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 8:&lt;/b&gt; Satellite block type &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 9:&lt;/b&gt; SVN (Space Vehicle Number) &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 10:&lt;/b&gt; Arc number &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 11:&lt;/b&gt; Arc length &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 12:&lt;/b&gt; Satellite elevation [degrees] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 13:&lt;/b&gt; Satellite azimuth [degrees] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 14:&lt;/b&gt; SBAS processing mode (PA or NPA) &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 15:&lt;/b&gt; GEO PRN from which SBAS corrections are used ('0' means all GEOs) &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 16:&lt;/b&gt; Sigma of the total residual error associated to the satellite [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 17:&lt;/b&gt; Sigma of the residual error associated to the fast and long-term corrections [m] &lt;/li&gt;
&lt;/ul&gt;&lt;/td&gt;&lt;td&gt;&lt;ul&gt;
&lt;li&gt;&lt;b&gt;Field 18:&lt;/b&gt; Sigma of the UDRE [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 19:&lt;/b&gt; Delta UDRE (User Differential Range Error) factor &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 20:&lt;/b&gt; Data source (SBAS message type number) for Delta UDRE &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 21:&lt;/b&gt; Degradation parameter for fast correction data [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 22:&lt;/b&gt; Degradation parameter for range rate correction data [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 23:&lt;/b&gt; Degradation parameter for long term correction data or GEO navigation message data [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 24:&lt;/b&gt; Degradation parameter for en route through NPA applications [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 25:&lt;/b&gt; RSS (Root-Sum-Square) flag in message type 10 &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 26:&lt;/b&gt; Sigma of the residual error associated to the ionosheric corrections [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 27:&lt;/b&gt; Sigma of the residual error associated to the tropospheric corrections [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 28:&lt;/b&gt; Sigma of the total receiver error [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 29:&lt;/b&gt; Sigma of the receiver noise [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 30:&lt;/b&gt; Sigma of the receiver multipath [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 31:&lt;/b&gt; Sigma of the receiver divergence [m] &lt;/li&gt;
&lt;/ul&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;
&lt;br/&gt;&lt;br/&gt;
&lt;b&gt;Sample: &lt;/b&gt; SBASVAR     2019 025 85862.00 23:51:02.00 GPS   8 BLOCK_IIF         72   1    363   29.725  -64.905  PA 136         1.8196         1.0975         0.9119    1.000  27         0.1856         0.0000         0.0000         0.0000 0         1.3762         0.2413         0.3928    0.360    0.157    0.000
&lt;br/&gt;&lt;br/&gt;
The data source indicator for Delta UDRE in field 20 may have the following values:&lt;br/&gt;
&lt;table&gt;&lt;tr&gt;&lt;td&gt;&lt;ul&gt;
&lt;li&gt;&lt;b&gt;27 or 28:&lt;/b&gt; for their respective message type &lt;/li&gt;
&lt;li&gt;&lt;b&gt;0:&lt;/b&gt; if no message type received or both received &lt;/li&gt;
&lt;/ul&gt;&lt;/td&gt;&lt;td&gt;&lt;ul&gt;
&lt;li&gt;&lt;b&gt;27 or 28:&lt;/b&gt; if received any of these message types but there was missing data for current satellite or was timed out &lt;/li&gt;
&lt;/ul&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;
&lt;br/&gt;&lt;br/&gt;
When the '*' appears in field 1, it is due to smoothed code of the satellite has not reached steady-state, a SBAS processing mode switch or SBAS GEO switch. When a mode or GEO switch occurs, the SBAS corrections have to be computed again.</string>
                             </property>
                             <property name="styleSheet">
                              <string notr="true">color: rgb(0, 0, 0);</string>
                             </property>
                             <property name="text">
                              <string>Print SBASVAR</string>
                             </property>
                            </widget>
                           </item>
                           <item row="6" column="0">
                            <widget class="QCheckBox" name="checkBoxPrintSbasDFMCVar">
                             <property name="toolTip">
                              <string>&lt;b&gt;SBASDFMCVAR messages (SBAS DFMC processing mode)&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;SBAS variance contributions breakdown. It is shown when a model can be fully computed using SBAS DFMC corrections with iono-free measurements. Messages will be sorted by constellation, with this order: GPS, Galileo, GLONASS, GEO, BeiDou, QZSS, IRNSS. All time tags are in GPS time.&lt;br/&gt;
&lt;table&gt;&lt;tr&gt;&lt;td&gt;&lt;ul&gt;
&lt;li&gt;&lt;b&gt;Field 1:&lt;/b&gt; 'SBASDFMCVAR' &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 2:&lt;/b&gt; Year &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 3:&lt;/b&gt; DoY &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 4:&lt;/b&gt; Seconds of day &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 5:&lt;/b&gt; Time of day &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 6:&lt;/b&gt; GNSS System (GPS, GAL, GLO, GEO or BDS) &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 7:&lt;/b&gt; PRN satellite identifier &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 8:&lt;/b&gt; Satellite block type &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 9:&lt;/b&gt; SVN (Space Vehicle Number) &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 10:&lt;/b&gt; Arc number &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 11:&lt;/b&gt; Arc length &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 12:&lt;/b&gt; Satellite elevation [degrees] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 13:&lt;/b&gt; Satellite azimuth [degrees] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 14:&lt;/b&gt; SBAS processing mode (PA or NPA) &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 15:&lt;/b&gt; GEO PRN from which SBAS corrections are used ('0' means all GEOs) &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 16:&lt;/b&gt; Sigma of the total residual error associated to the satellite [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 17:&lt;/b&gt; DFC (Dual Frequency Corrections) sigma (residual error associated to SBAS corrections) [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 18:&lt;/b&gt; DFREI (Dual Frequency Residual Error Indicator) for the current satellite &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 19:&lt;/b&gt; Flag to indicate if DFREI has been bumped by 1 (0-&gt;not bumped, 1-&gt;bumped) through MT34 &lt;/li&gt;
&lt;/ul&gt;&lt;/td&gt;&lt;td&gt;&lt;ul&gt;
&lt;li&gt;&lt;b&gt;Field 20:&lt;/b&gt; DFRE (Dual Frequency Residual Error) sigma converted from DFREI [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 21:&lt;/b&gt; Delta DFRE factor &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 22:&lt;/b&gt; Degradation parameter for corrections [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 23:&lt;/b&gt; Degradation parameter for en route through NPA applications [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 24:&lt;/b&gt; Sigma of the residual error associated to the ionosheric corrections [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 25:&lt;/b&gt; Sigma of the residual error associated to the tropospheric corrections [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 26:&lt;/b&gt; Sigma of the total receiver error [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 27:&lt;/b&gt; Sigma of the receiver noise [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 28:&lt;/b&gt; Sigma of the receiver multipath [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 29:&lt;/b&gt; Sigma of the receiver divergence [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 30:&lt;/b&gt; Ccorr used for computing degradation terms [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 31:&lt;/b&gt; Icorr used for computing degradation terms [s] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 32:&lt;/b&gt; Rcorr used for computing degradation terms [m/s] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 33:&lt;/b&gt; DeltaRcorr factor used for computing degradation terms &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 34:&lt;/b&gt; Computed RcorrSV used for computing degradation terms [m/s] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 35:&lt;/b&gt; Cer used for computing degradation terms [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 36:&lt;/b&gt; Ccovariance used for computing degradation terms [m] &lt;/li&gt;
&lt;/ul&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;
&lt;br/&gt;&lt;br/&gt;
&lt;b&gt;Sample: &lt;/b&gt; SBASDFMCVAR     2019 183   366.00 00:06:06.00 GAL  26 GALILEO-2        203   1    367   14.645   32.278  PA 122         1.3482         1.0003  5 0   1.0000   1.0000   0.0230   0.0000   0.1021   0.4678   0.7667   0.4000   0.6541   0.0000   0.1900  36.0000   0.0010   1.0000   0.0010   0.0000   0.0000
&lt;br/&gt;&lt;br/&gt;
When the '*' appears in field 1, it is due to smoothed code of the satellite has not reached steady-state, a SBAS processing mode switch or SBAS GEO switch. When a mode or GEO switch occurs, the SBAS corrections have to be computed again.&lt;br/&gt;
Fields 30, 31, 32, 33, 35 and 36 may be provided by MT37 or by parameter.</string>
                             </property>
                             <property name="styleSheet">
                              <string notr="true">color: rgb(0, 0, 0);</string>
                             </property>
                             <property name="text">
                              <string>Print SBASDFMCVAR</string>
                             </property>
                            </widget>
                           </item>
                           <item row="1" column="0">
                            <widget class="QCheckBox" name="checkBoxPrintSbascor">
                             <property name="toolTip">
                              <string>&lt;b&gt;SBASCORR messages (SBAS 1F processing mode)&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;SBAS corrections breakdown. It is shown when a model can be fully computed using SBAS corrections for GPS C1C measurement. All time tags are in GPS time.&lt;br/&gt;
&lt;table&gt;&lt;tr&gt;&lt;td&gt;&lt;ul&gt;
&lt;li&gt;&lt;b&gt;Field 1:&lt;/b&gt; 'SBASCORR' &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 2:&lt;/b&gt; Year &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 3:&lt;/b&gt; DoY &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 4:&lt;/b&gt; Seconds of day &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 5:&lt;/b&gt; Time of day &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 6:&lt;/b&gt; GNSS System (GPS, GLO or GEO) &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 7:&lt;/b&gt; PRN satellite identifier &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 8:&lt;/b&gt; Satellite block type &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 9:&lt;/b&gt; SVN (Space Vehicle Number) &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 10:&lt;/b&gt; Arc number &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 11:&lt;/b&gt; Arc length &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 12:&lt;/b&gt; Satellite elevation [degrees] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 13:&lt;/b&gt; Satellite azimuth [degrees] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 14:&lt;/b&gt; SBAS processing mode (PA or NPA) &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 15:&lt;/b&gt; GEO PRN from which SBAS corrections are used ('0' means all GEOs) &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 16:&lt;/b&gt; Measurement-model value (prefit) [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 17:&lt;/b&gt; Measurement value without smoothing [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 18:&lt;/b&gt; Measurement value with smoothing [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 19:&lt;/b&gt; Satellite-receiver geometric distance (with SBAS corrections) [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 20:&lt;/b&gt; Relativity correction (with SBAS corrections) [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 21:&lt;/b&gt; Satellite clock correction (with SBAS corrections) [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 22:&lt;/b&gt; Total Group Delay (TGD) correction [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 23:&lt;/b&gt; Ionosphere pierce point latitude [-90..90 degrees] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 24:&lt;/b&gt; Ionosphere pierce point longitude [0..360 degrees] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 25:&lt;/b&gt; Ionosphere correction [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 26:&lt;/b&gt; Troposphere nominal correction [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 27:&lt;/b&gt; PRC (fast correction) applied to the satellite [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 28:&lt;/b&gt; RRC (range-rate correction) applied to the satellite [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 29:&lt;/b&gt; Fast correction degradation factor [m/s&lt;sup&gt;2&lt;/sup&gt;] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 30:&lt;/b&gt; PRC time out [s] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 31:&lt;/b&gt; RRC time out (smallest PRC time out for all satellites) [s] &lt;/li&gt;
&lt;/ul&gt;&lt;/td&gt;&lt;td&gt;&lt;ul&gt;
&lt;li&gt;&lt;b&gt;Field 32:&lt;/b&gt; Time (seconds of day) used for computing PRC timeout [s] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 33:&lt;/b&gt; Time (seconds of day) used for computing sigma UDRE (User Differential Range Error) timeout [s] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 34:&lt;/b&gt; Time (seconds of day) used for computing fast correction degradation [s] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 35:&lt;/b&gt; X component of the satellite position in WGS84 system at emission time with SBAS corrections [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 36:&lt;/b&gt; Y component of the satellite position in WGS84 system at emission time with SBAS corrections [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 37:&lt;/b&gt; Z component of the satellite position in WGS84 system at emission time with SBAS corrections [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 38:&lt;/b&gt; Long term correction to be applied to the X component of the satellite [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 39:&lt;/b&gt; Long term correction to be applied to the Y component of the satellite [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 40:&lt;/b&gt; Long term correction to be applied to the Z component of the satellite [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 41:&lt;/b&gt; Long term correction to be applied to the satellite clock [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 42:&lt;/b&gt; IODP (Issue of Data PRN mask) used for fast corrections &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 43:&lt;/b&gt; IODF (Issue of Data Fast Correction) in messages type 2-5,24 for fast corrections &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 44:&lt;/b&gt; Satellite slot in the fast correction mask [1..51] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 45:&lt;/b&gt; IODP used for long term corrections &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 46:&lt;/b&gt; Satellite slot in the long term correction mask [1..51] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 47:&lt;/b&gt; IODE (Issue of Data Ephemeris) used for broadcast ephemeris &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 48:&lt;/b&gt; IODS (Service Issue of Data) used for service message &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 49:&lt;/b&gt; IODP used for covariance matrix &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 50:&lt;/b&gt; Satellite slot in the covariance mask [1..51] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 51:&lt;/b&gt; Ionosphere model flag &lt;/li&gt;
&lt;/ul&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;
&lt;br/&gt;&lt;br/&gt;
&lt;b&gt;Sample: &lt;/b&gt; SBASCORR    2019 025 85862.00 23:51:02.00 GPS  10 BLOCK_IIF         73   1    363   46.442  148.754  PA 136  14508354.8230  36155216.6800  36155216.4923  21685564.5283         0.0277    -38710.0294         0.5584        45.0657        10.6000         1.1513         3.0581 -2.3750         0.0000 0.00580        12.0000        12.0000 85858.1 85858.1 85858.1  22933506.0221  11292690.1329   7615397.5010  -0.25000  -2.12500   0.25000   1.81482  1  0  9  1  9   49  0 -1 -1  0
&lt;br/&gt;&lt;br/&gt;
When the '*' appears in field 1, it is due to smoothed code of the satellite has not reached steady-state, a SBAS processing mode switch or SBAS GEO switch. When a mode or GEO switch occurs, the SBAS corrections have to be computed again.&lt;br/&gt;
Field 47 is the IODE value from the broadcast message matched with the SBAS long term corrections. If the field value is negative, it means that the IODE used does not match any SBAS long term correction message available (only in NPA mode). A value of 999 means that no valid broadcast message was found for the current epoch.&lt;br/&gt;
Field 51 is a flag to indicate which ionosphere model is used. Its possible values are '-1' for no ionosphere model, '0' for SBAS ionosphere model, '1' for Klobuchar ionosphere model and '2' for any other ionosphere model.</string>
                             </property>
                             <property name="styleSheet">
                              <string notr="true">color: rgb(0, 0, 0);</string>
                             </property>
                             <property name="text">
                              <string>Print SBASCORR</string>
                             </property>
                            </widget>
                           </item>
                           <item row="3" column="0">
                            <widget class="QCheckBox" name="checkBoxPrintSbasiono">
                             <property name="toolTip">
                              <string>&lt;b&gt;SBASIONO messages (SBAS 1F processing mode)&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;SBAS ionosphere breakdown. It is shown when SBAS ionosphere can be computed. All time tags are in GPS time.&lt;br/&gt;
&lt;table&gt;&lt;tr&gt;&lt;td&gt;&lt;ul&gt;
&lt;li&gt;&lt;b&gt;Field 1:&lt;/b&gt; 'SBASIONO' &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 2:&lt;/b&gt; Year &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 3:&lt;/b&gt; DoY &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 4:&lt;/b&gt; Seconds of day &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 5:&lt;/b&gt; Time of day &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 6:&lt;/b&gt; GNSS System &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 7:&lt;/b&gt; PRN satellite identifier &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 8:&lt;/b&gt; Satellite elevation [degrees] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 9:&lt;/b&gt; Satellite azimuth [degrees] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 10:&lt;/b&gt; SBAS processing mode (PA or NPA) &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 11:&lt;/b&gt; GEO PRN from which SBAS corrections are used ('0' means all GEOs) &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 12:&lt;/b&gt; Ionosphere pierce point latitude [-90..90 degrees] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 13:&lt;/b&gt; Ionosphere pierce point longitude [0..360 degrees] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 14:&lt;/b&gt; Interpolation mode. 0 for square interpolation, [1-4] indicates the vertex not used in triangle interpolation &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 15:&lt;/b&gt; IODI (Issue of Data Ionospheric) for vertex 1 &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 16:&lt;/b&gt; Band Number for vertex 1 &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 17:&lt;/b&gt; IGP Number for vertex 1 &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 18:&lt;/b&gt; Time of reception of last bit of vertex 1 IGP [seconds of day] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 19:&lt;/b&gt; Time of reception of last bit of vertex 1 IGP [seconds of day] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 20:&lt;/b&gt; Longitude of the IGP for vertex 1 [0..360 degrees] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 21:&lt;/b&gt; Ionosphere delay (raw value from MT26) for vertex 1 [L1 m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 22:&lt;/b&gt; Ionosphere variance (raw value from MT26) for vertex 1 [L1 m&lt;sup&gt;2&lt;/sup&gt;] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 23:&lt;/b&gt; Degradation term for vertex 1 [L1 m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 24:&lt;/b&gt; Ionosphere delay after interpolation (if required) for vertex 1 [L1 m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 25:&lt;/b&gt; Ionosphere variance after applying degradation and interpolation (if required) for vertex 1 [L1 m&lt;sup&gt;2&lt;/sup&gt;] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 26:&lt;/b&gt; Interpolation weight for vertex 1 &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 27:&lt;/b&gt; IODI for vertex 2 &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 28:&lt;/b&gt; Band Number for vertex 2 &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 29:&lt;/b&gt; IGP Number for vertex 2 &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 30:&lt;/b&gt; Time of reception of last bit of vertex 2 IGP [seconds of day] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 31:&lt;/b&gt; Latitude of the IGP for vertex 2 [-90..90 degrees] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 32:&lt;/b&gt; Longitude of the IGP for vertex 2 [0..360 degrees] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 33:&lt;/b&gt; Ionosphere delay (raw value from MT26) for vertex 2 [L1 m] &lt;/li&gt;
&lt;/ul&gt;&lt;/td&gt;&lt;td&gt;&lt;ul&gt;
&lt;li&gt;&lt;b&gt;Field 34:&lt;/b&gt; Ionosphere variance (raw value from MT26) for vertex 2 [L1 m&lt;sup&gt;2&lt;/sup&gt;] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 35:&lt;/b&gt; Degradation term for vertex 2 [L1 m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 36:&lt;/b&gt; Ionosphere delay after interpolation (if required) for vertex 2 [L1 m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 37:&lt;/b&gt; Ionosphere variance after applying degradation and interpolation (if required) for vertex 2 [L1 m&lt;sup&gt;2&lt;/sup&gt;] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 38:&lt;/b&gt; Interpolation weight for vertex 2 &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 39:&lt;/b&gt; IODI for vertex 3 &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 40:&lt;/b&gt; Band Number for vertex 3 &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 41:&lt;/b&gt; IGP Number for vertex 3 &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 42:&lt;/b&gt; Time of reception of last bit of vertex 3 IGP [seconds of day] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 43:&lt;/b&gt; Latitude of the IGP for vertex 3 [-90..90 degrees] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 44:&lt;/b&gt; Longitude of the IGP for vertex 3 [0..360 degrees] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 45:&lt;/b&gt; Longitude of the IGP for vertex 3 [0..360 degrees] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 46:&lt;/b&gt; Ionosphere variance (raw value from MT26) for vertex 3 [L1 m&lt;sup&gt;2&lt;/sup&gt;] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 47:&lt;/b&gt; Degradation term for vertex 3 [L1 m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 48:&lt;/b&gt; Ionosphere delay after interpolation (if required) for vertex 3 [L1 m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 49:&lt;/b&gt; Ionosphere variance after applying degradation and interpolation (if required) for vertex 3 [L1 m&lt;sup&gt;2&lt;/sup&gt;] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 50:&lt;/b&gt; Interpolation weight for vertex 3 &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 51:&lt;/b&gt; IODI for vertex 4 &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 52:&lt;/b&gt; Band Number for vertex 4 &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 53:&lt;/b&gt; IGP Number for vertex 4 &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 54:&lt;/b&gt; Time of reception of last bit of vertex 4 IGP [seconds of day] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 55:&lt;/b&gt; Latitude of the IGP for vertex 4 [-90..90 degrees] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 56:&lt;/b&gt; Longitude of the IGP for vertex 4 [0..360 degrees] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 57:&lt;/b&gt; Ionosphere delay (raw value from MT26) for vertex 4 [L1 m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 58:&lt;/b&gt; Ionosphere variance (raw value from MT26) for vertex 4 [L1 m&lt;sup&gt;2&lt;/sup&gt;] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 59:&lt;/b&gt; Degradation term for vertex 4 [L1 m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 60:&lt;/b&gt; Ionosphere delay after interpolation (if required) for vertex 4 [L1 m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 61:&lt;/b&gt; Ionosphere variance after applying degradation and interpolation (if required) for vertex 4 [L1 m&lt;sup&gt;2&lt;/sup&gt;] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 62:&lt;/b&gt; Interpolation weight for vertex 4 &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 63:&lt;/b&gt; Mapping function &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 64:&lt;/b&gt; Slant delay [L1 m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 65:&lt;/b&gt; Slant Sigma [L1 m] &lt;/li&gt;
&lt;/ul&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;
&lt;br/&gt;&lt;br/&gt;
&lt;b&gt;Sample: &lt;/b&gt; SBASIONO     2019 025 85862.00 23:51:02.00 GPS  21   38.373   61.866  PA 136   49.061   13.442 0 0  4 200 85795.1  50  15  0.625   0.5322  0.000   0.6250   0.5322 0.5591 0  4 175 85795.1  50  10  0.625   0.5322  0.000   0.6250   0.5322 0.2531 0  4 174 85795.1  45  10  0.875 0.5322  0.000   0.8750   0.5322 0.0585 0  4 199 85795.1  45  15  0.875   0.5322  0.000   0.8750   0.5322 0.1293   1.4946   1.0043   1.0904
&lt;table&gt;&lt;tr&gt;&lt;td&gt;&lt;pre&gt;                            NORTH&lt;br&gt;                      v2..............v1&lt;br&gt;                      .               .&lt;br&gt;                      .               .&lt;br&gt;                      .               .&lt;br&gt;           WEST       .    IPP        .       EAST&lt;br&gt;                      .     *         .&lt;br&gt;                      .               .&lt;br&gt;                      .               .&lt;br&gt;                      v3..............v4&lt;br&gt;                            SOUTH&lt;/pre&gt;&lt;/td&gt;&lt;td&gt;&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Vertex 1 is the IGP north east to IPP.&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Vertex 2 is the IGP north west to IPP.&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Vertex 3 is the IGP south west to IPP.&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Vertex 4 is the IGP south east to IPP.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;
&lt;br/&gt;&lt;br/&gt;
When the '*' appears in field 1, it is due to smoothed code of the satellite has not reached steady-state, a SBAS processing mode switch or SBAS GEO switch. When a mode or GEO switch occurs, the SBAS corrections have to be computed again.</string>
                             </property>
                             <property name="styleSheet">
                              <string notr="true">color: rgb(0, 0, 0);</string>
                             </property>
                             <property name="text">
                              <string>Print SBASIONO</string>
                             </property>
                            </widget>
                           </item>
                           <item row="8" column="0">
                            <widget class="QCheckBox" name="checkBoxPrintSbasout">
                             <property name="toolTip">
                              <string>&lt;b&gt;SBASOUT messages (SBAS 1F/DFMC processing mode)&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Receiver solution message. This message provides the estimated receiver position, protection levels and satellites used in solution computation. All time tags are in GPS time.&lt;br/&gt;
&lt;table&gt;&lt;tr&gt;&lt;td&gt;&lt;ul&gt;
&lt;li&gt;&lt;b&gt;Field 1:&lt;/b&gt; 'SBASOUT' &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 2:&lt;/b&gt; Year &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 3:&lt;/b&gt; DoY &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 4:&lt;/b&gt; Seconds of day &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 5:&lt;/b&gt; Time of day &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 6:&lt;/b&gt; GPS week &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 7:&lt;/b&gt; Time of week &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 8:&lt;/b&gt; Receiver id &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 9:&lt;/b&gt; Processing mode indicator &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 10:&lt;/b&gt; SBAS processing mode (PA or NPA) &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 11:&lt;/b&gt; GEO PRN from which SBAS corrections are used ('0' means all GEOs) &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 12:&lt;/b&gt; Receiver North difference in relation to nominal a priori position [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 13:&lt;/b&gt; Receiver East difference in relation to nominal a priori position [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 14:&lt;/b&gt; Receiver Up difference in relation to nominal a priori position [m] &lt;/li&gt;
&lt;/ul&gt;&lt;/td&gt;&lt;td&gt;&lt;ul&gt;
&lt;li&gt;&lt;b&gt;Field 15:&lt;/b&gt; Horizontal positioning error [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 16:&lt;/b&gt; Horizontal protection level [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 17:&lt;/b&gt; Horizontal alarm limit [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 18:&lt;/b&gt; Vertical positioning error [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 19:&lt;/b&gt; Vertical protection level [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 20:&lt;/b&gt; Vertical alarm limit [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 21:&lt;/b&gt; 3D positioning error [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 22:&lt;/b&gt; Receiver clock offset [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 23:&lt;/b&gt; Number of satellites in view suitable for SBAS &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 24:&lt;/b&gt; Number of satellites used in SBAS solution computation &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 25-:&lt;/b&gt; Satellite list. Each following column is a '+' or '-' sign, the satellite system and the PRN identifier. The '+' sign indicates that the satellite has been used in the solution computation for SBAS. The '-' sign indicates that the satellite has not been used in the solution computation for SBAS. The satellite list will show first all the satellite with the '+' and after the ones with the '-' sign.&lt;/li&gt;
&lt;/ul&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;
&lt;br/&gt;&lt;br/&gt;
&lt;b&gt;Sample: &lt;/b&gt; SBASOUT     2015 165   386.00 00:06:26.00 1849    386.00 vigo 5  PA 120         0.7862         1.4262        -0.2907         1.6285        20.9835  40.00         0.2907        21.8638  50.00         1.6543    -94936.8129 11 10 +G23 +G17 +G01 +G04 +G10 +G11 +G03 +G06 +G31 +G32 -G09
&lt;br/&gt;&lt;br/&gt;
Processing mode indicator in field 9 may have the following values:
&lt;table&gt;&lt;tr&gt;&lt;td&gt;&lt;ul&gt;
           0 -&gt; SPP &lt;br/&gt;
           1 -&gt; PPP &lt;br/&gt;
           2 -&gt; Reserved &lt;br/&gt;
           3 -&gt; Reserved
&lt;/ul&gt;&lt;/td&gt;&lt;td&gt;&lt;ul&gt;
           4 -&gt; Reserved &lt;br/&gt;
           5 -&gt; SBAS 1 Frequency &lt;br/&gt;
           6 -&gt; SBAS DFMC &lt;br/&gt;
           7 -&gt; DGNSS
&lt;/ul&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;</string>
                             </property>
                             <property name="styleSheet">
                              <string notr="true">color: rgb(0, 0, 0);</string>
                             </property>
                             <property name="text">
                              <string>Print SBASOUT</string>
                             </property>
                             <property name="checked">
                              <bool>true</bool>
                             </property>
                            </widget>
                           </item>
                           <item row="7" column="0">
                            <widget class="QCheckBox" name="checkBoxPrintSbasDFMCUnsel">
                             <property name="toolTip">
                              <string>&lt;b&gt;SBASDFMCUNSEL messages (SBAS DFMC processing mode)&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;SBAS satellite unselection message. When a satellite is discarded due to MOPS DFMC criteria, this message details the reason. Messages will be sorted by constellation, with this order: GPS, Galileo, GLONASS, GEO, BeiDou, QZSS, IRNSS. All time tags are in GPS time.&lt;br/&gt;
&lt;table&gt;&lt;tr&gt;&lt;td&gt;&lt;ul&gt;
&lt;li&gt;&lt;b&gt;Field 1:&lt;/b&gt; 'SBASDFMCUNSEL' &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 2:&lt;/b&gt; Year &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 3:&lt;/b&gt; DoY &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 4:&lt;/b&gt; Seconds of day &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 5:&lt;/b&gt; Time of day &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 6:&lt;/b&gt; GNSS System &lt;/li&gt;
&lt;/ul&gt;&lt;/td&gt;&lt;td&gt;&lt;ul&gt;
&lt;li&gt;&lt;b&gt;Field 7:&lt;/b&gt; PRN satellite identifier &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 8:&lt;/b&gt; SBAS processing mode (PA or NPA) &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 9:&lt;/b&gt; GEO PRN from which SBAS corrections are used ('0' means all GEOs) &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 10:&lt;/b&gt; Error code &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 11:&lt;/b&gt; &quot;Discard reason&quot; &lt;/li&gt;
&lt;/ul&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;
&lt;br/&gt;&lt;br/&gt;
&lt;b&gt;Sample: &lt;/b&gt; SBASDFMCUNSEL   2019 183   366.00 00:06:06.00 GPS  22  PA 122 14 &quot;Satellite flagged as 'Do not use' (DFREI=15)&quot;
&lt;br/&gt;&lt;br/&gt;
The error code in field 10 is a number which identifies the discard reason with a range from 1 to 27. Useful for parsing purposes. Field 11 will be always between quotes in order to ease parsing purposes. Fields 10 and 11 may have the following values:&lt;br/&gt;
&lt;table&gt;&lt;tr&gt;&lt;td&gt;&lt;ul&gt;
&lt;li&gt;&lt;b&gt;1:&lt;/b&gt; &quot;No GEO satellites available&quot;&lt;/li&gt;
&lt;li&gt;&lt;b&gt;2:&lt;/b&gt; &quot;No data for user selected GEO&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;3:&lt;/b&gt; &quot;Not enough almanac or GEO navigation message to determine the GEO with highest elevation&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;4:&lt;/b&gt; &quot;Received alarm message for current GEO at epoch &amp;lt;YYYY DoY SoD&amp;gt;. Time remaining to finish alarm: &amp;lt;seconds&amp;gt; seconds&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;5:&lt;/b&gt; &quot;Received &amp;lt;value&amp;gt; consecutive messages with errors (UDREI data has been forced to timeout)&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;6:&lt;/b&gt; &quot;Missed &amp;lt;value&amp;gt; consecutive messages&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;7:&lt;/b&gt; &quot;No PRN mask&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;8:&lt;/b&gt; &quot;PRN mask timed out&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;9:&lt;/b&gt; &quot;Satellite is not monitored in any of the PRN mask available&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;10:&lt;/b&gt; &quot;No message type 37 available&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;11:&lt;/b&gt; &quot;Message type 37 timed out&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;12:&lt;/b&gt; &quot;No DFREI data received for current PRN&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;13:&lt;/b&gt; &quot;DFREI timed out&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;14:&lt;/b&gt; &quot;Satellite flagged as 'Do not use' (DFREI=15)&quot; &lt;/li&gt;
&lt;/ul&gt;&lt;/td&gt;&lt;td&gt;&lt;ul&gt;
&lt;li&gt;&lt;b&gt;15:&lt;/b&gt; &quot;Received DFRECI=1 in MT34 but no new DFREI value&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;16:&lt;/b&gt; &quot;Satellite has an DFREI value of &amp;lt;value&amp;gt; (user threshold is &amp;lt;value&amp;gt;)&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;17:&lt;/b&gt; &quot;No MT39/40 from GEO &amp;lt;value&amp;gt; received (same GEO as source corrections)&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;18:&lt;/b&gt; &quot;No data from GEO &amp;lt;value&amp;gt; received for MT39/40&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;19:&lt;/b&gt; &quot;No MT39/40 message pair from GEO &amp;lt;value&amp;gt; received&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;20:&lt;/b&gt; &quot;Message type 39/40 pair timed out&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;21:&lt;/b&gt; &quot;No message type 32 received for current PRN&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;22:&lt;/b&gt; &quot;Message type 32 timed out&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;23:&lt;/b&gt; &quot;IODN in Message type 32 does not match with IODG in message type 39/40&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;24:&lt;/b&gt; &quot;Could not compute transmission time for current PRN&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;25:&lt;/b&gt; &quot;No broadcast block with IOD &amp;lt;value&amp;gt;&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;26:&lt;/b&gt; &quot;Satellite is not in view (elevation &amp;lt;value&amp;gt; degrees)&quot; &lt;/li&gt;
&lt;li&gt;&lt;b&gt;27:&lt;/b&gt; &quot;Satellite elevation (&amp;lt;value&amp;gt; degrees) is too low&quot; &lt;/li&gt;
&lt;/ul&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;
&lt;br/&gt;&lt;br/&gt;
Error code number 15 should never occur, as SARPS requirements state that in MT34 a maximum of 7 DFRECI values can be equal to 1.&lt;br/&gt;
Error codes number 26 and 27 will only appear in SBAS plots mode.</string>
                             </property>
                             <property name="styleSheet">
                              <string notr="true">color: rgb(0, 0, 0);</string>
                             </property>
                             <property name="text">
                              <string>Print SBASDFMCUNSEL</string>
                             </property>
                            </widget>
                           </item>
                          </layout>
                         </widget>
                        </item>
                        <item row="1" column="0">
                         <spacer name="verticalSpacer_37">
                          <property name="orientation">
                           <enum>Qt::Vertical</enum>
                          </property>
                          <property name="sizeHint" stdset="0">
                           <size>
                            <width>20</width>
                            <height>0</height>
                           </size>
                          </property>
                         </spacer>
                        </item>
                       </layout>
                      </widget>
                      <widget class="QWidget" name="page_37">
                       <property name="sizePolicy">
                        <sizepolicy hsizetype="Minimum" vsizetype="Preferred">
                         <horstretch>0</horstretch>
                         <verstretch>0</verstretch>
                        </sizepolicy>
                       </property>
                       <layout class="QGridLayout" name="gridLayout_166">
                        <property name="leftMargin">
                         <number>0</number>
                        </property>
                        <property name="topMargin">
                         <number>0</number>
                        </property>
                        <property name="rightMargin">
                         <number>0</number>
                        </property>
                        <property name="bottomMargin">
                         <number>0</number>
                        </property>
                        <item row="0" column="0">
                         <widget class="QGroupBox" name="groupBoxDgnssMessages">
                          <property name="sizePolicy">
                           <sizepolicy hsizetype="Minimum" vsizetype="Fixed">
                            <horstretch>0</horstretch>
                            <verstretch>0</verstretch>
                           </sizepolicy>
                          </property>
                          <property name="font">
                           <font>
                            <pointsize>9</pointsize>
                            <weight>75</weight>
                            <bold>true</bold>
                           </font>
                          </property>
                          <property name="styleSheet">
                           <string notr="true">QGroupBox {color: rgb(45, 36, 90);}</string>
                          </property>
                          <property name="title">
                           <string>DGNSS Messages</string>
                          </property>
                          <layout class="QGridLayout" name="gridLayout_115">
                           <property name="leftMargin">
                            <number>6</number>
                           </property>
                           <property name="topMargin">
                            <number>9</number>
                           </property>
                           <property name="rightMargin">
                            <number>6</number>
                           </property>
                           <property name="bottomMargin">
                            <number>6</number>
                           </property>
                           <property name="verticalSpacing">
                            <number>3</number>
                           </property>
                           <item row="1" column="0">
                            <widget class="QCheckBox" name="checkBoxPrintDgnss">
                             <property name="toolTip">
                              <string>&lt;b&gt;DGNSS messages (DGNSS processing mode)&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;DGNSS corrections breakdown. It is shown when a model can be fully computed using DGNSS corrections for GPS C1C measurement. Messages will be sorted by constellation, with this order: GPS, Galileo, GLONASS, GEO, BeiDou, QZSS, IRNSS.&lt;br/&gt;
&lt;table&gt;&lt;tr&gt;&lt;td&gt;&lt;ul&gt;
&lt;li&gt;&lt;b&gt;Field 1:&lt;/b&gt; 'DGNSS' &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 2:&lt;/b&gt; Year &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 3:&lt;/b&gt; DoY &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 4:&lt;/b&gt; Seconds of day &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 5:&lt;/b&gt; Time of day &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 6:&lt;/b&gt; GNSS System &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 7:&lt;/b&gt; PRN satellite identifier &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 8:&lt;/b&gt; Pseudorange correction to be applied to the satellite [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 9:&lt;/b&gt; Range rate correction to be applied to the satellite [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 10:&lt;/b&gt; Seconds elapsed since the reception of the RRC correction [s] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 11:&lt;/b&gt; Delta of PRC to be applied in case of change in case of a change in ephemeris [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 12:&lt;/b&gt; Delta of RRC to be applied in case of change in case of a change in ephemeris [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 13:&lt;/b&gt; Seconds elapsed since the reception of the delta RRC correction [s] &lt;/li&gt;
&lt;/ul&gt;&lt;/td&gt;&lt;td&gt;&lt;ul&gt;
&lt;li&gt;&lt;b&gt;Field 14:&lt;/b&gt; Sigma of the total residual error associated to the satellite [m]. Sigma of the total residual error = sigma of the UDRE + sigma degradation + sigma air &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 15:&lt;/b&gt; Sigma of the UDRE (User Differential Range Error) [m] &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 16:&lt;/b&gt; Sigma degradation consists of the URA (User Range Accuracy) degradation factor (we assume epsURA = 1 cm/s), and the satellite elevation. It only applies for RTCM v3.x [m]. Sigma degradation = (epsURA * dt) / tan(satellite elevation) &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 17:&lt;/b&gt; Sigma air consists of the sigma multipath, the sigma to noise GPS (we assume 0.25 m) and the sigma inflation (equal to 1 if deactivated) [m]. Sigma air = ( sigma multipath + sigma to noise GPS ) * sigma inflation &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 18:&lt;/b&gt; Sigma multipath = 0.0625 / tan(elev) / tan(elev) &lt;/li&gt;
&lt;li&gt;&lt;b&gt;Field 19:&lt;/b&gt; Sigma inflation during the convergence of the smoothing &lt;/li&gt;
&lt;/ul&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;
&lt;br/&gt;&lt;br/&gt;
&lt;b&gt;Sample: &lt;/b&gt; DGNSS     2016 294  5407.000 01:30:07.00 GPS  6  -4.1800   0.0000   1.5999   0.0000   0.0000   0.0000   0.6053   0.3000   0.0000   0.5257   0.0264   1.0000</string>
                             </property>
                             <property name="styleSheet">
                              <string notr="true">color: rgb(0, 0, 0);</string>
                             </property>
                             <property name="text">
                              <string>Print DGNSS</string>
                             </property>
                             <property name="checked">
                              <bool>true</bool>
                             </property>
                            </widget>
                           </item>
                           <item row="2" column="0">
                            <widget class="QCheckBox" name="checkBoxPrintDgnssunused">
                             <property name="toolTip">
                              <string>&lt;b&gt;DGNSSUNUSED messages (in DGNSS processing mode only)&lt;/b&gt;&lt;br&gt;&lt;br&gt;
Print messages from discarded satellites due to DOP switch (from DGNSS to SPP).&lt;br/&gt;
An asterisk '*' will be added at the end of the first field to indicate that it is a discarded measurement.</string>
                             </property>
                             <property name="styleSheet">
                              <string notr="true">color: rgb(0, 0, 0);</string>
                             </property>
                             <property name="text">
                              <string>Print DGNSSUNUSED</string>
                             </property>
                            </widget>
                           </item>
