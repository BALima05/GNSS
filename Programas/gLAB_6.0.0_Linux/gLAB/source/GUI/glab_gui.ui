                          <font>
                           <weight>75</weight>
                           <bold>true</bold>
                          </font>
                         </property>
                         <property name="title">
                          <string>Geometry-free Cycle-slip Detection Parameters</string>
                         </property>
                         <layout class="QGridLayout" name="gridLayout_72">
                          <property name="topMargin">
                           <number>12</number>
                          </property>
                          <property name="bottomMargin">
                           <number>3</number>
