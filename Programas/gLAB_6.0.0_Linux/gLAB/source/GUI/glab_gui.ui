                          <item row="5" column="0">
                           <widget class="QGroupBox" name="groupBoxShowDCBOptionsIRNSS">
                            <property name="font">
                             <font>
                              <pointsize>9</pointsize>
                              <weight>75</weight>
                              <bold>true</bold>
                             </font>
                            </property>
                            <property name="styleSheet">
                             <string notr="true">QGroupBox {color: rgb(45, 36, 90);}</string>
                            </property>
                            <property name="title">
                             <string>Show IRNSS</string>
                            </property>
                            <property name="checkable">
                             <bool>true</bool>
                            </property>
                            <layout class="QGridLayout" name="gridLayout_419">
                             <property name="leftMargin">
                              <number>6</number>
                             </property>
                             <property name="topMargin">
                              <number>9</number>
