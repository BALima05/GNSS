                           <widget class="QLabel" name="label_56">
                            <property name="toolTip">
                             <string>&lt;b&gt;Minimum stdDev&lt;/b&gt;&lt;br&gt;&lt;br&gt;Minimum standard deviation (in metres) to compute one of the thresholds for the Melbourne-Wübbena cycle-slip detector.&lt;br&gt;</string>
                            </property>
                            <property name="styleSheet">
                             <string notr="true">color: rgb(0, 0, 0);</string>
                            </property>
                            <property name="text">
                             <string>Minimum stdDev</string>
                            </property>
                           </widget>
                          </item>
                          <item row="3" column="2">
                           <widget class="QLabel" name="label_177">
