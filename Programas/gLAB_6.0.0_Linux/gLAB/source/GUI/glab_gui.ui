                   <property name="bottomMargin">
                    <number>0</number>
                   </property>
                   <property name="spacing">
                    <number>10</number>
                   </property>
                   <item row="0" column="1">
                    <widget class="QPushButton" name="pushButtonTemplateIonosphericCombinations">
                     <property name="minimumSize">
                      <size>
                       <width>0</width>
                       <height>30</height>
                      </size>
                     </property>
                     <property name="toolTip">
                      <string>&lt;b&gt;Templates: Ionospheric combinations&lt;/b&gt;&lt;br&gt;&lt;br&gt;The templates are a set of preconfigured plotting options for the &lt;i&gt;Graphic Details&lt;/i&gt; section. Clicking on any button will load the options in that section, allowing to modify them or plot them directly.&lt;br&gt;&lt;br&gt;The &lt;i&gt;Ionospheric combinations&lt;/i&gt; template sets the options to print the two ionospheric (geometry-free) combinations: PI (P2-P1) [pseudorange] and LI (L1-L2) [carrier phase].&quot;&lt;br&gt;</string>
                     </property>
                     <property name="text">
                      <string>Ionospheric Combinations</string>
                     </property>
                     <property name="default">
                      <bool>true</bool>
                     </property>
                    </widget>
                   </item>
                   <item row="0" column="2">
                    <widget class="QPushButton" name="pushButtonTemplateCarrierPhaseAmbiguities">
                     <property name="minimumSize">
                      <size>
                       <width>0</width>
                       <height>30</height>
                      </size>
                     </property>
                     <property name="toolTip">
                      <string>&lt;b&gt;Templates: Carrier phase ambiguities&lt;/b&gt;&lt;br&gt;&lt;br&gt;The templates are a set of preconfigured plotting options for the &lt;i&gt;Graphic Details&lt;/i&gt; section. Clicking on any button will load the options in that section, allowing to modify them or plot them directly.&lt;br&gt;&lt;br&gt;The &lt;i&gt;Carrier phase ambiguities&lt;/i&gt; template sets the options to print the estimation of carrier phase measurements in the filter. This is only possible in a processing with the &lt;i&gt;Pseudorange + carrier phase&lt;/i&gt; measurements (in the &lt;i&gt;Filter&lt;/i&gt; section).&lt;br&gt;</string>
                     </property>
                     <property name="text">
                      <string>Carrier Phase Ambiguities</string>
                     </property>
                     <property name="default">
                      <bool>true</bool>
                     </property>
                    </widget>
                   </item>
                   <item row="0" column="3">
                    <widget class="QPushButton" name="pushButtonTemplateOrbitAndClockComparison">
                     <property name="minimumSize">
                      <size>
                       <width>0</width>
                       <height>30</height>
                      </size>
                     </property>
                     <property name="toolTip">
                      <string>&lt;b&gt;Templates: Orbits and Clock comparison&lt;/b&gt;&lt;br&gt;&lt;br&gt;The templates are a set of preconfigured plotting options for the &lt;i&gt;Graphic Details&lt;/i&gt; section. Clicking on any button will load the options in that section, allowing to modify them or plot them directly.&lt;br&gt;&lt;br&gt;The &lt;i&gt;Orbits and Clock comparison&lt;/i&gt; template sets the options to print the &lt;b&gt;discrepancies&lt;/b&gt; between two orbit product files (RINEX navigation or SP3 files). &lt;br&gt; &lt;br&gt;&lt;b&gt;&lt;font color='#C00000'&gt;Note:&lt;/font&gt;&lt;/b&gt; The comparison between these two orbit product files has to be done in the &lt;i&gt;Compare Orbits&lt;/i&gt; mode.&lt;br&gt;</string>
                     </property>
                     <property name="text">
                      <string>Orbit and Clock Comparison</string>
                     </property>
                     <property name="default">
                      <bool>true</bool>
                     </property>
                    </widget>
                   </item>
                   <item row="0" column="0">
                    <widget class="QPushButton" name="pushButtonTemplateZenithTroposphericDelay">
                     <property name="minimumSize">
                      <size>
                       <width>0</width>
                       <height>30</height>
                      </size>
                     </property>
                     <property name="toolTip">
                      <string>&lt;b&gt;Templates: Zenith Tropospheric Delay&lt;/b&gt;&lt;br&gt;&lt;br&gt;The templates are a set of preconfigured plotting options for the &lt;i&gt;Graphic Details&lt;/i&gt; section. Clicking on any button will load the options in that section, allowing to modify them or plot them directly.&lt;br&gt;&lt;br&gt; The &lt;i&gt;Zenith Tropospheric Delay&lt;/i&gt; template sets the options to print the &lt;b&gt;tropospheric estimations&lt;/b&gt; as a function of time. It includes the nominal part corrected in the modelling and the estimated part computed in the filter.&lt;br&gt;</string>
                     </property>
                     <property name="text">
                      <string>Zenith Tropospheric Delay</string>
                     </property>
                     <property name="default">
