                                                  <width>90</width>
                                                  <height>16777215</height>
                                                 </size>
                                                </property>
                                                <property name="focusPolicy">
                                                 <enum>Qt::StrongFocus</enum>
                                                </property>
                                               </widget>
                                              </item>
                                              <item row="0" column="0">
                                               <widget class="QLabel" name="label_841">
                                                <property name="toolTip">
                                                 <string>&lt;b&gt;Freq2:&lt;/b&gt;&lt;br&gt;&lt;br&gt;Set the second frequency (for ionospheric-free or divergence-free combinations) for smoothing the second QZSS code measurement.&lt;br&gt;</string>
                                                </property>
                                                <property name="styleSheet">
                                                 <string notr="true">color: rgb(0, 0, 0);</string>
                                                </property>
                                                <property name="text">
                                                 <string>Freq2:</string>
                                                </property>
                                               </widget>
                                              </item>
                                              <item row="0" column="3">
                                               <widget class="QComboBox" name="comboBoxSmoothPhase2QZSS_2">
                                                <property name="minimumSize">
                                                 <size>
                                                  <width>65</width>
                                                  <height>0</height>
                                                 </size>
                                                </property>
                                                <property name="maximumSize">
                                                 <size>
                                                  <width>75</width>
                                                  <height>16777215</height>
                                                 </size>
                                                </property>
