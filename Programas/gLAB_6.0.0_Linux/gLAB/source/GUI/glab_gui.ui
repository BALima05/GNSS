                              <item row="2" column="3">
                               <widget class="QLineEdit" name="lineEditSatMaskNPA_DFMC">
                                <property name="clearButtonEnabled">
                                 <bool>true</bool>
                                </property>
                               </widget>
                              </item>
                              <item row="1" column="0">
                               <widget class="QLabel" name="label_472">
                                <property name="toolTip">
                                 <string>&lt;b&gt;Do Not Use for Safety Applications&lt;/b&gt;&lt;br&gt;&lt;br&gt;Message type 0. This message to inform the user that there is a problem in the GEO that has sent this message. When the user receives this message, an alarm is triggered, and the user has to erase all information received from this GEO (except for the almanac), and also wait for one minute until the user can start using this GEO again (during this minute of cooldown, all messages from this GEO must be ignored).&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTES:&lt;/b&gt;&lt;ul&gt;&lt;li&gt;The alarm is triggered just after reading the message&lt;/li&gt;&lt;li&gt;If user has enabled the option &lt;i&gt;Parse Alarm Message as Type 34/35/36 Message&lt;/i&gt;, then this message will be read as a type 34/35/36 messages (no alarm triggered), except for the case that this message is filled with all zeros, which means that the user is forced to read it as an alarm message.&lt;/li&gt;&lt;li&gt;If user has enabled the option &lt;i&gt;Ignore All Alarm Messages&lt;/i&gt;, then this message will be ignored and no alarm will be triggered.&lt;/li&gt;&lt;li&gt;When an alarm is triggered, after the cooldown minute, the GEO acquisition time will be restarted.&lt;/li&gt;&lt;li&gt;The time-out of 9999999 seconds is to indicate that is has an infinite time-out (due to, as explained above, the message is applied instantaneously).&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;</string>
                                </property>
                                <property name="styleSheet">
                                 <string notr="true">color: rgb(0, 0, 0);</string>
                                </property>
                                <property name="text">
                                 <string>Do Not Use for Safety
Applications</string>
                                </property>
                               </widget>
                              </item>
                              <item row="5" column="1">
                               <widget class="QLabel" name="label_504">
                                <property name="styleSheet">
                                 <string notr="true">color: rgb(0, 0, 0);</string>
                                </property>
                                <property name="text">
                                 <string>37</string>
                                </property>
                                <property name="alignment">
                                 <set>Qt::AlignCenter</set>
                                </property>
                               </widget>
                              </item>
                              <item row="8" column="0">
                               <widget class="QLabel" name="label_400">
                                <property name="toolTip">
                                 <string>&lt;b&gt;SBAS Satellites Almanacs&lt;/b&gt;&lt;br&gt;&lt;br&gt;Message type 47. This message contains the almanac for the SBAS satellites broadcasting signals. This message allows the user to be aware of all the broadcasting SBAS satellites available, and also compute a rough position of each SBAS satellite (this is useful if user wants to use the SBAS satellite with highest elevation in the minimum time possible).&lt;br&gt;&lt;br&gt;Each message contains the almanac for two SBAS satellites.&lt;br&gt;</string>
                                </property>
                                <property name="styleSheet">
                                 <string notr="true">color: rgb(0, 0, 0);</string>
                                </property>
                                <property name="text">
                                 <string>SBAS Satellites Almanacs</string>
                                </property>
                               </widget>
                              </item>
