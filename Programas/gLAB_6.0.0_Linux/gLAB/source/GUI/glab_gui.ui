                                 <item row="0" column="0">
                                  <widget class="QPushButton" name="pushButtonRefGNSSClockBoost">
                                   <property name="toolTip">
                                    <string>&lt;b&gt;&amp;lt;&amp;lt; (Move Left)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Move left (higher priority) the current selected cell for reference clock constellation. gLAB will loop through this list (from left to right) with the enabled (in green) constellations. If there is at least one satellite available for the navigation solution, the constellation is selected. Otherwise try with the next constellation until one is selected or the list of exhausted (in this case the epoch will be skipped).&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTES:&lt;/b&gt;&lt;ul&gt;&lt;li&gt;Reference clock constellation selection process will be evaluated on each epoch in order to maximize navigation solution availability.&lt;/li&gt;&lt;li&gt;To make gLAB always use the same reference constellation, just leave one constellation enabled (in green) in this list.&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;</string>
                                   </property>
                                   <property name="text">
                                    <string>&lt;&lt;</string>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="0" column="5">
                                  <widget class="QPushButton" name="pushButtonRefGNSSClockSetDefault">
                                   <property name="toolTip">
                                    <string>&lt;b&gt;Set Default&lt;/b&gt;&lt;br&gt;&lt;br&gt;Set the default constellation order for reference clock usage.&lt;br&gt; The default is to use the following constellation order: GPS, Galileo, GLONASS, BDS, QZSS and IRNSS. GEO constellation is disabled.&lt;br&gt;</string>
                                   </property>
                                   <property name="text">
                                    <string>Set Default</string>
                                   </property>
                                  </widget>
                                 </item>
                                 <item row="0" column="1">
                                  <widget class="QPushButton" name="pushButtonRefGNSSClockLower">
                                   <property name="toolTip">
                                    <string>&lt;b&gt;&amp;gt;&amp;gt; (Move Right)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Move right (lower priority) the current selected cell for reference clock constellation. gLAB will loop through this list (from left to right) with the enabled (in green) constellations. If there is at least one satellite available for the navigation solution, the constellation is selected. Otherwise try with the next constellation until one is selected or the list of exhausted (in this case the epoch will be skipped).&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTES:&lt;/b&gt;&lt;ul&gt;&lt;li&gt;Reference clock constellation selection process will be evaluated on each epoch in order to maximize navigation solution availability.&lt;/li&gt;&lt;li&gt;To make gLAB always use the same reference constellation, just leave one constellation enabled (in green) in this list.&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;</string>
                                   </property>
                                   <property name="text">
                                    <string>&gt;&gt;</string>
                                   </property>
                                  </widget>
                                 </item>
