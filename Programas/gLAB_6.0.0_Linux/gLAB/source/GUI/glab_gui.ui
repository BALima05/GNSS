                        <property name="maximumSize">
                         <size>
                          <width>16777215</width>
                          <height>25</height>
                         </size>
                        </property>
                        <property name="toolTip">
                         <string>&lt;b&gt;IRNSS&lt;/b&gt;&lt;br&gt;&lt;br&gt;Select or unselect IRNSS constellation for orbit comparison. If set the priority order for IRNSS navigation message selection. The selected navigation messages will be used for computing orbits and clocks. See &lt;i&gt;Preferred age time&lt;/i&gt; below for details on the navigation message selection algorithm.&lt;br&gt;&lt;br&gt;The navigation message type supported for IRNSS is:&lt;ul&gt;&lt;li&gt;&lt;b&gt;CNAV:&lt;/b&gt; Civil navigation message sent in the L5 signal.&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;</string>
                        </property>
                        <property name="styleSheet">
                         <string notr="true">color: rgb(0, 0, 0);</string>
                        </property>
                        <property name="text">
                         <string>IRNSS</string>
                        </property>
                       </widget>
                      </item>
                      <item row="0" column="0">
                       <widget class="QCheckBox" name="checkBoxCompareNavMessageTypeGPS_2">
                        <property name="minimumSize">
                         <size>
                          <width>0</width>
                          <height>35</height>
                         </size>
                        </property>
                        <property name="maximumSize">
                         <size>
                          <width>16777215</width>
                          <height>35</height>
                         </size>
                        </property>
                        <property name="toolTip">
                         <string>&lt;b&gt;GPS&lt;/b&gt;&lt;br&gt;&lt;br&gt;Select or unselect GPS constellation for orbit comparison. If selected, set the priority order for GPS navigation message selection. The selected navigation messages will be used for computing orbits and clocks. See &lt;i&gt;Preferred age time&lt;/i&gt; below for details on the navigation message selection algorithm.&lt;br&gt;&lt;br&gt;The navigation message types supported for GPS are:&lt;ul&gt;&lt;li&gt;&lt;b&gt;LNAV:&lt;/b&gt; Legacy navigation message sent in the L1 C/A, L1P and L2P signals (applied to both RINEX navigation files).&lt;/li&gt;&lt;li&gt;&lt;b&gt;CNAV-1:&lt;/b&gt; Civil navigation message sent in L2C and L5 signals (applied to both RINEX navigation files).&lt;/li&gt;&lt;li&gt;&lt;b&gt;LNAVvsCNAV:&lt;/b&gt; The first and second RINEX navigation files will use LNAV only and CNAV-1 message type only respectively, therefore the comparison will be between navigation message types.&lt;/li&gt;&lt;li&gt;&lt;b&gt;CNAVvsLNAV:&lt;/b&gt;  The first and second RINEX navigation files will use CNAV-1 only and LNAV message type only respectively, therefore the comparison will be between navigation message types.&lt;/li&gt;&lt;/li&gt;&lt;/ul&gt;&lt;b&gt;NOTE:&lt;/b&gt; CNAV-1 is only supported with the &lt;b&gt;unofficial&lt;/b&gt; MGEX RINEX navigation file version '4.00' (files with extension &lt;i&gt;.YYx&lt;/i&gt;).&lt;br&gt;</string>
                        </property>
                        <property name="styleSheet">
                         <string notr="true">color: rgb(0, 0, 0);</string>
                        </property>
                        <property name="text">
                         <string>GPS</string>
                        </property>
                       </widget>
                      </item>
