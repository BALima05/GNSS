                                        </item>
                                        <item row="0" column="5">
                                         <widget class="QComboBox" name="comboBoxMeasGCPhaseGLONASS_2">
                                          <property name="minimumSize">
                                           <size>
                                            <width>65</width>
                                            <height>0</height>
                                           </size>
                                          </property>
                                          <property name="maximumSize">
                                           <size>
                                            <width>75</width>
                                            <height>16777215</height>
