                                    <item row="1" column="0">
                                     <widget class="QRadioButton" name="radioButtonCalculateEarthCentre">
                                      <property name="sizePolicy">
                                       <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
                                        <horstretch>0</horstretch>
                                        <verstretch>0</verstretch>
                                       </sizepolicy>
                                      </property>
                                      <property name="minimumSize">
                                       <size>
                                        <width>0</width>
                                        <height>0</height>
                                       </size>
                                      </property>
                                      <property name="toolTip">
                                       <string>&lt;b&gt;Calculate a priori receiver position: Earth's surface&lt;/b&gt;&lt;br&gt;&lt;br&gt;gLAB will automatically calculate the a priori receiver position, starting from Earth's surface (6378137,0,0).&lt;br&gt;If a reference position file is given, the differential fields of the &lt;b&gt;OUTPUT&lt;/b&gt; message will be the difference between the gLAB solution and the position given in the reference file. If no reference file is given or there is no value in the reference file (for a given epoch), the differentials fields will be zero.&lt;br&gt;</string>
                                      </property>
                                      <property name="styleSheet">
                                       <string notr="true">color: rgb(0, 0, 0);</string>
                                      </property>
                                      <property name="text">
                                       <string>Earth's surface</string>
                                      </property>
                                      <property name="checked">
                                       <bool>true</bool>
                                      </property>
                                     </widget>
                                    </item>
                                    <item row="1" column="1">
                                     <widget class="QRadioButton" name="radioButtonCalculateRinex">
                                      <property name="sizePolicy">
                                       <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
                                        <horstretch>0</horstretch>
                                        <verstretch>0</verstretch>
                                       </sizepolicy>
                                      </property>
                                      <property name="toolTip">
                                       <string>&lt;b&gt;Calculate a priori receiver position: RINEX&lt;/b&gt;&lt;br&gt;&lt;br&gt;gLAB will automatically calculate the a priori receiver position, but starting from the RINEX observation header record &lt;b&gt;&lt;i&gt;APPROX POSITION XYZ&lt;/i&gt;&lt;/b&gt;. If these coordinates are (0,0,0), then the Earth's surface (6378137,0,0) will be used as initial coordinates.&lt;br&gt;If a reference position file is given, the differential fields of the &lt;b&gt;OUTPUT&lt;/b&gt; message will be the difference between the gLAB solution and the position given in the reference file. If no reference file is given or there is no value in the reference file (for a given epoch), the differentials fields will be zero.&lt;br&gt;</string>
                                      </property>
                                      <property name="styleSheet">
                                       <string notr="true">color: rgb(0, 0, 0);</string>
                                      </property>
                                      <property name="text">
                                       <string>RINEX</string>
                                      </property>
                                     </widget>
                                    </item>
                                    <item row="2" column="0">
                                     <widget class="QRadioButton" name="radioButtonCalculateSpecify">
                                      <property name="sizePolicy">
                                       <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
                                        <horstretch>0</horstretch>
                                        <verstretch>0</verstretch>
                                       </sizepolicy>
                                      </property>
                                      <property name="minimumSize">
                                       <size>
                                        <width>0</width>
                                        <height>0</height>
                                       </size>
                                      </property>
                                      <property name="toolTip">
                                       <string>&lt;b&gt;Calculate a priori receiver position: Specify&lt;/b&gt;&lt;br&gt;&lt;br&gt;gLAB will automatically calculate the a priori receiver position, but starting from the user coordinates. These coordinates cannot be (0,0,0).&lt;br&gt;If a reference position file is given, the differential fields of the &lt;b&gt;OUTPUT&lt;/b&gt; message will be the difference between the gLAB solution and the position given in the reference file. If no reference file is given or there is no value in the reference file (for a given epoch), the differentials fields will be zero.&lt;br&gt;</string>
                                      </property>
                                      <property name="styleSheet">
                                       <string notr="true">color: rgb(0, 0, 0);</string>
                                      </property>
                                      <property name="text">
                                       <string>User defined</string>
                                      </property>
                                     </widget>
                                    </item>
