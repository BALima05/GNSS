                                               <size>
                                                <width>0</width>
                                                <height>20</height>
                                               </size>
                                              </property>
                                             </spacer>
                                            </item>
                                           </layout>
                                          </widget>
                                          <widget class="QWidget" name="pageStdDevGalileoDGNSS_1">
                                           <layout class="QGridLayout" name="gridLayout_948">
