                          <item row="1" column="0">
                           <widget class="QLabel" name="labelNavTypeGPS">
                            <property name="toolTip">
                             <string>&lt;b&gt;GPS&lt;/b&gt;&lt;br&gt;&lt;br&gt;Set the priority order for GPS navigation message selection. The selected navigation messages will be used for computing orbits and clocks. See &lt;i&gt;Preferred age time&lt;/i&gt; below for details on the navigation message selection algorithm.&lt;br&gt;&lt;br&gt;The navigation message types supported for GPS are:&lt;ul&gt;&lt;li&gt;&lt;b&gt;LNAV:&lt;/b&gt; Legacy navigation message sent in the L1 C/A, L1P and L2P signals.&lt;/li&gt;&lt;li&gt;&lt;b&gt;CNAV-1:&lt;/b&gt; Civil navigation message sent in L2C and L5 signals.&lt;/li&gt;&lt;/ul&gt;&lt;b&gt;NOTE:&lt;/b&gt; CNAV-1 is only supported with the &lt;b&gt;unofficial&lt;/b&gt; MGEX RINEX navigation file version '4.00' (files with extension &lt;i&gt;.YYx&lt;/i&gt;).&lt;br&gt;</string>
                            </property>
                            <property name="styleSheet">
                             <string notr="true">color: rgb(0, 0, 0);</string>
                            </property>
                            <property name="text">
                             <string>GPS</string>
                            </property>
                           </widget>
