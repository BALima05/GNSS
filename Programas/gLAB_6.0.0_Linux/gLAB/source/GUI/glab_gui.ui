                                 </widget>
                                </item>
                                <item row="1" column="0">
                                 <widget class="QLabel" name="label_573">
                                  <property name="toolTip">
                                   <string>&lt;b&gt;Time Period Thresholds (Hor/Ver/3D)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Set the Horizontal, Vertical and 3D positioning error time period thresholds (in seconds) to compute the convergence time using positioning errors.&lt;br&gt;&lt;br&gt;Convergence time will be computed with two methodologies:&lt;ol&gt;&lt;li&gt;Convergence is declared in the first epoch where the positioning error value is equal or below the threshold set in option &lt;i&gt;Positioning Error Thresholds (Hor/Ver/3D)&lt;/i&gt; (even though in later epochs the positioning error increases again over the threshold). &lt;/li&gt;&lt;li&gt;Convergence is declared when the positioning error is equal or below the threshold  set in option &lt;i&gt;Positioning Error Thresholds (Hor/Ver/3D)&lt;/i&gt; and it is maintained during the user defined amount of time set in option &lt;i&gt;Time Period Thresholds (Hor/Ver/3D)&lt;/i&gt;. If the positioning error is equal or below the threshold during the specified time, the convergence time is referred to the first epoch (of this period) with positioning error equal or below the threshold. Otherwise, if the positioning error goes over the threshold, the time period is reset and will start again on the next epoch with positioning error equal or below the threshold.&lt;/li&gt;&lt;/ol&gt;&lt;b&gt;NOTES:&lt;/b&gt;&lt;ul&gt;&lt;li&gt;This method for computing convergence time is only available when a reference position is available, as a reference position is required to compute the positioning error.&lt;/li&gt;&lt;li&gt;Each component is evaluated independently from each other.&lt;/li&gt;&lt;li&gt;Convergence time computed using formal errors is independent from the convergence time computed using positioning errors.&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;</string>
                                  </property>
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>Time Period Thresholds (Hor/Ver/3D)</string>
                                  </property>
                                 </widget>
                                </item>
                                <item row="2" column="0">
                                 <spacer name="verticalSpacer_71">
                                  <property name="orientation">
                                   <enum>Qt::Vertical</enum>
                                  </property>
                                  <property name="sizeHint" stdset="0">
                                   <size>
                                    <width>20</width>
                                    <height>0</height>
                                   </size>
                                  </property>
                                 </spacer>
                                </item>
                                <item row="1" column="1">
                                 <widget class="QLineEdit" name="lineEditSummaryConvergencePositionTimeThresHor">
                                  <property name="sizePolicy">
                                   <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
                                    <horstretch>0</horstretch>
                                    <verstretch>0</verstretch>
                                   </sizepolicy>
                                  </property>
                                  <property name="minimumSize">
                                   <size>
                                    <width>60</width>
                                    <height>25</height>
                                   </size>
                                  </property>
