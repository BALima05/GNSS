                                <item row="1" column="0">
                                 <widget class="QCheckBox" name="checkBoxSetOneDFREISigmaConversionValue">
                                  <property name="minimumSize">
                                   <size>
                                    <width>0</width>
                                    <height>25</height>
                                   </size>
                                  </property>
                                  <property name="toolTip">
                                   <string>&lt;b&gt;Set one DFREI Sigma Conversion Value&lt;/b&gt;&lt;br&gt;&lt;br&gt;Manually set the conversion value to metres for one DFREI (Dual Frequency Range Error Indicator) value, ignoring the conversion formula defined in MT37 (&lt;i&gt;OBAD Parameters and DFREI Scale Table&lt;/i&gt;) for the selected DFREI value only. This conversion value will be applied to all satellites of all constellations.&lt;br&gt;&lt;br&gt;If user needs to set the conversion value for more than one DFREI, then option below &lt;i&gt;Set All DFREI Conversion Values&lt;/i&gt; must be used instead (which sets conversion value for all DFREI).&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTE:&lt;/b&gt; In command line, it is possible to set conversion values for multiple DFREI by providing parameter '-model:sbasdfmc:dfrei' as many times as DFREI conversion values need to be set.&lt;br&gt;</string>
                                  </property>
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>Set one DFREI Sigma Conversion Value</string>
                                  </property>
                                 </widget>
                                </item>
                                <item row="2" column="0" colspan="2">
                                 <widget class="QCheckBox" name="checkBoxSetAllDFREIConversionValues">
                                  <property name="minimumSize">
                                   <size>
                                    <width>0</width>
                                    <height>25</height>
                                   </size>
                                  </property>
                                  <property name="toolTip">
                                   <string>&lt;b&gt;Set All DFREI Conversion Values&lt;/b&gt;&lt;br&gt;&lt;br&gt;Manually set conversion values to metres for all values of DFREI (Dual Frequency Range Error Indicator), ignoring the conversion formula defined in MT37 (&lt;i&gt;OBAD Parameters and DFREI Scale Table&lt;/i&gt;).&lt;br&gt;&lt;br&gt;This option requires to set the conversion values for all values of DFREIs, therefore, a set of values are provided by default as a guidance to the user. These values correspond to the intermidiate value between the mininum and maximum values set in ED-259 (see tooltips for each DFREI for additional details).&lt;br&gt;</string>
                                  </property>
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
