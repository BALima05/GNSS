                          <item row="6" column="0">
                           <widget class="QLabel" name="labelNavTypeBDS">
                            <property name="toolTip">
                             <string>&lt;b&gt;BDS&lt;/b&gt;&lt;br&gt;&lt;br&gt;Set the priority order for BeiDou navigation message selection. The selected navigation messages will be used for computing orbits and clocks. See &lt;i&gt;Preferred age time&lt;/i&gt; below for details on the navigation message selection algorithm.&lt;br&gt;&lt;br&gt;The navigation message type supported for BeiDou is:&lt;ul&gt;&lt;li&gt;&lt;b&gt;D1:&lt;/b&gt; Navigation message sent in the BeiDou-2 B1I (F2) signal on MEO (Medium Earth Orbit) and IGSO (Inclined Geo-Synchronous Orbit) satellites. &lt;br&gt;&lt;/li&gt;&lt;/ul&gt;</string>
                            </property>
                            <property name="styleSheet">
                             <string notr="true">color: rgb(0, 0, 0);</string>
                            </property>
                            <property name="text">
                             <string>BDS</string>
                            </property>
                           </widget>
                          </item>
                          <item row="0" column="0" colspan="2">
                           <widget class="QFrame" name="frameOptionButtonNavTypes">
                            <property name="sizePolicy">
                             <sizepolicy hsizetype="Preferred" vsizetype="Minimum">
                              <horstretch>0</horstretch>
                              <verstretch>0</verstretch>
                             </sizepolicy>
                            </property>
                            <property name="frameShape">
                             <enum>QFrame::NoFrame</enum>
                            </property>
                            <property name="frameShadow">
                             <enum>QFrame::Raised</enum>
                            </property>
                            <layout class="QGridLayout" name="gridLayout_619">
                             <property name="leftMargin">
                              <number>0</number>
                             </property>
                             <property name="topMargin">
                              <number>0</number>
                             </property>
                             <property name="rightMargin">
                              <number>0</number>
                             </property>
                             <property name="bottomMargin">
                              <number>6</number>
                             </property>
                             <property name="verticalSpacing">
                              <number>0</number>
                             </property>
                             <item row="0" column="0">
                              <widget class="QPushButton" name="pushButtonNavMessageTypesBoost">
                               <property name="toolTip">
                                <string>&lt;b&gt;&amp;lt;&amp;lt; (Move Left)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Move left the current selected cell (navigation message type). The further to the left side the cell (navigation message type) is, the higher priority the navigation message type has.&lt;br&gt;&lt;br&gt;The order of selection of navigation message type is for computing orbits and clocks. See &lt;i&gt;Preferred age time&lt;/i&gt; below for details on the navigation message selection algorithm.&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTES:&lt;/b&gt;&lt;ul&gt;&lt;li&gt;Cells in red mean that the selected navigation message type will not be used. To unselect (turn red) a navigation message type, double click on a cell. Double clicking again will undo the navigation message type unselection.&lt;/li&gt;&lt;li&gt;The order of the navigation message type does not affect DCBs, as each DCB is provided in specific navigation messages.&lt;li&gt;&lt;/ul&gt;</string>
                               </property>
                               <property name="text">
                                <string>&lt;&lt;</string>
                               </property>
                              </widget>
                             </item>
                             <item row="0" column="1">
                              <widget class="QPushButton" name="pushButtonNavMessageTypesLower">
                               <property name="toolTip">
                                <string>&lt;b&gt;&amp;gt;&amp;gt; (Move Right)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Move right the current selected cell (navigation message type). The further to the right side the cell (navigation message type) is, the lower priority the navigation message type has.&lt;br&gt;&lt;br&gt;The order of selection of navigation message type is for computing orbits and clocks. See &lt;i&gt;Preferred age time&lt;/i&gt; below for details on the navigation message selection algorithm.&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTES:&lt;/b&gt;&lt;ul&gt;&lt;li&gt;Cells in red mean that the selected navigation message type will not be used. To unselect (turn red) a navigation message type, double click on a cell. Double clicking again will undo the navigation message type unselection.&lt;/li&gt;&lt;li&gt;The order of the navigation message type does not affect DCBs, as each DCB is provided in specific navigation messages.&lt;li&gt;&lt;/ul&gt;</string>
                               </property>
                               <property name="text">
                                <string>&gt;&gt;</string>
                               </property>
                              </widget>
                             </item>
