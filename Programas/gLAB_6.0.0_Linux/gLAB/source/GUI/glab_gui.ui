                                        <item row="0" column="9">
                                         <widget class="QComboBox" name="comboBoxStdDevModePhaseGLONASS_1">
                                          <property name="minimumSize">
                                           <size>
                                            <width>128</width>
                                            <height>0</height>
                                           </size>
                                          </property>
                                          <property name="focusPolicy">
                                           <enum>Qt::StrongFocus</enum>
                                          </property>
                                          <item>
                                           <property name="text">
                                            <string>Fixed</string>
                                           </property>
                                          </item>
                                          <item>
                                           <property name="text">
                                            <string>Elevation</string>
                                           </property>
                                          </item>
                                          <item>
                                           <property name="text">
                                            <string>sin(Elevation)</string>
                                           </property>
                                          </item>
                                          <item>
