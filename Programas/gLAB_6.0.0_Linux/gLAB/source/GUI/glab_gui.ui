                              <item row="0" column="0">
                               <widget class="QLabel" name="label_86">
                                <property name="minimumSize">
                                 <size>
                                  <width>145</width>
                                  <height>0</height>
                                 </size>
                                </property>
                                <property name="maximumSize">
                                 <size>
                                  <width>145</width>
                                  <height>16777215</height>
                                 </size>
                                </property>
                                <property name="font">
                                 <font>
                                  <weight>50</weight>
                                  <bold>false</bold>
                                 </font>
                                </property>
                                <property name="toolTip">
                                 <string>&lt;b&gt;Troposphere&lt;/b&gt;&lt;br&gt;&lt;br&gt;This parameter estimates the 10% of the troposphere that is not taken into account in the nominal model (see &lt;i&gt;Modelling&lt;/i&gt; section). This 10% is associated with the wet component of the troposphere, which is due to the water vapour of the atmosphere. The mapping m&lt;i&gt;&lt;font size=&quot;-2&quot;&gt;wet&lt;/font&gt;&lt;/i&gt;(elev) function described in the &lt;i&gt;Modelling&lt;/i&gt; section is used in the troposphere estimation. Typical values:&lt;ul&gt;&lt;li&gt;&lt;b&gt;A priori value:&lt;/b&gt; '0'&lt;/li&gt;&lt;li&gt;&lt;b&gt;Phi:&lt;/b&gt; '1'&lt;/li&gt;&lt;li&gt;&lt;b&gt;Process noise:&lt;/b&gt; '1e-4' in units of [m²/h] (i.e, 1 cm&lt;sup&gt;2&lt;/sup&gt;/h). Contrary to the rest of parameters, troposphere process noise is given as increase of &lt;b&gt;Q&lt;/b&gt; per time unit&lt;/li&gt;&lt;li&gt;&lt;b&gt;Initial covariance:&lt;/b&gt; '0.25' (equivalent to 0.5 metres of uncertainty).&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;</string>
                                </property>
                                <property name="styleSheet">
                                 <string notr="true">color: rgb(0, 0, 0);</string>
                                </property>
                                <property name="text">
                                 <string>Troposphere</string>
                                </property>
                               </widget>
                              </item>
