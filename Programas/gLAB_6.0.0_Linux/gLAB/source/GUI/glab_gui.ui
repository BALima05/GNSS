                                      <item row="0" column="2">
                                       <widget class="QRadioButton" name="radioButtonGPSReceiverTypeUserSelection">
                                        <property name="toolTip">
                                         <string>&lt;b&gt;GPS Receiver Manual Selection&lt;/b&gt;&lt;br&gt;&lt;br&gt;Manually select a GPS Receiver Type. &lt;br&gt;&lt;br&gt;&lt;b&gt;NOTE:&lt;/b&gt; If user selects receiver type 2, P1-C1 file will not be necessary (but it is recommended). This is to account for receivers that state in the header that P1 measurement is available, but all the P1 measurements have a value of 0. When receiver type 2 is set by the user, gLAB will ignore P1 measurement instead of trying to use this measurement in the cycle-slip detectors.&lt;br&gt;</string>
                                        </property>
                                        <property name="styleSheet">
                                         <string notr="true">color: rgb(0, 0, 0);</string>
                                        </property>
                                        <property name="text">
