                                           </size>
                                          </property>
                                         </spacer>
                                        </item>
                                        <item row="0" column="12">
                                         <widget class="QLineEdit" name="lineEditStdDevPhaseAQZSS_3">
                                          <property name="maximumSize">
                                           <size>
                                            <width>55</width>
