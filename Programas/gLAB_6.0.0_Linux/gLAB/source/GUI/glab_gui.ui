                           <number>0</number>
                          </property>
                          <item row="1" column="0">
                           <widget class="QCheckBox" name="checkBoxStrictRadome">
                            <property name="toolTip">
                             <string>&lt;b&gt;Stop processing if Antenna's Radome is not found in ANTEX&lt;/b&gt;&lt;br&gt;&lt;br&gt;When searching for Antenna Phase Centre data of the receiver in the ANTEX, gLAB will try to match the antenna type and radome read in the RINEX observation file header record &lt;b&gt;ANT # / TYPE&lt;/b&gt; with the ones in the ANTEX records with &lt;b&gt;TYPE / SERIAL NO&lt;/b&gt;.&lt;br&gt;If this option is enabled, both antenna type and radome must match.&lt;br&gt;If this option is disabled,  if antenna type and radome do not match, then radome will be set to &quot;NONE&quot;, which is always present for each antenna type given in the ANTEX file.&lt;br&gt;</string>
                            </property>
                            <property name="styleSheet">
                             <string notr="true">color: rgb(0, 0, 0);</string>
                            </property>
                            <property name="text">
                             <string>Stop processing if Antenna's Radome is not found in ANTEX</string>
                            </property>
                           </widget>
                          </item>
                          <item row="0" column="0">
                           <widget class="QCheckBox" name="checkBoxReceiverAntennaPhaseCentreVariation">
                            <property name="toolTip">
                             <string>&lt;b&gt;Receiver Antenna Phase Centre Variation&lt;font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Antenna Reference Point Correction has an additional term which is dependent on the satellite elevation, and it is also provided in the ANTEX file. This additional term is provided in two ways in the ANTEX file: One set of corrections elevation dependent but independent of the azimuth, and another set dependent on elevation and azimuth. gLAB reads both corrections, but only applies the non azimuth dependent, as the correction variation between azimuth dependent and non azimuth dependent is typically around 0.5 mm.&lt;br&gt;This correction can be up to &lt;font color=&quot;red&quot;&gt;1-5 mm.&lt;/font&gt;&lt;br&gt;See description of ANTEX files in:&lt;br&gt;&lt;font color=&quot;#0000FF&quot;&gt;Help-&gt;File formats description&lt;/font&gt;&lt;br&gt;</string>
                            </property>
                            <property name="styleSheet">
                             <string notr="true">color: rgb(0, 0, 0);</string>
                            </property>
                            <property name="text">
                             <string>Receiver Antenna Phase Centre Variation</string>
                            </property>
                           </widget>
                          </item>
                         </layout>
                        </widget>
                       </item>
