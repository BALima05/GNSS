                                           <item row="0" column="3">
                                            <widget class="QLabel" name="label_800">
                                             <property name="toolTip">
                                              <string>&lt;b&gt;Phase1:&lt;/b&gt;&lt;br&gt;&lt;br&gt;Set the carrier phase measurement (for single frequency or graphic combination) or the first carrier phase measurement (for ionospheric-free or divergence-free combinations) for smoothing the first GEO code measurement.&lt;br&gt;</string>
                                             </property>
                                             <property name="styleSheet">
                                              <string notr="true">color: rgb(0, 0, 0);</string>
                                             </property>
