                            <property name="font">
                             <font>
                              <pointsize>9</pointsize>
                              <weight>75</weight>
                              <bold>true</bold>
                             </font>
                            </property>
                            <property name="title">
                             <string>Show Disable Specific Sigmas</string>
                            </property>
                            <property name="checkable">
                             <bool>true</bool>
                            </property>
                            <property name="checked">
                             <bool>true</bool>
                            </property>
                            <layout class="QGridLayout" name="gridLayout_136">
                             <property name="verticalSpacing">
                              <number>3</number>
                             </property>
                             <item row="0" column="0">
                              <widget class="QFrame" name="frameDisableSpecificSigmas">
                               <property name="frameShape">
                                <enum>QFrame::NoFrame</enum>
                               </property>
                               <property name="frameShadow">
                                <enum>QFrame::Raised</enum>
                               </property>
                               <layout class="QGridLayout" name="gridLayout_138">
                                <property name="leftMargin">
                                 <number>0</number>
                                </property>
                                <property name="topMargin">
                                 <number>0</number>
                                </property>
                                <property name="rightMargin">
                                 <number>0</number>
                                </property>
                                <property name="bottomMargin">
                                 <number>0</number>
                                </property>
                                <item row="0" column="0">
                                 <widget class="QCheckBox" name="checkBoxDisableFastCorrectionsSigma">
                                  <property name="toolTip">
                                   <string>&lt;b&gt;Disable Fast Corrections Sigma and Degradation term&lt;/b&gt;&lt;br&gt;&lt;br&gt;Set &amp;sigma;&lt;sub&gt;UDRE&lt;/sub&gt; and &amp;epsilon;&lt;sub&gt;fc&lt;/sub&gt; to 0 if they are applied (see &lt;i&gt;Degradation Parameters&lt;/i&gt; tooltip in &lt;i&gt;Message Time-outs&lt;/i&gt; groupbox). RRC degradation term (&amp;epsilon;&lt;sub&gt;rrc&lt;/sub&gt;) will be also set to 0, as a RRC degradation term is tied to fast corrections). The conditions to apply a fast correction must be fulfilled (if they are not fulfilled, fast corrections will be declared as not available).&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTE:&lt;/b&gt; If all sigmas and degradation terms are set to 0, the total sigma computed for the satellite will be 0. In this case, gLAB will use a sigma of 1 centimetre to avoid division by zero.&lt;br&gt;</string>
                                  </property>
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>Disable Fast Corrections Sigma and Degradation term</string>
                                  </property>
                                 </widget>
                                </item>
                                <item row="3" column="0">
                                 <widget class="QCheckBox" name="checkBoxDisableSlowCorrectionsSigma">
                                  <property name="toolTip">
                                   <string>&lt;b&gt;Disable Slow Corrections Degradation term&lt;/b&gt;&lt;br&gt;&lt;br&gt;Set &amp;epsilon;&lt;sub&gt;ltc&lt;/sub&gt; to 0 if it is applied (see &lt;i&gt;Degradation Parameters&lt;/i&gt; tooltip in &lt;i&gt;Message Time-outs&lt;/i&gt; groupbox). The conditions to apply a slow correction must be fulfilled (if they are not fulfilled, slow corrections will be declared as not available).&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTE:&lt;/b&gt; If all sigmas and degradation terms are set to 0, the total sigma computed for the satellite will be 0. In this case, gLAB will use a sigma of 1 centimetre to avoid division by zero.&lt;br&gt;</string>
                                  </property>
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>Disable Slow Corrections Degradation term</string>
                                  </property>
                                 </widget>
                                </item>
                                <item row="2" column="0">
                                 <widget class="QCheckBox" name="checkBoxDisableRRCsigma">
                                  <property name="toolTip">
                                   <string>&lt;b&gt;Disable Fast Corrections Sigma and Degradation term&lt;/b&gt;&lt;br&gt;&lt;br&gt;Set &amp;epsilon;&lt;sub&gt;rrc&lt;/sub&gt; to 0 if it is applied (see &lt;i&gt;Degradation Parameters&lt;/i&gt; tooltip in &lt;i&gt;Message Time-outs&lt;/i&gt; groupbox). The conditions to apply a range rate correction must be fulfilled (if they are not fulfilled, RRC corrections will be declared as not available).&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTE:&lt;/b&gt; If all sigmas and degradation terms are set to 0, the total sigma computed for the satellite will be 0. In this case, gLAB will use a sigma of 1 centimetre to avoid division by zero.&lt;br&gt;</string>
                                  </property>
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>Disable RRC Degradation term</string>
                                  </property>
                                 </widget>
                                </item>
                                <item row="4" column="0">
                                 <widget class="QCheckBox" name="checkBoxDisableIonosphereSigma">
                                  <property name="toolTip">
                                   <string>&lt;b&gt;Disable Ionosphere Sigma&lt;/b&gt;&lt;br&gt;&lt;br&gt;Set the satellite's computed ionosphere sigma (&amp;sigma;&lt;sub&gt;ionosphere&lt;/sub&gt;) to 0. The conditions to apply a ionosphere correction must be fulfilled (if they are not fulfilled, ionosphere corrections will be declared as not available).&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTE:&lt;/b&gt; If all sigmas and degradation terms are set to 0, the total sigma computed for the satellite will be 0. In this case, gLAB will use a sigma of 1 centimetre to avoid division by zero.&lt;br&gt;</string>
                                  </property>
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>Disable Ionosphere Sigma</string>
                                  </property>
                                 </widget>
                                </item>
                                <item row="5" column="0">
                                 <widget class="QCheckBox" name="checkBoxDisableTroposphereSigma">
                                  <property name="toolTip">
                                   <string>&lt;b&gt;Disable Troposphere Sigma&lt;/b&gt;&lt;br&gt;&lt;br&gt;Set the satellite's computed troposphere sigma (&amp;sigma;&lt;sub&gt;troposphere&lt;/sub&gt;) to 0.&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTE:&lt;/b&gt; If all sigmas and degradation terms are set to 0, the total sigma computed for the satellite will be 0. In this case, gLAB will use a sigma of 1 centimetre to avoid division by zero.&lt;br&gt;</string>
                                  </property>
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>Disable Troposphere Sigma</string>
                                  </property>
                                 </widget>
                                </item>
                                <item row="6" column="0">
                                 <widget class="QCheckBox" name="checkBoxDisableEnRoute">
                                  <property name="toolTip">
                                   <string>&lt;b&gt;Disable En Route Through NPA Degradation Term&lt;/b&gt;&lt;br&gt;&lt;br&gt;Set &amp;epsilon;&lt;sub&gt;eer&lt;/sub&gt; to 0 if it is applied (see &lt;i&gt;Degradation Parameters&lt;/i&gt; tooltip in &lt;i&gt;Message Time-outs&lt;/i&gt; groupbox). The conditions to apply a fast or slow correction must be fulfilled (if they are not fulfilled, they will be declared as not available).&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTE:&lt;/b&gt; If all sigmas and degradation terms are set to 0, the total sigma computed for the satellite will be 0. In this case, gLAB will use a sigma of 1 centimetre to avoid division by zero.&lt;br&gt;y</string>
                                  </property>
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>Disable En Route Through NPA Degradation Term</string>
                                  </property>
                                 </widget>
                                </item>
                                <item row="1" column="0">
                                 <widget class="QCheckBox" name="checkBoxDisableFastDegradationSigma">
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>Disable Fast Correction Degradation term</string>
                                  </property>
                                 </widget>
                                </item>
                               </layout>
                              </widget>
                             </item>
                            </layout>
                           </widget>
                          </item>
                          <item row="8" column="0">
                           <widget class="QFrame" name="frameSBASSignalFlightTime">
                            <property name="frameShape">
                             <enum>QFrame::NoFrame</enum>
                            </property>
                            <property name="frameShadow">
                             <enum>QFrame::Raised</enum>
                            </property>
                            <layout class="QGridLayout" name="gridLayout_226">
                             <property name="leftMargin">
                              <number>0</number>
                             </property>
                             <property name="topMargin">
                              <number>0</number>
                             </property>
                             <property name="rightMargin">
                              <number>0</number>
                             </property>
                             <property name="bottomMargin">
                              <number>0</number>
                             </property>
                             <item row="0" column="3">
                              <spacer name="horizontalSpacer_32">
                               <property name="orientation">
                                <enum>Qt::Horizontal</enum>
                               </property>
                               <property name="sizeHint" stdset="0">
                                <size>
                                 <width>0</width>
                                 <height>20</height>
                                </size>
                               </property>
                              </spacer>
                             </item>
                             <item row="0" column="0">
                              <widget class="QLabel" name="label_153">
                               <property name="toolTip">
                                <string>&lt;b&gt;SBAS Signal Flight Time&lt;/b&gt;&lt;br&gt;&lt;br&gt;Set the SBAS signal flight time of each message read (default flight time applied is 0.12 seconds). This value overrides any flight time read in RINEX-B or EMS files.&lt;br&gt;&lt;br&gt;When the signal flight time is greater than zero, the SBAS message si delayed by the signal flight time, and therefore the process of the SBAS message will be delayed until the epoch where the last bit of the message has arrived.&lt;br&gt;&lt;br&gt;For instance, with a 1Hz receiver:&lt;ul&gt;&lt;li&gt;Message with RINEX-B timestamp (referred to first bit of the message) of 10:00:00.1:&lt;ul&gt;&lt;li&gt;&lt;b&gt;With 0.12 seconds signal flight time:&lt;/b&gt; Message will be processed at epoch 10:00:02.&lt;/li&gt;&lt;li&gt;&lt;b&gt;With 0 seconds signal flight time:&lt;/b&gt; Message will be processed at epoch 10:00:01.&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li&gt;Message with EMS timestamp (referred to last bit of the message) of 10:00:00:&lt;ul&gt;&lt;li&gt;&lt;b&gt;With 0.12 seconds signal flight time:&lt;/b&gt; Message will be processed at epoch 10:00:01.&lt;/li&gt;&lt;li&gt;&lt;b&gt;With 0 seconds signal flight time:&lt;/b&gt; Message will be processed at epoch 10:00:00.&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;/ul&gt;</string>
                               </property>
                               <property name="styleSheet">
                                <string notr="true">color: rgb(0, 0, 0);</string>
                               </property>
                               <property name="text">
                                <string>SBAS Signal Flight Time</string>
                               </property>
                              </widget>
                             </item>
                             <item row="0" column="1">
                              <widget class="QLineEdit" name="lineEditSBASSignalFlightTime">
                               <property name="clearButtonEnabled">
                                <bool>true</bool>
                               </property>
                              </widget>
                             </item>
                             <item row="0" column="2">
                              <widget class="QLabel" name="label_342">
                               <property name="styleSheet">
                                <string notr="true">color: rgb(0, 0, 0);</string>
                               </property>
                               <property name="text">
                                <string>(s)</string>
                               </property>
                              </widget>
                             </item>
                            </layout>
                           </widget>
                          </item>
