                        <item row="1" column="1">
                         <widget class="QCheckBox" name="checkBoxShowNavMessageTypeGPS">
                          <property name="minimumSize">
                           <size>
                            <width>0</width>
                            <height>25</height>
                           </size>
                          </property>
                          <property name="maximumSize">
                           <size>
                            <width>16777215</width>
                            <height>25</height>
                           </size>
                          </property>
                          <property name="toolTip">
                           <string>&lt;b&gt;GPS&lt;/b&gt;&lt;br&gt;&lt;br&gt;Select or unselect GPS constellation for orbit computation. If selected, set the priority order for GPS navigation message selection. The selected navigation messages will be used for computing orbits and clocks. See &lt;i&gt;Preferred age time&lt;/i&gt; below for details on the navigation message selection algorithm.&lt;br&gt;&lt;br&gt;The navigation message types supported for GPS are:&lt;ul&gt;&lt;li&gt;&lt;b&gt;LNAV:&lt;/b&gt; Legacy navigation message sent in the L1 C/A, L1P and L2P signals.&lt;/li&gt;&lt;li&gt;&lt;b&gt;CNAV-1:&lt;/b&gt; Civil navigation message sent in L2C and L5 signals.&lt;/li&gt;&lt;/ul&gt;&lt;b&gt;NOTE:&lt;/b&gt; CNAV-1 is only supported with the &lt;b&gt;unofficial&lt;/b&gt; MGEX RINEX navigation file version '4.00' (files with extension &lt;i&gt;.YYx&lt;/i&gt;).&lt;br&gt;</string>
                          </property>
                          <property name="styleSheet">
                           <string notr="true">color: rgb(0, 0, 0);</string>
                          </property>
                          <property name="text">
                           <string>GPS</string>
                          </property>
                         </widget>
                        </item>
                        <item row="8" column="1">
                         <widget class="QCheckBox" name="checkBoxShowNavMessageTypeIRNSS">
                          <property name="minimumSize">
                           <size>
                            <width>0</width>
                            <height>25</height>
                           </size>
                          </property>
                          <property name="maximumSize">
                           <size>
                            <width>16777215</width>
                            <height>25</height>
                           </size>
                          </property>
                          <property name="toolTip">
                           <string>&lt;b&gt;IRNSS&lt;/b&gt;&lt;br&gt;&lt;br&gt;Select or unselect IRNSS constellation for orbit computation. If set the priority order for IRNSS navigation message selection. The selected navigation messages will be used for computing orbits and clocks. See &lt;i&gt;Preferred age time&lt;/i&gt; below for details on the navigation message selection algorithm.&lt;br&gt;&lt;br&gt;The navigation message type supported for IRNSS is:&lt;ul&gt;&lt;li&gt;&lt;b&gt;CNAV:&lt;/b&gt; Civil navigation message sent in the L5 signal.&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;</string>
                          </property>
                          <property name="styleSheet">
                           <string notr="true">color: rgb(0, 0, 0);</string>
                          </property>
                          <property name="text">
                           <string>IRNSS</string>
                          </property>
                         </widget>
                        </item>
                        <item row="2" column="1">
                         <widget class="QCheckBox" name="checkBoxShowNavMessageTypeGalileo">
                          <property name="minimumSize">
                           <size>
                            <width>0</width>
                            <height>25</height>
                           </size>
                          </property>
                          <property name="maximumSize">
                           <size>
                            <width>16777215</width>
                            <height>25</height>
                           </size>
                          </property>
                          <property name="toolTip">
                           <string>&lt;b&gt;Galileo&lt;/b&gt;&lt;br&gt;&lt;br&gt;Select or unselect Galileo constellation for orbit computation. If set the priority order for Galileo navigation message selection. The selected navigation messages will be used for computing orbits and clocks. See &lt;i&gt;Preferred age time&lt;/i&gt; below for details on the navigation message selection algorithm.&lt;br&gt;&lt;br&gt;The navigation message types supported for Galileo are:&lt;ul&gt;&lt;li&gt;&lt;b&gt;FNAV:&lt;/b&gt; Free navigation message sent in E5a signal. F/NAV dock correction is referred to the E1-E5a combination.&lt;/li&gt;&lt;li&gt;&lt;b&gt;I/NAV E1:&lt;/b&gt; Integrity navigation message sent in E1-B signal. I/NAV dock correction is referred to the E1-E5b combination.&lt;/li&gt;&lt;li&gt;&lt;b&gt;I/NAV E5b:&lt;/b&gt; Integrity navigation message sent in E5b signal. I/NAV dock correction is referred to the E1-E5b combination.&lt;/li&gt;&lt;li&gt;&lt;b&gt;I/NAV E1E5b:&lt;/b&gt; Integrity navigation message merging the info from E1-B and E5b signals. I/NAV dock correction is referred to the E1-E5b combination.&lt;/li&gt;&lt;/ul&gt;&lt;b&gt;NOTE:&lt;/b&gt; The only difference between I/NAV E1, I/NAV E5b and I/NAV E1E5b in the RINEX navigation file are the health and validity status flags. I/NAV E1 only has the flags for E1, I/NAV E5b for E5b and  I/NAV E1E5b for both E1 and E5b.&lt;br&gt;</string>
                          </property>
                          <property name="styleSheet">
                           <string notr="true">color: rgb(0, 0, 0);</string>
                          </property>
                          <property name="text">
                           <string>Galileo</string>
                          </property>
                         </widget>
                        </item>
                        <item row="7" column="1">
                         <widget class="QCheckBox" name="checkBoxShowNavMessageTypeQZSS">
                          <property name="minimumSize">
