                             <item row="0" column="1" alignment="Qt::AlignLeft">
                              <widget class="QRadioButton" name="radioButtonOrbitPrecise1file">
                               <property name="toolTip">
                                <string>&lt;b&gt;Precise orbit and clocks (1 file)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Selects as orbit and clock products source an &lt;b&gt;SP3&lt;/b&gt; file. This file contains the orbits and clocks of the satellite at specific times. The orbit and clock interpolation degrees in the &lt;i&gt;Modelling&lt;/i&gt; section affects the computation of orbit and clocks in this mode.&lt;br&gt;</string>
                               </property>
                               <property name="styleSheet">
                                <string notr="true">color: rgb(0, 0, 0);</string>
                               </property>
