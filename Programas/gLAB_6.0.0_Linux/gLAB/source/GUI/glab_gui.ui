                     <item row="1" column="0" colspan="2">
                      <widget class="QCheckBox" name="checkBoxSatClockOffsetShowOrbit">
                       <property name="font">
                        <font>
                         <weight>50</weight>
                         <bold>false</bold>
                        </font>
                       </property>
                       <property name="toolTip">
                        <string>&lt;b&gt;Compute Satellite Clock Correction&lt;/b&gt;&lt;br&gt;&lt;br&gt;Compute the satellite clock offsets from the selected file. If this option is disabled, only the satellite coordinates and velocity are computed. Thus, the result of the clock field is set to zero. This option is useful when &lt;b&gt;SP3&lt;/b&gt; file contains 9999 values for the satellite clocks.</string>
                       </property>
                       <property name="styleSheet">
                        <string notr="true">color: rgb(0, 0, 0);</string>
                       </property>
                       <property name="text">
                        <string>Compute Satellite Clock Correction</string>
                       </property>
                      </widget>
                     </item>
