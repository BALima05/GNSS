                                 <width>0</width>
                                 <height>25</height>
                                </size>
                               </property>
                               <property name="sizeIncrement">
                                <size>
                                 <width>0</width>
                                 <height>0</height>
                                </size>
                               </property>
                               <property name="baseSize">
                                <size>
                                 <width>0</width>
                                 <height>0</height>
                                </size>
                               </property>
                               <property name="toolTip">
                                <string>&lt;b&gt;Fixed Sigma Multipath&lt;/b&gt;&lt;br&gt;&lt;br&gt;Apply the following formula for the &amp;sigma;&lt;sub&gt;multipath&lt;/sub&gt;:&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;sigma;&lt;sub&gt;multipath&lt;/sub&gt;[i] = a + b·e&lt;sup&gt;(-&amp;theta;[i]/c)&lt;/sup&gt; (metres)&lt;br&gt;&lt;br&gt;&lt;i&gt;a&lt;/i&gt;, &lt;i&gt;b&lt;/i&gt; and &lt;i&gt;c&lt;/i&gt; are the values provided by the user (being &lt;i&gt;a&lt;/i&gt; and &lt;i&gt;b&lt;/i&gt; in metres and &lt;i&gt;c&lt;/i&gt; in degrees). &amp;theta;[i] is the satellite's elevation.&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTES:&lt;/b&gt;&lt;ul&gt;&lt;li&gt;To set &amp;sigma;&lt;sub&gt;multipath&lt;/sub&gt; to a fixed value, set &lt;i&gt;b&lt;/i&gt; = 0 and &lt;i&gt;a&lt;/i&gt; to the fixed value.&lt;/li&gt;&lt;li&gt;If &amp;sigma;&lt;sub&gt;multipath&lt;/sub&gt; is not set (either with this option or with the user defined sigma multipath model option), the default value for a class 2, 3, 4 receiver will be used.&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;</string>
                               </property>
                               <property name="styleSheet">
                                <string notr="true">color: rgb(0, 0, 0);</string>
                               </property>
                               <property name="text">
                                <string>Fixed Sigma Multipath</string>
                               </property>
                              </widget>
                             </item>
                             <item row="0" column="1" colspan="2">
                              <widget class="QCheckBox" name="checkBoxUserDefinedReceiverSigmaMultipathModel">
                               <property name="toolTip">
                                <string>&lt;b&gt;User defined Sigma Multipath Model&lt;/b&gt;&lt;br&gt;&lt;br&gt;Use the user defined sigma multipath model defined thorugh the input text file &lt;i&gt;Sigma Multipath File:&lt;/i&gt; in the INPUT section to compute the satellite's &amp;sigma;&lt;sub&gt;multipath&lt;/sub&gt;[i] .&lt;br&gt;In this file ,a sigma multipath is defined in function of the satellite elevation or SNR (Signal to Noise Ratio). In both cases, the user must set a table of samples (ordered from lowest elevation -or SNR- to highest) with its correspondent sigma value. Intermediate values will be linearly interpolated. See details on how to generate this file in the menu:&lt;br&gt;&lt;font color=&quot;#0000FF&quot;&gt;Help-&gt;User manauls-&gt;User Sigma Multipath File Manual&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTE:&lt;/b&gt; If &amp;sigma;&lt;sub&gt;multipath&lt;/sub&gt; is not set (either with this option or with the fixed sigma multipath option), the default value for a class 2, 3, 4 receiver will be used.&lt;br&gt;</string>
                               </property>
                               <property name="styleSheet">
                                <string notr="true">color: rgb(0, 0, 0);</string>
                               </property>
                               <property name="text">
                                <string>User defined Sigma Multipath Model</string>
                               </property>
                              </widget>
                             </item>
                             <item row="6" column="1">
                              <widget class="QCheckBox" name="checkBoxUserDefinedReceiverSigmaDivergence">
                               <property name="minimumSize">
                                <size>
                                 <width>0</width>
                                 <height>25</height>
                                </size>
                               </property>
                               <property name="baseSize">
                                <size>
                                 <width>0</width>
                                 <height>0</height>
                                </size>
                               </property>
                               <property name="toolTip">
                                <string>&lt;b&gt;Sigma Divergence&lt;/b&gt;&lt;br&gt;&lt;br&gt;Apply a fixed value to &amp;sigma;&lt;sub&gt;divergence&lt;/sub&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;NOTE:&lt;/b&gt; If &amp;sigma;&lt;sub&gt;divergence&lt;/sub&gt; is not set, the default value for a class 2, 3, 4 receiver will be used.&lt;br&gt;</string>
                               </property>
                               <property name="styleSheet">
                                <string notr="true">color: rgb(0, 0, 0);</string>
                               </property>
                               <property name="text">
                                <string>Sigma Divergence</string>
                               </property>
                              </widget>
                             </item>
                             <item row="2" column="1" colspan="3">
                              <widget class="QFrame" name="frameSigmaMultiPathFactor">
                               <property name="frameShape">
                                <enum>QFrame::NoFrame</enum>
                               </property>
                               <property name="frameShadow">
                                <enum>QFrame::Raised</enum>
                               </property>
                               <layout class="QGridLayout" name="gridLayout_234">
                                <property name="leftMargin">
                                 <number>0</number>
                                </property>
                                <property name="topMargin">
                                 <number>0</number>
                                </property>
                                <property name="rightMargin">
                                 <number>0</number>
                                </property>
                                <property name="bottomMargin">
                                 <number>0</number>
                                </property>
                                <item row="0" column="1">
                                 <widget class="QLineEdit" name="lineEditSigmaMultiPathFactor">
                                  <property name="clearButtonEnabled">
                                   <bool>true</bool>
                                  </property>
                                 </widget>
                                </item>
                                <item row="0" column="0">
                                 <widget class="QCheckBox" name="checkBoxSigmaMultiPathFactor">
                                  <property name="minimumSize">
                                   <size>
                                    <width>0</width>
                                    <height>25</height>
                                   </size>
                                  </property>
                                  <property name="toolTip">
                                   <string>&lt;b&gt;Set Sigma Multipath Factor&lt;/b&gt;&lt;br&gt;&lt;br&gt;In SBAS DFMC, it is necessary to account for the noise increase due to the iono-free combination. Therefore, the sigma multipath (computed in the same way as in SBAS 1F, see tooltip &lt;i&gt;Fixed Sigma Multipath&lt;/i&gt;) is multiplied by this factor to get the SBAS DFMC sigma multipath. As frequency L1 and L5 are used, the noise increase factor is 2.59.  The formula is:&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;sigma;&lt;sub&gt;Multipath_DFMC&lt;/sub&gt; = 2.59 · &amp;sigma;&lt;sub&gt;Multipath_SF&lt;/sub&gt; (metres)&lt;br&gt;</string>
                                  </property>
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>Set Sigma Multipath Factor</string>
                                  </property>
                                 </widget>
                                </item>
                                <item row="0" column="3">
                                 <spacer name="horizontalSpacer_55">
                                  <property name="orientation">
                                   <enum>Qt::Horizontal</enum>
                                  </property>
                                  <property name="sizeHint" stdset="0">
                                   <size>
                                    <width>0</width>
                                    <height>20</height>
                                   </size>
                                  </property>
                                 </spacer>
                                </item>
                                <item row="0" column="2">
                                 <widget class="QLabel" name="labelSigmaMultiPathFactor">
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>(adimensional)</string>
                                  </property>
                                 </widget>
                                </item>
                               </layout>
                              </widget>
                             </item>
                            </layout>
                           </widget>
                          </item>
                          <item row="0" column="1">
                           <spacer name="horizontalSpacer_46">
                            <property name="orientation">
                             <enum>Qt::Horizontal</enum>
                            </property>
                            <property name="sizeHint" stdset="0">
                             <size>
                              <width>0</width>
                              <height>0</height>
                             </size>
                            </property>
                           </spacer>
                          </item>
                         </layout>
                        </widget>
                       </item>
                       <item row="0" column="0">
                        <widget class="QLabel" name="label_295">
                         <property name="toolTip">
                          <string>&lt;b&gt;SBAS Application&lt;/b&gt;&lt;br&gt;&lt;br&gt;Select the target application for SBAS.&lt;ul&gt;&lt;li&gt;&lt;b&gt;Aviation:&lt;/b&gt; Process SBAS according to MOPS standard for Aviation (standard SBAS processsing). This is the default mode.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Maritime:&lt;/b&gt;  Process SBAS according to MOPS standard for Maritime (still in development). The differences in Maritime mode are:&lt;ul&gt;&lt;li&gt;Messages type 10, 27 and 28 are disabled.&lt;/li&gt;&lt;li&gt;GEO switching is enabled.&lt;/li&gt;&lt;li&gt;HDOP filter is enabled (with a threshold of 4).&lt;/li&gt;&lt;li&gt;PDOP filter is enabled (with a threshold of 6).&lt;/li&gt;&lt;li&gt;HDOP and PDOP filter conditions do not need to meet both in an epoch, only one of them is necessary (i.e. the HDOP and PDOP conditions are logically ORed).&lt;/li&gt;&lt;li&gt;Alarm limits are not used (gLAB sets a threshold of 100Km)&lt;/li&gt;&lt;li&gt;Window size is changed to 900 epochs (at 1 second data rate is equivalent to a 15 minute window).&lt;li&gt;The continuity risk is computed using a fixed window, instead of a sliding window (gLAB will compute the continuity risk with both modes, regardless the SBAS Application set in this option).&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;/ul&gt;</string>
                         </property>
                         <property name="styleSheet">
                          <string notr="true">color: rgb(0, 0, 0);</string>
                         </property>
                         <property name="text">
                          <string>SBAS Application</string>
                         </property>
                        </widget>
                       </item>
                       <item row="0" column="1">
                        <widget class="QComboBox" name="comboBoxSBASApplication">
                         <property name="minimumSize">
                          <size>
                           <width>180</width>
                           <height>0</height>
                          </size>
                         </property>
                         <property name="focusPolicy">
                          <enum>Qt::StrongFocus</enum>
                         </property>
                         <item>
                          <property name="text">
                           <string>Aviation</string>
                          </property>
                         </item>
                         <item>
                          <property name="text">
                           <string>Maritime</string>
                          </property>
                         </item>
                        </widget>
                       </item>
