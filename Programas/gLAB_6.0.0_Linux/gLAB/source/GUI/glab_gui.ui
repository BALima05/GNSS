                                    </widget>
                                   </item>
                                  </layout>
                                 </widget>
                                </item>
                                <item row="1" column="0">
                                 <widget class="QCheckBox" name="checkBoxSetCcovarianceOBADParameterMT37">
                                  <property name="minimumSize">
                                   <size>
                                    <width>0</width>
                                    <height>25</height>
                                   </size>
                                  </property>
                                  <property name="toolTip">
                                   <string>&lt;b&gt;Set Ccovariance OBAD Parameter from MT 37&lt;/b&gt;&lt;br&gt;&lt;br&gt;Message type 37 sends OBAD (Old But Active Data) parameters for computing degradation parameters (as described in &lt;i&gt;OBAD Parameters and DFREI Scale Table&lt;/i&gt;). C&lt;sub&gt;covariance&lt;/sub&gt; is a common parameter to all constellations.&lt;br&gt;&lt;br&gt;With this parameter, C&lt;sub&gt;covariance&lt;/sub&gt; set by user (adimensional) will be used instead of reading it from MT37.&lt;br&gt;&lt;br&gt;C&lt;sub&gt;covariance&lt;/sub&gt; is used for computing &amp;epsilon;&lt;sub&gt;c&lt;/sub&gt; with the following formula:&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;epsilon;&lt;sub&gt;c&lt;/sub&gt; = C&lt;sub&gt;covariance&lt;/sub&gt; · 2&lt;sup&gt;scale_exponent-5&lt;/sup&gt; (adimensional)&lt;br&gt;&lt;br&gt;&lt;i&gt;scale_exponent&lt;/i&gt; is a parameter transmitted in message type 32 (&lt;i&gt;Clock Ephemeris Corrections and Covariance Matrix&lt;/i&gt;) along with the covariance matrix parameters.&lt;br&gt;</string>
                                  </property>
                                  <property name="styleSheet">
                                   <string notr="true">color: rgb(0, 0, 0);</string>
                                  </property>
                                  <property name="text">
                                   <string>Set Ccovariance OBAD Parameter
from MT 37</string>
                                  </property>
                                 </widget>
                                </item>
