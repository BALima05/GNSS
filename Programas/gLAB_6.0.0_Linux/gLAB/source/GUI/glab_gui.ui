                                   <item row="5" column="1">
                                    <widget class="QLineEdit" name="lineEditSetValueDFREI5">
                                     <property name="clearButtonEnabled">
                                      <bool>true</bool>
                                     </property>
                                    </widget>
                                   </item>
                                   <item row="1" column="2">
                                    <widget class="QLabel" name="label_462">
                                     <property name="styleSheet">
                                      <string notr="true">color: rgb(0, 0, 0);</string>
                                     </property>
                                     <property name="text">
                                      <string>(m)</string>
                                     </property>
                                    </widget>
